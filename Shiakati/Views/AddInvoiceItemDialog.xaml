<Window x:Class="Shiakati.Views.AddInvoiceItemDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Ajouter un article" Width="450" Height="700"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Style="{StaticResource ShiakatiDialogStyle}">

    <Border BorderThickness="4" BorderBrush="{DynamicResource DarkLightTextNavyWhiteBrush}">

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Ajouter un article à la facture" FontSize="18" FontWeight="Bold"
                   Foreground="{DynamicResource DarkLightTextNavyWhiteBrush}" Margin="0,0,0,15"/>

            <!-- Search Box -->
            <TextBox Grid.Row="1" x:Name="SearchBox"
                 Style="{StaticResource ShiakatiTextBox}"
                 materialDesign:HintAssist.Hint="🔍 Rechercher un article..."
                 FontSize="14" Height="40"
                 TextChanged="SearchBox_TextChanged"
                 Margin="0,0,0,10"/>

            <!-- Variant ComboBox -->
            <ComboBox x:Name="VariantComboBox" Grid.Row="2"
                  Style="{StaticResource ShiakatiComboBox}"
                  materialDesign:HintAssist.Hint="Sélectionnez un variant"
                  DisplayMemberPath="DisplayName"
                  SelectedValuePath="VariantId"
                  Margin="0,0,0,10"/>

            <!-- Quantity -->
            <TextBox x:Name="QuantityBox" Grid.Row="3"
                 Style="{StaticResource ShiakatiTextBox}"
                 materialDesign:HintAssist.Hint="Quantité"
                 FontSize="14" Height="50" Margin="0,0,0,10"/>

            <!-- Unit Cost -->
            <TextBox x:Name="UnitCostBox" Grid.Row="4"
                 Style="{StaticResource ShiakatiTextBox}"
                 materialDesign:HintAssist.Hint="Prix unitaire (optionnel)"
                 FontSize="14" Height="50" Margin="0,0,0,10"/>
            <!-- Notes -->
            <!-- Notes -->
            <TextBox x:Name="NotesBox" Grid.Row="5"
         Style="{StaticResource ShiakatiTextBox}"
         materialDesign:HintAssist.Hint="Notes (optionnel)"
         FontSize="14" Height="100" 
         TextWrapping="Wrap"
                 VerticalAlignment="Top"
         AcceptsReturn="True"
         VerticalScrollBarVisibility="Auto"
         Margin="0,0,0,10"/>

            <!-- Buttons -->
            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Annuler" IsCancel="True" Click="Cancel_Click"
                    Style="{StaticResource SecondaryButton}" MinHeight="44" FontSize="14" Margin="0,0,10,0"/>
                <Button Content="Ajouter" IsDefault="True" Click="Save_Click"
                    Style="{StaticResource PrimaryButton}" MinHeight="44" FontSize="14"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>