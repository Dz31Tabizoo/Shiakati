<Window x:Class="Shiakati.Views.InvoiceUploadDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Ajouter une facture" Width="450" Height="513"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FontFamily="{StaticResource BodyFont}"
        Background="{StaticResource BgBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Ajouter une facture" FontSize="18" FontWeight="Bold"
                   Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,15"/>

        <!-- File selection -->
        <Button Grid.Row="1" x:Name="SelectFileButton" 
                Content="Choisir un fichier"
                Style="{StaticResource PrimaryGoldenButton}"
                Click="SelectFileButton_Click"
                Margin="0,0,0,10"/>

        <TextBlock Grid.Row="2" x:Name="FileNameText" 
                   Text="Aucun fichier sélectionné"
                   FontFamily="{StaticResource BodyFont}"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   Margin="0,0,0,10"/>

        <!-- Invoice Date -->
        <DatePicker Grid.Row="3" x:Name="InvoiceDatePicker"
                    Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                    SelectedDate="{Binding InvoiceDate, Mode=TwoWay}"
                    materialDesign:HintAssist.Hint="Date de la facture"
                    FontSize="14" Height="50" Margin="0,0,0,10"/>

        <!-- Products Total -->
        <TextBox Grid.Row="4" x:Name="ProductsTotalBox"
                 Style="{StaticResource ShiakatiTextBox}"
                 materialDesign:HintAssist.Hint="Quantité total"
                 FontSize="14" Height="50" Margin="0,0,0,10"
                 TextChanged="ProductsTotalBox_TextChanged"/>

        <!-- Total Amount -->
        <TextBox Grid.Row="5" x:Name="TotalAmountBox"
                 Style="{StaticResource ShiakatiTextBox}"
                 materialDesign:HintAssist.Hint="Montant total (TTC)"
                 FontSize="14" Height="50" Margin="0,0,0,10"
                 TextChanged="TotalAmountBox_TextChanged"/>

        <!-- Amount Paid -->
        <TextBox VerticalAlignment="Top" Grid.Row="6" x:Name="AmountPaidBox"
                 Style="{StaticResource ShiakatiTextBox}"
                 materialDesign:HintAssist.Hint="Montant payé"
                 FontSize="14" Height="50" Margin="0,0,0,10"
                 TextChanged="AmountPaidBox_TextChanged"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Annuler" IsCancel="True" Click="Cancel_Click"
                    Style="{StaticResource SecondaryButton}" MinHeight="44" FontSize="14" Margin="0,0,10,0"/>
            <Button Content="Enregistrer" IsDefault="True" Click="Save_Click"
                    Style="{StaticResource PrimaryButton}" MinHeight="44" FontSize="14"/>
        </StackPanel>
    </Grid>
</Window>
