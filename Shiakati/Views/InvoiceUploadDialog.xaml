<Window x:Class="Shiakati.Views.InvoiceUploadDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Ajouter une facture" Width="450" Height="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None"
        Style="{StaticResource ShiakatiDialogStyle}">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" 
                  Height="48"
                  Margin="0,0,0,15"
                  Background="{DynamicResource SecondaryBrush}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Window title (left aligned) -->
            <TextBlock Grid.Column="0"
                           Text="Ajouter une facture"
                           FontSize="18" FontWeight="Bold"
                           Foreground="{StaticResource TextOnPrimaryBrush}"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"/>

            <!-- Close button (right aligned) -->
            <Button Grid.Column="1"
                        x:Name="btnClose"
                        Click="btnClose_Click"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Width="48" Height="48"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource TextOnPrimaryBrush}">
                <materialDesign:PackIcon Kind="Close" 
                                 Width="24" Height="24"
                                 VerticalAlignment="Center"
                                 HorizontalAlignment="Center"/>
            </Button>
        </Grid>


        <!-- File selection (Add mode) -->
        <Button 
                x:Name="SelectFileButton" Grid.Row="6"
                Content="Choisir un fichier"
                Style="{StaticResource PrimaryGoldenButton}"
                MaxWidth="220" MaxHeight="44"                
                Click="SelectFileButton_Click"
                />

        <!-- File info (Edit mode) -->
        <StackPanel x:Name="FileInfoPanel" Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10" Visibility="Collapsed">
            <TextBlock x:Name="FileNameText" 
                       Text="Aucun fichier"
                       FontFamily="{StaticResource BodyFont}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       VerticalAlignment="Center"/>
            <Button x:Name="ReplaceFileButton" 
                    Content="Remplacer"
                    Style="{StaticResource HelpChipButton}"
                    Margin="10,0,0,0"
                    Click="ReplaceFileButton_Click"/>
        </StackPanel>

        <!-- Invoice Date -->
        <DatePicker Grid.Row="2" x:Name="InvoiceDatePicker"
                    Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                    SelectedDate="{Binding InvoiceDate, Mode=TwoWay}"
                    materialDesign:HintAssist.Hint="Date de la facture"
                    FontSize="14" Height="50" Margin="0,0,0,10"/>

        <!-- Products Total -->
        <TextBox Grid.Row="3" x:Name="ProductsTotalBox"
                 Style="{StaticResource ShiakatiTextBox}"
                 materialDesign:HintAssist.Hint="Total produits (HT)"
                 FontSize="14" Height="50" Margin="0,0,0,10"
                 TextChanged="ProductsTotalBox_TextChanged"/>

        <!-- Total Amount -->
        <TextBox Grid.Row="4" x:Name="TotalAmountBox"
                 Style="{StaticResource ShiakatiTextBox}"
                 materialDesign:HintAssist.Hint="Montant total (TTC)"
                 FontSize="14" Height="50" Margin="0,0,0,10"
                 TextChanged="TotalAmountBox_TextChanged"/>

        <!-- Amount Paid -->
        <TextBox Grid.Row="5" x:Name="AmountPaidBox"
                 Style="{StaticResource ShiakatiTextBox}"
                 materialDesign:HintAssist.Hint="Montant payé"
                 FontSize="14" Height="50" Margin="0,0,0,10"
                 TextChanged="AmountPaidBox_TextChanged"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Annuler" IsCancel="True" Click="Cancel_Click"
                    Style="{StaticResource SecondaryButton}" MinHeight="44" FontSize="14" Margin="0,0,10,0"/>
            <Button Content="Enregistrer" IsDefault="True" Click="Save_Click"
                    Style="{StaticResource PrimaryButton}" MinHeight="44" FontSize="14"/>
        </StackPanel>
    </Grid>
</Window>