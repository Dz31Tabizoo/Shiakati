<UserControl x:Class="Shiakati.Views.StockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Shiakati.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="768" d:DesignWidth="1024"
             FontFamily="{StaticResource MontserratFont}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,15,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <materialDesign:Card Grid.Row="0" Padding="10" UniformCornerRadius="8" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Grid.Column="0">
                        <materialDesign:PackIcon Kind="Magnify" Width="24" Height="24" VerticalAlignment="Center" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,10,0"/>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                 materialDesign:HintAssist.Hint="Rechercher par Nom du produit ou SKU..."
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                 Width="350" FontSize="16" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Grid.Column="1" Content="RÉINITIALISER LES FILTRES" Style="{StaticResource MaterialDesignOutlinedButton}" 
                            Command="{Binding ClearFiltersCommand}" VerticalAlignment="Center" Margin="0,0,10,0"/>

                    <Button Grid.Column="2" Content="RÉCEPTION FOURNISSEUR" Style="{StaticResource MaterialDesignRaisedButton}" 
                            Command="{Binding ToggleReceptionCommand}" VerticalAlignment="Center"/>
                </Grid>
            </materialDesign:Card>

            <materialDesign:Card Grid.Row="1" Padding="15,10" UniformCornerRadius="8" Margin="0,0,0,10">
                <WrapPanel Orientation="Horizontal">
                    <ComboBox ItemsSource="{Binding Categories}" DisplayMemberPath="CategoryName" SelectedItem="{Binding SelectedCategory}"
                              materialDesign:HintAssist.Hint="Catégorie" Width="150" Margin="0,0,15,10" Style="{StaticResource MaterialDesignFloatingHintComboBox}"/>

                    <ComboBox ItemsSource="{Binding Brands}" DisplayMemberPath="BrandName" SelectedItem="{Binding SelectedBrand}"
                              materialDesign:HintAssist.Hint="Marque" Width="150" Margin="0,0,15,10" Style="{StaticResource MaterialDesignFloatingHintComboBox}"/>

                    <TextBox Text="{Binding FilterColor, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Couleur" Width="120" Margin="0,0,15,10"/>
                    <TextBox Text="{Binding FilterFullSize, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Taille (FullSize)" Width="120" Margin="0,0,15,10"/>
                </WrapPanel>
            </materialDesign:Card>

            <materialDesign:Card Grid.Row="2" UniformCornerRadius="8" Padding="5">
                <DataGrid ItemsSource="{Binding FilteredStock}" AutoGenerateColumns="False" 
                          CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column"
                          SelectionMode="Single" SelectedItem="{Binding SelectedStockItem}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="SKU" Binding="{Binding SKU}" FontWeight="Bold"/>
                        <DataGridTextColumn Header="Produit" Binding="{Binding ProductInfo.ProductName}" Width="*"/>
                        <DataGridTextColumn Header="Couleur" Binding="{Binding Color}"/>
                        <DataGridTextColumn Header="Taille" Binding="{Binding FullSize}"/>
                        <DataGridTextColumn Header="En Stock" Binding="{Binding StockQuantity}" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}"/>
                        <DataGridTextColumn Header="Prix Achat" Binding="{Binding PurchasePrice, StringFormat={}{0:N2} DA}" Foreground="Crimson"/>
                        <DataGridTextColumn Header="Prix Vente" Binding="{Binding SalePrice, StringFormat={}{0:N2} DA}" Foreground="Green"/>
                    </DataGrid.Columns>
                </DataGrid>
            </materialDesign:Card>
        </Grid>
        <materialDesign:Card Grid.Column="1" Width="380" UniformCornerRadius="8" Padding="15"
                     Visibility="{Binding IsReceptionVisible, Converter={StaticResource BoolToVis}}"
                     materialDesign:ElevationAssist.Elevation="Dp3">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                    <materialDesign:PackIcon Kind="TruckDeliveryOutline" Width="28" Height="28" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Réception Fournisseur" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                    <StackPanel>

                        <TextBlock Text="1. Informations Produit" FontWeight="SemiBold" Foreground="Gray" Margin="0,0,0,10"/>

                        <ComboBox materialDesign:HintAssist.Hint="Catégorie" FontSize="13" ItemsSource="{Binding Categories}" 
                          DisplayMemberPath="CategoryName" SelectedItem="{Binding DraftCategory}" 
                          Style="{StaticResource MaterialDesignFloatingHintComboBox}" Margin="0,0,0,15"/>

                        <ComboBox ItemsSource="{Binding Brands}" 
                                  FontSize="13"
                                  Text="{Binding DraftBrand.BrandName, UpdateSourceTrigger=PropertyChanged}"
                                  SelectedItem="{Binding DraftBrand}"
                                  DisplayMemberPath="BrandName"
                                  materialDesign:HintAssist.Hint="Marque" 
                                  IsEditable="True"
                                  Style="{StaticResource MaterialDesignFloatingHintComboBox}" 
                                  Margin="0,0,0,15"/>

                        <ComboBox IsEditable="True" 
                                  FontSize="13"
                                  materialDesign:HintAssist.Hint="Nom du produit" 
                                  Text="{Binding DraftProductName, UpdateSourceTrigger=PropertyChanged}" 
                                  ItemsSource="{Binding Products}"  
                                  DisplayMemberPath="ProductName"
                                  SelectedItem="{Binding SelectedProduct}"
                                  Style="{StaticResource MaterialDesignFloatingHintComboBox}" 
                                  Margin="0,0,0,22"/>

                        <TextBlock Text="2. Détails du Produit" FontWeight="SemiBold" Foreground="Gray" Margin="0,0,0,10"/>

                        <TextBox FontSize="13" materialDesign:HintAssist.Hint="Code-barres (SKU)" IsEnabled="False" Text="{Binding DraftSKU}" 
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,15">
                            <TextBox.ToolTip>Généré automatiquement lors de l'enregistrement</TextBox.ToolTip>
                        </TextBox>

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <ComboBox Grid.Column="0" 
                                      FontSize="13"
                                      IsEditable="True" 
                                      ItemsSource="{Binding AllColors}" 
                                      Text="{Binding DraftColor, UpdateSourceTrigger=PropertyChanged}"
                                      materialDesign:HintAssist.Hint="Couleur" 
                                      Style="{StaticResource MaterialDesignFloatingHintComboBox}" 
                                      Margin="0,0,10,0"/>

                            <TextBox FontSize="13" Grid.Column="1" materialDesign:HintAssist.Hint="Taille (numérique)" Text="{Binding DraftNumericSize}" 
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                             Visibility="{Binding IsNumericSizeVisible, Converter={StaticResource BoolToVis}}"/>

                            <Grid Grid.Column="1" Visibility="{Binding IsDimensionSizeVisible, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <ComboBox FontSize="13" Grid.Column="0" IsEditable="False" ItemsSource="{Binding WidthsList}" SelectedItem="{Binding DraftWidth}"
                                  materialDesign:HintAssist.Hint="Largeur" 
                                  Style="{StaticResource MaterialDesignFloatingHintComboBox}" Margin="0,0,5,0"/>
                                <TextBox FontSize="13" Grid.Column="1" materialDesign:HintAssist.Hint="Longueur" Text="{Binding DraftLength}" 
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="5,0,0,0"/>
                            </Grid>
                        </Grid>

                        <Separator Style="{StaticResource MaterialDesignSeparator}" Margin="0,0,0,15"/>

                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBox FontSize="13" Grid.Row="0" Grid.Column="0" materialDesign:HintAssist.Hint="Prix d'achat (DA)" 
                             Text="{Binding DraftPurchasePrice, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,10,15"/>

                            <TextBox FontSize="13" Grid.Row="0" Grid.Column="1" materialDesign:HintAssist.Hint="Prix de vente (DA)" 
                             Text="{Binding DraftSalePrice, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,15"/>

                            <TextBox FontSize="13" Grid.Row="1" Grid.Column="1" materialDesign:HintAssist.Hint="Remise fixe (DA)" 
                             Text="{Binding DraftFixedDiscount, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>
                        </Grid>

                        <TextBlock Text="3. Quantité et Impression" FontWeight="SemiBold" Foreground="Gray" Margin="0,0,0,10"/>

                        <TextBox materialDesign:HintAssist.Hint="Quantité reçue" 
                         Text="{Binding DraftQuantity, UpdateSourceTrigger=PropertyChanged}" 
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         FontSize="20" FontWeight="Bold" Margin="0,0,0,15" Foreground="{StaticResource PrimaryBrush}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <CheckBox Content="Imprimer code-barres" IsChecked="{Binding PrintLabelsOnSave}" 
                              FontWeight="SemiBold" VerticalAlignment="Center"/>

                            <TextBox materialDesign:HintAssist.Hint="Qté à imprimer" 
                             Text="{Binding LabelsToPrint, UpdateSourceTrigger=PropertyChanged}" 
                             Width="100" FontSize="13" Margin="20,0,0,0"
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                             Visibility="{Binding PrintLabelsOnSave, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="Par défaut, imprime une étiquette par article reçu. Vous pouvez modifier ce nombre." 
                           FontStyle="Italic" FontSize="11" Foreground="Gray" TextWrapping="Wrap" Margin="0,5,0,0"/>
                    </StackPanel>
                </ScrollViewer>

                <Button Grid.Row="2" Content="ENREGISTRER &amp; IMPRIMER" Height="50" FontSize="16" FontWeight="Bold"
                Command="{Binding ReceiveStockCommand}" Margin="0,15,0,0"
                Style="{StaticResource MaterialDesignRaisedButton}">
                    <Button.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.2"/>
                    </Button.Effect>
                </Button>

            </Grid>
        </materialDesign:Card>
    </Grid>
</UserControl>