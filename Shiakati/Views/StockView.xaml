<UserControl x:Class="Shiakati.Views.StockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Shiakati.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="768" d:DesignWidth="1024"
             FontFamily="{StaticResource BodyFont}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- ═══════════ LEFT: Main stock area ═══════════ -->
        <Grid Grid.Column="0" Margin="0,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ====== TOP BAR (search + actions) ====== -->
            <materialDesign:Card Grid.Row="0" Padding="12" UniformCornerRadius="12" Margin="0,0,0,12"
                                 Background="{StaticResource BgBrush}" Style="{StaticResource ShiakatiCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>                        
                     
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Grid.Column="0">
                        <materialDesign:PackIcon Kind="Magnify" Width="24" Height="24"
                                                 VerticalAlignment="Center"
                                                 Foreground="{StaticResource PrimaryBrush}"
                                                 Margin="0,0,10,0"/>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Rechercher par Nom du produit ou SKU..."
                                 Style="{StaticResource ShiakatiTextBox}"
                                 Width="360" FontSize="16" VerticalAlignment="Center">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding ApplyFiltersCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Command="{Binding PrintInventoryCommand}"
                            Style="{StaticResource PrimaryGoldenButton}"
                            VerticalAlignment="Center"
                            MinHeight="48" FontSize="14" Margin="10,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ClipboardCheckMultiple" Width="20" Height="20"
                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="INVENTAIRE" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="2" Content="RÉINITIALISER LES FILTRES"
                            Command="{Binding ClearFiltersCommand}"
                            Style="{StaticResource HelpChipButton}"
                            VerticalAlignment="Center" Margin="0,0,10,0"
                            FontSize="14" MinHeight="48"/>
                    
                    <Button Grid.Column="3"
                            Command="{Binding ToggleReceptionCommand}"
                            Style="{StaticResource PrimaryButton}"
                            VerticalAlignment="Center"
                            MinWidth="220"
                            HorizontalContentAlignment="Center"
                            FontSize="14" MinHeight="48">
                        
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="TruckDeliveryOutline"
                                 Width="20" Height="20"
                                 VerticalAlignment="Center"
                                 Margin="0,0,8,0"/>
                            <TextBlock Text="RÉCEPTION FOURNISSEUR" VerticalAlignment="Center"
                   FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                </Grid>
            </materialDesign:Card>

            <!-- ====== FILTER BAR ====== -->
            <materialDesign:Card Grid.Row="1" Padding="16,12" UniformCornerRadius="12"
                                 Margin="0,0,0,12" Background="{StaticResource BgBrush}"
                                 Style="{StaticResource ShiakatiCard}">
                <WrapPanel Orientation="Horizontal">
                    <ComboBox materialDesign:HintAssist.Hint="Catégorie"
              ItemsSource="{Binding Categories}"
              DisplayMemberPath="CategoryName"
              SelectedItem="{Binding SelectedCategory}"
              Style="{StaticResource ShiakatiComboBox}"
              Width="180" Margin="0,0,20,12"/>
                    <ComboBox materialDesign:HintAssist.Hint="Marque"
              ItemsSource="{Binding Brands}"
              DisplayMemberPath="BrandName"
              SelectedItem="{Binding SelectedBrand}"
              Style="{StaticResource ShiakatiComboBox}"
              Width="180" Margin="0,0,20,12"/>
                    <ComboBox materialDesign:HintAssist.Hint="Couleur"
              ItemsSource="{Binding AllColors}"
              SelectedItem="{Binding FilterColor}"
              Style="{StaticResource ShiakatiComboBox}"
              Width="150" Margin="0,0,20,12"/>
                    <ComboBox materialDesign:HintAssist.Hint="Taille"
              ItemsSource="{Binding FilterSizes}"
              SelectedItem="{Binding FilterFullSize}"
              Style="{StaticResource ShiakatiComboBox}"
              Width="150" Margin="0,0,20,12"/>
                    <CheckBox Content="Afficher les articles supprimés"
              IsChecked="{Binding IsNonActiveItemsVisible, Mode=TwoWay}"
              FontSize="15" FontWeight="Medium"
              Foreground="{StaticResource TextPrimaryBrush}"
              VerticalAlignment="Center" Margin="0,0,20,12"/>
                </WrapPanel>
            </materialDesign:Card>

            <!-- ====== DATA GRID ====== -->
            <materialDesign:Card Grid.Row="2" 
                                 UniformCornerRadius="12"
                                 Background="{StaticResource BgBrush}"
                                 Style="{StaticResource ShiakatiCard}"
                                 Padding="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="1"
                Padding="10,6"
                Background="{StaticResource BgAltBrush}"
                CornerRadius="8,8,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Total quantité affichée : "
                           FontWeight="Medium"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalFilteredQuantity}"
                           FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrush}"
                           FontSize="16"
                           VerticalAlignment="Center"
                           Margin="6,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <DataGrid 
                          Grid.Row="0" ItemsSource="{Binding FilteredStockView}"
                          AutoGenerateColumns="False"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          SelectionMode="Single"
                          SelectedItem="{Binding SelectedStockItem}"
                          Style="{StaticResource ShiakatiDataGrid}">

                        <!-- Cell style with status triggers -->
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource ShiakatiDataGridCell}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                        <Setter Property="FontStyle" Value="Italic"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsActive}" Value="True"/>
                                            <Condition Binding="{Binding StockQuantity}" Value="0"/>
                                        </MultiDataTrigger.Conditions>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>

                        <!-- Row style with context menu -->
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource ShiakatiDataGridRow}">
                                <Setter Property="Tag" Value="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                <Setter Property="ContextMenu">
                                    <Setter.Value>
                                        <ContextMenu>
                                            <!-- Modifier -->
                                            <MenuItem Header="Modifier l'article"
                              Command="{Binding PlacementTarget.Tag.DataContext.PrepareEditCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="{Binding}"
                              IsEnabled="{Binding IsActive, TargetNullValue=False}">
                                                <MenuItem.Icon>
                                                    <materialDesign:PackIcon Kind="Edit" Width="16" Height="16" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator/>

                                            <!-- Imprimer -->
                                            <MenuItem Header="Imprimer Code-Barres"
                              Command="{Binding PlacementTarget.Tag.DataContext.PrintFromGridCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="{Binding}">
                                                <MenuItem.Icon>
                                                    <materialDesign:PackIcon Kind="Printer" Width="16" Height="16" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator/>

                                            <!-- Supprimer / Restaurer (toggle) -->
                                            <MenuItem Command="{Binding PlacementTarget.Tag.DataContext.DeleteStockItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="{Binding}">
                                                <MenuItem.Style>
                                                    <Style TargetType="MenuItem">
                                                        <Setter Property="Header" Value="Supprimer l'article"/>
                                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                        <Setter Property="Icon">
                                                            <Setter.Value>
                                                                <materialDesign:PackIcon Kind="Delete" Width="16" Height="16"
                                                                 Foreground="{StaticResource DangerBrush}" />
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                <Setter Property="Header" Value="Restaurer l'article"/>
                                                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                                                <Setter Property="Icon">
                                                                    <Setter.Value>
                                                                        <materialDesign:PackIcon Kind="Restore" Width="16" Height="16"
                                                                         Foreground="{StaticResource PrimaryBrush}" />
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </MenuItem.Style>
                                            </MenuItem>
                                            <Separator/>

                                            <!-- Inventaire -->
                                            <MenuItem Header="Lancer l'inventaire du produit"
                              Command="{Binding PlacementTarget.Tag.DataContext.LaunchInventoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="{Binding}">
                                                <MenuItem.Icon>
                                                    <materialDesign:PackIcon Kind="ClipboardCheckMultiple" Width="16" Height="16" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                        <Setter Property="Opacity" Value="0.55"/>
                                        <Setter Property="Background" Value="{StaticResource BgAltBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <!-- Status (unchanged) -->
                            <DataGridTemplateColumn Header="Statut" Width="Auto" MinWidth="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid VerticalAlignment="Center" HorizontalAlignment="Left">
                                            <Border x:Name="DeleteBadge" Background="{StaticResource DangerBrush}"
                        CornerRadius="6" Padding="8,4" Visibility="Collapsed">
                                                <TextBlock Text="SUPPRIMÉ" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                            </Border>
                                            <Border x:Name="RuptureBadge" Background="#FFEDD5"
                        CornerRadius="6" Padding="8,4" Visibility="Collapsed">
                                                <TextBlock Text="RUPTURE" Foreground="#C2410C" FontSize="10" FontWeight="Bold"/>
                                            </Border>
                                            <Border x:Name="ActiveBadge" Background="#DCFCE7"
                        CornerRadius="6" Padding="8,4" Visibility="Visible">
                                                <TextBlock Text="ACTIF" Foreground="#166534" FontSize="10" FontWeight="Bold"/>
                                            </Border>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                <Setter TargetName="DeleteBadge" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="ActiveBadge" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="RuptureBadge" Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsActive}" Value="True"/>
                                                    <Condition Binding="{Binding StockQuantity}" Value="0"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="RuptureBadge" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="ActiveBadge" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="DeleteBadge" Property="Visibility" Value="Collapsed"/>
                                            </MultiDataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!-- SKU (unchanged) -->
                            <DataGridTextColumn Header="SKU" Binding="{Binding Sku}"
                        FontWeight="Normal" FontSize="11"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Width="Auto" MinWidth="90"/>

                            <!-- Catégorie (unchanged) -->
                            <DataGridTextColumn Header="Catégorie" Binding="{Binding CategoryName}"
                        Width="Auto" MinWidth="110" FontSize="13"/>

                            <!-- Marque – slightly larger -->
                            <DataGridTextColumn Header="Marque" Binding="{Binding BrandName}"
                        FontSize="15" FontWeight="Medium"
                        Width="Auto" MinWidth="110"/>

                            <!-- Produit – prominent -->
                            <DataGridTextColumn Header="Produit" Binding="{Binding ProductName}"
                        FontSize="16" FontWeight="SemiBold"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Width="*" MinWidth="200"/>

                            <!-- Couleur – slightly larger -->
                            <DataGridTextColumn Header="Couleur" Binding="{Binding Color}"
                        Width="Auto" MinWidth="90" FontSize="15"/>

                            <!-- Taille – slightly larger -->
                            <DataGridTextColumn Header="Taille" Binding="{Binding FullSize}"
                        Width="Auto" MinWidth="70" FontSize="15"/>

                            <!-- Stock (unchanged) -->
                            <DataGridTextColumn Header="Stock" Binding="{Binding StockQuantity}"
                        FontWeight="SemiBold" FontSize="14"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Width="Auto" MinWidth="70"/>

                            <!-- Prix de vente – larger -->
                            <DataGridTextColumn Header="P. Vente"
                        Binding="{Binding SalePrice, StringFormat={}{0:N2} DA}"
                        Foreground="{StaticResource SecondaryBrush}"
                        FontWeight="Bold" FontSize="16" Width="Auto" MinWidth="100"/>

                            <!-- Prix d'achat (unchanged) -->
                            <DataGridTextColumn Header="P. Achat"
                        Binding="{Binding PurchasePrice, StringFormat={}{0:N2} DA}"
                        Foreground="{StaticResource DangerBrush}"
                        FontSize="13" Width="Auto" MinWidth="90"/>

                            <!-- Remise Fixe – slightly larger -->
                            <DataGridTextColumn Header="Remise Fixe"
                        Binding="{Binding DiscountFixed, StringFormat={}{0:N2} DA}"
                        Foreground="Orange"
                        FontWeight="SemiBold" FontSize="15" Width="Auto" MinWidth="90"/>
                        </DataGrid.Columns>

                    </DataGrid>



                </Grid>

            </materialDesign:Card>
        </Grid>

        <!-- ═══════════ RIGHT: Reception panel ═══════════ -->
        <materialDesign:Card Grid.Column="1" Width="450"
                             Visibility="{Binding IsReceptionVisible, Converter={StaticResource BoolToVis}}"
                             Padding="20">
            <materialDesign:Card.Style>
                <Style TargetType="materialDesign:Card" BasedOn="{StaticResource ShiakatiCard}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                            <Setter Property="Background" Value="#FFFDE7"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </materialDesign:Card.Style>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,5">
                    <materialDesign:PackIcon Width="28" Height="28" VerticalAlignment="Center" Margin="0,0,10,0">
                        <materialDesign:PackIcon.Style>
                            <Style TargetType="materialDesign:PackIcon">
                                <Setter Property="Kind" Value="TruckDeliveryOutline"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                        <Setter Property="Kind" Value="Edit"/>
                                        <Setter Property="Foreground" Value="#C2410C"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </materialDesign:PackIcon.Style>
                    </materialDesign:PackIcon>
                    <TextBlock FontSize="20" FontWeight="Bold" VerticalAlignment="Center"
                               FontFamily="{StaticResource HeadingFont}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Réception Fournisseur"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                        <Setter Property="Text" Value="Modification d'article"/>
                                        <Setter Property="Foreground" Value="#7C2D12"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>


                </StackPanel>

                <!-- Toggle between single and bulk mode -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,5">
                    <RadioButton Content="Simple" GroupName="BulkMode" IsChecked="{Binding IsSimpleMode}"
                 Style="{StaticResource MaterialDesignFilterChipPrimaryOutlineCheckBox}" Margin="5,0,4,0"/>
                    <RadioButton Content="Groupé" GroupName="BulkMode" IsChecked="{Binding IsBulkMode}"
                 Style="{StaticResource MaterialDesignFilterChipOutlineCheckBox}" Margin="10,0,4,0"/>
                </StackPanel>
                
                <!-- Form content -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                    <StackPanel>
                        
                        <TextBlock Text="1. Informations Produit" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="14" Margin="0,0,0,5"/>

                        <ComboBox materialDesign:HintAssist.Hint="Catégorie"
                  ItemsSource="{Binding Categories}"
                  DisplayMemberPath="CategoryName"
                  SelectedItem="{Binding DraftCategory}"
                  Style="{StaticResource ShiakatiComboBox}"
                  Margin="0,0,0,5"/>
                        
                        <ComboBox materialDesign:HintAssist.Hint="Marque"
                  ItemsSource="{Binding FilteredBrands}"
                  Text="{Binding DraftNewBrandName, UpdateSourceTrigger=PropertyChanged}"
                  SelectedItem="{Binding DraftBrand}"
                  DisplayMemberPath="BrandName"
                  IsEditable="True"
                  Style="{StaticResource ShiakatiComboBox}"
                  Margin="0,0,0,5"/>

                        <ComboBox materialDesign:HintAssist.Hint="Nom du produit"
                                  IsEditable="True"
                                  Text="{Binding DraftProductName, UpdateSourceTrigger=PropertyChanged}"
                                  ItemsSource="{Binding Products}"
                                  DisplayMemberPath="ProductName"
                                  SelectedItem="{Binding DraftSelectedProduct}"
                                  Style="{StaticResource ShiakatiComboBox}"
                                  Margin="0,0,0,5"/>

                        <TextBlock Text="2. Détails du Produit" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="14" Margin="0,0,0,5"/>

                        <CheckBox Content="Saisir code-barres manuellement"
                                  IsChecked="{Binding IsManualSkuEnabled}"
                                  FontSize="13" Margin="0,0,0,6"
                                  Visibility="{Binding IsNotEditMode, Converter={StaticResource BoolToVis}}"/>
                        
                        <TextBox materialDesign:HintAssist.Hint="Code-barres (SKU)"
                                 Text="{Binding DraftSKU, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsManualSkuEnabled}"
                                 Style="{StaticResource ShiakatiTextBox}"
                                 Margin="0,0,0,5">
                            <TextBox.ToolTip>Laissez vide pour générer automatiquement, ou scannez le code-barres existant</TextBox.ToolTip>
                        </TextBox>

                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" IsEditable="True"
                                      materialDesign:HintAssist.Hint="Couleur"
                                      ItemsSource="{Binding AllColors}"
                                      Text="{Binding DraftColor, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource ShiakatiComboBox}"
                                      Margin="0,0,10,0"/>
                            <TextBox Grid.Column="1"
                                     materialDesign:HintAssist.Hint="Taille (numérique)"
                                     Text="{Binding DraftNumericSize}"
                                     Style="{StaticResource ShiakatiTextBox}"
                                     Visibility="{Binding IsNumericSizeVisible, Converter={StaticResource BoolToVis}}"/>
                            <Grid Grid.Column="1"
                                    Visibility="{Binding IsDimensionSizeVisible, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" IsEditable="False"
                                      materialDesign:HintAssist.Hint="Largeur"
                                      ItemsSource="{Binding WidthsList}"
                                      SelectedItem="{Binding DraftWidth}"
                                      Style="{StaticResource ShiakatiComboBox}"
                                      Margin="0,0,5,0"/>
                                <TextBox Grid.Column="1"
                                        materialDesign:HintAssist.Hint="Longueur"
                                        Text="{Binding DraftLength}"
                                        Style="{StaticResource ShiakatiTextBox}"
                                        Margin="5,0,0,0"/>
                            </Grid>
                        </Grid>

                        <Separator Margin="0,0,0,5" Style="{StaticResource MaterialDesignDarkSeparator}"/>

                        <Grid Margin="0,5,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBox Grid.Row="0" Grid.Column="0"
                     materialDesign:HintAssist.Hint="Prix d'achat (DA)"
                     Text="{Binding DraftPurchasePrice, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource ShiakatiTextBox}"
                     Margin="0,0,10,8"/>
                            <TextBox Grid.Row="0" Grid.Column="1"
                     materialDesign:HintAssist.Hint="Prix de vente (DA)"
                     Text="{Binding DraftSalePrice, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource ShiakatiTextBox}"
                     Margin="0,0,0,8"/>
                            <TextBox Grid.Row="1" Grid.Column="1"
                     materialDesign:HintAssist.Hint="Remise fixe (DA)"
                     Text="{Binding DraftFixedDiscount, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource ShiakatiTextBox}"/>
                        </Grid>

                        <TextBlock Text="3. Quantité et Impression" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="14" Margin="0,0,0,5"/>

                        <TextBox materialDesign:HintAssist.Hint="Quantité reçue"
                                 Text="{Binding DraftQuantity, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ShiakatiTextBox}"
                                 FontSize="22" FontWeight="Bold"
                                 Margin="0,0,0,8"
                                 Foreground="{StaticResource PrimaryBrush}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <CheckBox Content="Imprimer code-barres"
                                      IsChecked="{Binding PrintLabelsOnSave}"
                                      FontWeight="SemiBold" FontSize="14"
                                      VerticalAlignment="Center"/>
                            <TextBox materialDesign:HintAssist.Hint="Qté à imprimer"
                                     Text="{Binding LabelsToPrint, UpdateSourceTrigger=PropertyChanged}"
                                     Width="100" FontSize="14" Margin="20,0,0,0"
                                     Style="{StaticResource ShiakatiTextBox}"
                                     Visibility="{Binding PrintLabelsOnSave, Converter={StaticResource BoolToVis}}"
                                     VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Par défaut, imprime une étiquette par article reçu. Vous pouvez modifier ce nombre."
                                   FontStyle="Italic" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,4,0,0"/>


                        <!-- Bulk variants list (visible only in bulk mode) -->
                        <StackPanel Visibility="{Binding IsBulkMode, Converter={StaticResource BoolToVis}}" Margin="0,15,0,0">
                            <TextBlock Text="Variantes à ajouter" FontWeight="SemiBold" FontSize="14"
               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                            <DataGrid ItemsSource="{Binding BulkVariants}" AutoGenerateColumns="False"
              Style="{StaticResource ShiakatiDataGrid}" MaxHeight="180"
              VerticalScrollBarVisibility="Auto" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="C_Barre" Binding="{Binding Sku}" Width="Auto" FontSize="13"/>
                                    <DataGridTextColumn Header="Couleur" Binding="{Binding Color}" Width="Auto" FontSize="13"/>
                                    <DataGridTextColumn Header="Taille" Binding="{Binding Length}" Width="Auto" FontSize="13" Visibility="{Binding IsDimensionSizeVisible, Converter={StaticResource BoolToVis}}"/>
                                    <DataGridTextColumn Header="N_Taille" Binding="{Binding NumericSize}" Visibility="{Binding IsNumericSizeVisible, Converter={StaticResource BoolToVis}}" Width="Auto" FontSize="13"/>
                                    <DataGridTextColumn Header="Larg." Binding="{Binding Width}" Width="Auto" FontSize="13" Visibility="{Binding IsDimensionSizeVisible, Converter={StaticResource BoolToVis}}"/>
                                    <DataGridTextColumn Header="P.Achat" Binding="{Binding PurchasePrice, StringFormat={}{0:N2} DA}" Width="Auto" FontSize="13"/>
                                    <DataGridTextColumn Header="P.Vente" Binding="{Binding SalePrice, StringFormat={}{0:N2} DA}" Width="Auto" FontSize="13"/>
                                    <DataGridTextColumn Header="Rem." Binding="{Binding DiscountFixed, StringFormat={}{0:N2} DA}" Width="Auto" FontSize="13"/>
                                    <DataGridTextColumn Header="Qté" Binding="{Binding StockQuantity}" Width="Auto" FontSize="13"/>
                                    <DataGridTemplateColumn Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                Command="{Binding DataContext.RemoveBulkVariantCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                                                    <materialDesign:PackIcon Kind="CloseCircle" Foreground="{StaticResource DangerBrush}" Width="15" Height="15"/>
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Button Content="+ Ajouter une variante" Command="{Binding AddBulkVariantCommand}"
            Style="{StaticResource SecondaryButton}" MinHeight="40" FontSize="14" Margin="0,8,0,0"/>
                        </StackPanel>



                    </StackPanel>
                </ScrollViewer>
                <!-- Bottom buttons -->
                <Grid Grid.Row="3" Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1.5*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="ANNULER"
                            Command="{Binding StockAddingFiledsClearCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Height="52" FontSize="15" Margin="0,0,10,0"/>
                    
                    <Button Grid.Column="1"
                            Command="{Binding ReceiveStockCommand}"  
                            IsEnabled="{Binding IsSaving, Converter={StaticResource InvertBooleanConverter}}"
                            Height="52" FontSize="16">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                <Setter Property="Content" Value="ENREGISTRER &amp; IMPRIMER"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                        <Setter Property="Content" Value="MODIFIER L'ARTICLE"/>
                                        <Setter Property="Background" Value="#F57C00"/>
                                        <Setter Property="BorderBrush" Value="#F57C00"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Grid>
        </materialDesign:Card>
    </Grid>
</UserControl>