<Window x:Class="Shiakati.Views.HonorReservationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Honorer la réservation" Width="450" Height="425"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FontFamily="{StaticResource BodyFont}"
        Background="{StaticResource BgBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="HONORER LA RÉSERVATION" FontSize="20" FontWeight="Bold"
                   Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,15"/>

        <!-- Remaining amount (read-only) -->
        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="Reste à payer (après dépôt)" FontWeight="Medium" FontSize="14"/>
            <TextBox IsReadOnly="True" Text="{Binding Remaining, StringFormat={}{0:N2} DA}"
                     Style="{StaticResource ShiakatiTextBox}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Amount paid now (editable) -->
        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="Montant payé maintenant" FontWeight="Medium" FontSize="14"/>
            <TextBox Text="{Binding AmountPaid, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}"
                     Style="{StaticResource ShiakatiTextBox}" Margin="0,4,0,0"
                     PreviewTextInput="OnlyDigits_PreviewTextInput"/>
        </StackPanel>

        <!-- New debt (calculated) -->
        <StackPanel Grid.Row="3" Margin="0,0,0,10">
            <TextBlock Text="Nouvelle dette restante" FontWeight="Medium" FontSize="14"/>
            <TextBox IsReadOnly="True" Text="{Binding NewDebt, StringFormat={}{0:N2} DA}"
                     Style="{StaticResource ShiakatiTextBox}" Margin="0,4,0,0"
                     Foreground="{StaticResource DangerBrush}"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Annuler" IsCancel="True" Click="Cancel_Click"
                    Style="{StaticResource SecondaryButton}" MinHeight="44" FontSize="14" Margin="0,0,10,0"/>
            <Button Content="Confirmer" IsDefault="True" Click="Confirm_Click"
                    Style="{StaticResource PrimaryButton}" MinHeight="44" FontSize="14"/>
        </StackPanel>
    </Grid>
</Window>
