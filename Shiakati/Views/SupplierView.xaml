<UserControl x:Class="Shiakati.Views.SupplierView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100"
             Background="{StaticResource BgAltBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══════════ HEADER ═══════════ -->
        <Border Grid.Row="0" Background="{StaticResource BgBrush}" CornerRadius="12"
                Padding="16,12" Margin="0,0,0,16"
                materialDesign:ElevationAssist.Elevation="Dp4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <materialDesign:PackIcon Kind="Truck" 
                                              Foreground="{StaticResource PrimaryBrush}"
                                              Width="28" Height="28" Margin="0,0,12,0"/>
                    <TextBlock Text="Gestion des Fournisseurs" 
                               FontFamily="{StaticResource HeadingFont}"
                               FontSize="22" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Suppliers.Count, StringFormat=' ({0})'}" 
                               FontFamily="{StaticResource BodyFont}"
                               FontSize="16"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Grid.Column="2">
                    <Button Command="{Binding AddSupplierCommand}"
                            Style="{StaticResource PrimaryGoldenButton}"
                            Width="140" Height="40">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" Margin="0,0,8,0"/>
                            <TextBlock Text="Nouveau"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════ MAIN CONTENT ═══════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="2.5*"/>
            </Grid.ColumnDefinitions>

            <!-- ─── LEFT: Supplier List ─── -->
            <materialDesign:Card Grid.Column="0" Style="{StaticResource ShiakatiCard}" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Search -->
                    <TextBox Grid.Row="0" 
                             Style="{StaticResource ShiakatiTextBox}"
                             materialDesign:HintAssist.Hint="🔍 Rechercher..."
                             FontSize="14" Height="40"
                             Margin="0,0,0,12"/>

                    <!-- List -->
                    <DataGrid Grid.Row="2" 
                              Style="{StaticResource ShiakatiDataGrid}"
                              ColumnHeaderStyle="{StaticResource ShiakatiDataGridColumnHeader}"
                              CellStyle="{StaticResource ShiakatiDataGridCell}"
                              RowStyle="{StaticResource ShiakatiDataGridRow}"
                              ItemsSource="{Binding Suppliers}"
                              SelectedItem="{Binding SelectedSupplier}"
                              VerticalAlignment="Top"
                              AutoGenerateColumns="False"
                              VerticalScrollBarVisibility="Auto"
                              MaxHeight="450">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nom" Binding="{Binding Name}" Width="Auto" MinWidth="140">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Tél" Binding="{Binding Phone}" Width="Auto">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="Status" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <materialDesign:PackIcon Kind="{Binding IsActive, Converter={StaticResource BoolToIcon}}"
                                                                  Foreground="{Binding IsActive, Converter={StaticResource BoolToColor}}"
                                                                  Width="18" Height="18"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </materialDesign:Card>

            <!-- ─── RIGHT: Supplier Details ─── -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" 
                          HorizontalScrollBarVisibility="Disabled">
                <materialDesign:Card Style="{StaticResource ShiakatiCard}" Margin="8,0,0,0">
                    <Grid>

                        <!-- Empty state – show when SelectedSupplier is null -->
                        <StackPanel Visibility="{Binding SelectedSupplier, 
                               Converter={StaticResource NullToVisibility}, 
                               ConverterParameter=invert}"
                                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,20,0,0">
                            <TextBlock Text="Sélectionnez un fournisseur" 
                                       FontSize="18"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="0,50,0,0"/>
                            <materialDesign:PackIcon Kind="HandPointingLeft" 
                                                      Width="48" Height="48"
                                                      Foreground="{StaticResource TextSecondaryBrush}"
                                                      HorizontalAlignment="Center"
                                                      Margin="0,20,0,0"/>
                        </StackPanel>

                        <!-- ─── DETAILS PANEL ─── -->
                        <StackPanel Visibility="{Binding SelectedSupplier, Converter={StaticResource NotNullToVisibility}}">
                            <!-- Supplier Info -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal" Grid.Column="0" Margin="0,0,0,12">
                                    <materialDesign:PackIcon Kind="Account" 
                                                              Foreground="{StaticResource PrimaryBrush}"
                                                              Width="20" Height="20" Margin="0,0,10,0"/>
                                    <TextBlock Text="Détails du fournisseur" 
                                               FontFamily="{StaticResource HeadingFont}"
                                               FontSize="16" FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryBrush}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Grid.Column="1" Margin="0,0,0,12">
                                    <Button Command="{Binding DeleteSupplierCommand}"
                                            Style="{StaticResource DangerButton}"
                                            MinHeight="32" MinWidth="80" FontSize="12"
                                            Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Delete" Width="14" Height="14" Margin="0,0,4,0"/>
                                            <TextBlock Text="Supprimer"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding SaveSupplierCommand}"
                                            Style="{StaticResource PrimaryButton}"
                                            MinHeight="32" MinWidth="80" FontSize="12">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="ContentSave" Width="14" Height="14" Margin="0,0,4,0"/>
                                            <TextBlock Text="Enregistrer"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Fields -->
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" 
                                             Text="{Binding SelectedSupplier.Name, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ShiakatiTextBox}"
                                             materialDesign:HintAssist.Hint="Nom du fournisseur"
                                             Margin="0,0,4,0"/>
                                    <TextBox Grid.Column="1" 
                                             Text="{Binding SelectedSupplier.ContactPerson, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ShiakatiTextBox}"
                                             materialDesign:HintAssist.Hint="Contact"
                                             Margin="4,0,0,0"/>
                                </Grid>

                                <Grid Grid.Row="1" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" 
                                             Text="{Binding SelectedSupplier.Phone, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ShiakatiTextBox}"
                                             materialDesign:HintAssist.Hint="Téléphone"
                                             Margin="0,0,4,0"/>
                                    <TextBox Grid.Column="1" 
                                             Text="{Binding SelectedSupplier.Email, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ShiakatiTextBox}"
                                             materialDesign:HintAssist.Hint="Email"
                                             Margin="4,0,0,0"/>
                                </Grid>

                                <Grid Grid.Row="2" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" 
                                             Text="{Binding SelectedSupplier.Address, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ShiakatiTextBox}"
                                             materialDesign:HintAssist.Hint="Adresse"
                                             Margin="0,0,4,0"/>
                                    <CheckBox Grid.Column="1" 
                                              IsChecked="{Binding SelectedSupplier.IsActive}"
                                              Content="Actif"
                                              FontFamily="{StaticResource BodyFont}"
                                              FontSize="14"
                                              VerticalAlignment="Center"
                                              Margin="4,0,0,0"/>
                                </Grid>
                            </Grid>

                            <Border BorderBrush="{StaticResource BgAltBrush}" 
                                    BorderThickness="0,1,0,0" 
                                    Margin="0,16,0,12"/>

                            <!-- Invoices Section -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal" Grid.Column="0">
                                    <materialDesign:PackIcon Kind="FileDocument" 
                                                              Foreground="{StaticResource SecondaryBrush}"
                                                              Width="20" Height="20" Margin="0,0,8,0"/>
                                    <TextBlock Text="Factures" 
                                               FontFamily="{StaticResource HeadingFont}"
                                               FontSize="15" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding SelectedSupplier.Invoices.Count, StringFormat=' ({0})'}" 
                                               FontFamily="{StaticResource BodyFont}"
                                               FontSize="14"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="4,0,0,0"/>
                                </StackPanel>

                                <Button Grid.Column="1" 
                                        Command="{Binding UploadInvoiceCommand}"
                                        Style="{StaticResource PrimaryGoldenButton}"
                                        MinHeight="32" MinWidth="120" FontSize="12"
                                        Padding="12,4">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Upload" Width="16" Height="16" Margin="0,0,6,0"/>
                                        <TextBlock Text="Ajouter une facture"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Invoices DataGrid -->
                            <DataGrid ItemsSource="{Binding SelectedSupplier.Invoices}"
                                      Style="{StaticResource ShiakatiDataGrid}"
                                      ColumnHeaderStyle="{StaticResource ShiakatiDataGridColumnHeader}"
                                      CellStyle="{StaticResource ShiakatiDataGridCell}"
                                      RowStyle="{StaticResource ShiakatiDataGridRow}"
                                      AutoGenerateColumns="False"
                                      MaxHeight="250"
                                      Margin="0,0,0,8"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"    
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      HorizontalAlignment="Stretch">
                                <DataGrid.Columns>

                                    <!-- ID -->
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50" IsReadOnly="True"/>

                                    <!-- Date -->
                                    <DataGridTextColumn Header="Date" Width="90">
                                        <DataGridTextColumn.Binding>
                                            <Binding Path="InvoiceDate" StringFormat="{}{0:dd/MM/yyyy}" TargetNullValue="—"/>
                                        </DataGridTextColumn.Binding>
                                    </DataGridTextColumn>

                                    <!-- File Name (takes remaining space) -->
                                    <DataGridTextColumn Header="Fichier" Width="*">
                                        <DataGridTextColumn.Binding>
                                            <Binding Path="FileName" TargetNullValue="Aucune pièce jointe"/>
                                        </DataGridTextColumn.Binding>
                                    </DataGridTextColumn>

                                    <!-- Total -->
                                    <DataGridTextColumn Header="Total" Width="100">
                                        <DataGridTextColumn.Binding>
                                            <Binding Path="TotalAmount" StringFormat="{}{0:N2} DA" TargetNullValue="0.00 DA"/>
                                        </DataGridTextColumn.Binding>
                                    </DataGridTextColumn>

                                    <!-- Quantity (ProductsTotal) -->
                                    <DataGridTextColumn Header="Qté" Width="80">
                                        <DataGridTextColumn.Binding>
                                            <Binding Path="ProductsTotal" TargetNullValue="0"/>
                                        </DataGridTextColumn.Binding>
                                    </DataGridTextColumn>

                                    <!-- Paid -->
                                    <DataGridTextColumn Header="Payé" Width="100">
                                        <DataGridTextColumn.Binding>
                                            <Binding Path="AmountPaid" StringFormat="{}{0:N2} DA" TargetNullValue="0.00 DA"/>
                                        </DataGridTextColumn.Binding>
                                    </DataGridTextColumn>

                                    <!-- Rest -->
                                    <DataGridTextColumn Header="Reste" Width="100">
                                        <DataGridTextColumn.Binding>
                                            <Binding Path="AmountRest" StringFormat="{}{0:N2} DA" TargetNullValue="0.00 DA"/>
                                        </DataGridTextColumn.Binding>
                                    </DataGridTextColumn>

                                    <!-- Actions -->
                                    <DataGridTemplateColumn Header="Actions" Width="150" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <!-- Preview -->
                                                    <Button Style="{StaticResource IconButton}"
                                                            Width="36" Height="36"
                                                            Margin="2,0"
                                                            ToolTip="Aperçu"
                                                            Click="PreviewInvoice_Click"
                                                            Tag="{Binding}">
                                                        <materialDesign:PackIcon Kind="Eye" 
                                                                                  Foreground="{StaticResource AccentBrush}"
                                                                                  Width="20" Height="20"/>
                                                    </Button>

                                                    <!-- Edit -->
                                                    <Button Command="{Binding DataContext.EditInvoiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource IconButton}"
                                                            Width="36" Height="36"
                                                            Margin="2,0"
                                                            ToolTip="Modifier">
                                                        <materialDesign:PackIcon Kind="Pencil" 
                                                                                Foreground="{StaticResource PrimaryBrush}"
                                                                                Width="20" Height="20"/>
                                                    </Button>

                                                    <!-- Delete -->
                                                    <Button Command="{Binding DataContext.DeleteInvoiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding Id}"
                                                            Style="{StaticResource IconButton}"
                                                            Width="36" Height="36"
                                                            Margin="2,0"
                                                            ToolTip="Supprimer">
                                                        <materialDesign:PackIcon Kind="Close" 
                                              Foreground="{StaticResource DangerBrush}"
                                              Width="20" Height="20"/>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock Text="💡 Les boutons Modifier et Supprimer sont disponibles par ligne." 
                                       FontSize="12"
                                       Margin="5,5,5,5"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontStyle="Italic"/>
                        </StackPanel>

                    </Grid>
                </materialDesign:Card>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>