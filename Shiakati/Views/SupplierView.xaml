<UserControl x:Class="Shiakati.Views.SupplierView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000"
             Background="{StaticResource BgAltBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- header -->
            <RowDefinition Height="*"/>
            <!-- content -->
        </Grid.RowDefinitions>

        <!-- Header (optional – already in MainView) -->
        <TextBlock Grid.Row="0" Text="Fournisseurs" FontSize="20" FontWeight="SemiBold"
                   Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,12"/>

        <!-- Main 2‑column layout -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- ─── LEFT: Supplier List ─── -->
            <materialDesign:Card Grid.Column="0" Style="{StaticResource ShiakatiCard}" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <materialDesign:PackIcon Kind="Truck" Width="20" Height="20"
                                                  Foreground="{StaticResource PrimaryBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="Liste des fournisseurs" 
                                   FontFamily="{StaticResource HeadingFont}"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryBrush}"/>
                        <Button Command="{Binding AddSupplierCommand}"
                                Style="{StaticResource HelpChipButton}"
                                Padding="8,2" Margin="12,0,0,0"
                                HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" Width="14" Height="14" Margin="0,0,4,0"/>
                                <TextBlock Text="Ajouter" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <DataGrid Grid.Row="1" 
                              Style="{StaticResource ShiakatiDataGrid}"
                              ColumnHeaderStyle="{StaticResource ShiakatiDataGridColumnHeader}"
                              CellStyle="{StaticResource ShiakatiDataGridCell}"
                              RowStyle="{StaticResource ShiakatiDataGridRow}"
                              ItemsSource="{Binding Suppliers}"
                              SelectedItem="{Binding SelectedSupplier}"
                              AutoGenerateColumns="False"
                              MaxHeight="400">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nom" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Tél" Binding="{Binding Phone}" Width="Auto"/>
                            <DataGridTextColumn Header="Actif" Binding="{Binding IsActive}" Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </materialDesign:Card>

            <!-- ─── RIGHT: Detail Panel (Scrollable) ─── -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" 
                          HorizontalScrollBarVisibility="Disabled">
                <materialDesign:Card Style="{StaticResource ShiakatiCard}" Margin="8,0,0,0">
                    <StackPanel>

                        <!-- Header -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <materialDesign:PackIcon Kind="Account" 
                                                      Foreground="{StaticResource PrimaryBrush}"
                                                      Width="20" Height="20" Margin="0,0,8,0"/>
                            <TextBlock Text="Détails du fournisseur" 
                                       FontFamily="{StaticResource HeadingFont}"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryBrush}"/>
                        </StackPanel>

                        <!-- Name -->
                        <TextBox Text="{Binding SelectedSupplier.Name, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ShiakatiTextBox}"
                                 materialDesign:HintAssist.Hint="Nom du fournisseur"
                                 Margin="0,0,0,8"/>

                        <!-- Contact -->
                        <TextBox Text="{Binding SelectedSupplier.ContactPerson, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ShiakatiTextBox}"
                                 materialDesign:HintAssist.Hint="Personne à contacter"
                                 Margin="0,0,0,8"/>

                        <!-- Phone -->
                        <TextBox Text="{Binding SelectedSupplier.Phone, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ShiakatiTextBox}"
                                 materialDesign:HintAssist.Hint="Téléphone"
                                 Margin="0,0,0,8"/>

                        <!-- Email & Address -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" 
                                     Text="{Binding SelectedSupplier.Email, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ShiakatiTextBox}"
                                     materialDesign:HintAssist.Hint="Email"
                                     Margin="0,0,6,0"/>
                            <TextBox Grid.Column="1" 
                                     Text="{Binding SelectedSupplier.Address, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ShiakatiTextBox}"
                                     materialDesign:HintAssist.Hint="Adresse"
                                     Margin="6,0,0,0"/>
                        </Grid>

                        <!-- Invoices Section (with fixed height + scroll) -->
                        <Border BorderBrush="{StaticResource BgAltBrush}" 
                                BorderThickness="0,1,0,0" Padding="0,12,0,0"
                                Margin="0,8,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal" Grid.Column="0">
                                    <materialDesign:PackIcon Kind="FileDocument" 
                                                              Foreground="{StaticResource TextSecondaryBrush}"
                                                              Width="18" Height="18" Margin="0,0,8,0"/>
                                    <TextBlock Text="Factures" 
                                               FontFamily="{StaticResource HeadingFont}"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding SelectedSupplier.Invoices.Count, StringFormat=' ({0})'}" 
                                               FontFamily="{StaticResource BodyFont}"
                                               FontSize="14"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>

                                <Button Grid.Column="1" 
                                        Command="{Binding UploadInvoiceCommand}"
                                        Style="{StaticResource HelpChipButton}"
                                        Padding="12,4">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Upload" Width="16" Height="16" Margin="0,0,6,0"/>
                                        <TextBlock Text="Ajouter" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Invoice List (scrollable, max height) -->
                        <ListBox ItemsSource="{Binding SelectedSupplier.Invoices}"
                                 Background="Transparent" BorderThickness="0"
                                 MaxHeight="150" Margin="0,0,0,12"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BgAltBrush}" 
                                            CornerRadius="6" Padding="8" Margin="0,0,0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Image Grid.Column="0" 
                                                   Source="{Binding FilePath}" 
                                                   Width="50" Height="40" 
                                                   Stretch="Uniform"
                                                   Margin="0,0,10,0"/>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FileName}" 
                                                           FontFamily="{StaticResource BodyFont}"
                                                           FontSize="13"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding UploadedAt, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" 
                                                           FontFamily="{StaticResource BodyFont}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </StackPanel>

                                            <Button Grid.Column="2" 
                                                    Command="{Binding DataContext.DeleteInvoiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Id}"
                                                    Style="{StaticResource IconButton}"
                                                    Width="28" Height="28">
                                                <materialDesign:PackIcon Kind="Close" 
                                                                          Foreground="{StaticResource DangerBrush}"
                                                                          Width="16" Height="16"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Action Buttons -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button Command="{Binding DeleteSupplierCommand}"
                                    Style="{StaticResource DangerButton}"
                                    MinHeight="36" MinWidth="100" FontSize="13"
                                    Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Delete" Width="16" Height="16" Margin="0,0,6,0"/>
                                    <TextBlock Text="Supprimer"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding SaveSupplierCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    MinHeight="36" MinWidth="100" FontSize="13">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ContentSave" Width="16" Height="16" Margin="0,0,6,0"/>
                                    <TextBlock Text="Enregistrer"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                    </StackPanel>
                </materialDesign:Card>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>