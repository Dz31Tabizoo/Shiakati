<UserControl x:Class="Shiakati.Views.POSContainerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:views="clr-namespace:Shiakati.Views"
             Background="Transparent"
             FontFamily="{StaticResource BodyFont}">

    <Grid>
        <!-- Tab control – fills the entire UserControl -->
        <TabControl ItemsSource="{Binding PosTabs}"
                    SelectedItem="{Binding SelectedTab}"
                    Style="{StaticResource MaterialDesignTabControl}"
                    BorderBrush="{DynamicResource BgAltBrush}"
                    Background="{DynamicResource BgAltBrush}">

            <TabControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="4,0">
                        <materialDesign:PackIcon Kind="TicketOutline"
                                                 Width="16" Height="16"
                                                 VerticalAlignment="Center"
                                                 Foreground="{DynamicResource DarkLightTextNavyWhiteBrush}"
                                                 Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding TabName}"
                                   VerticalAlignment="Center"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource DarkLightTextNavyWhiteBrush}"
                                   Margin="0,0,8,0"/>
                        <Button Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                CommandParameter="{Binding}"
                                Style="{DynamicResource MaterialDesignIconForegroundButton}"
                                Width="20" Height="20" Margin="5,-2,0,0"
                                ToolTip="Fermer la vente">
                            <materialDesign:PackIcon Kind="Close" Width="12" Height="12"/>
                        </Button>
                    </StackPanel>
                </DataTemplate>
            </TabControl.ItemTemplate>

            <TabControl.ContentTemplate>
                <DataTemplate>
                    <views:PosView />
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>

        <!-- Compact "new tab" button floating over the tab strip -->
        <Button Style="{StaticResource MaterialDesignIconForegroundButton}"
                Width="30" Height="30"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,5,8,0"
                Command="{Binding AddNewTabCommand}"
                ToolTip="Nouvelle vente"
                Background="{DynamicResource SecondaryBrush}"
                Foreground="{StaticResource TextOnPrimaryBrush}">
            <materialDesign:PackIcon Kind="PersonAddOutline" Width="18" Height="18"/>
        </Button>
    </Grid>
</UserControl>