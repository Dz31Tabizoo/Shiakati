<Window x:Class="Shiakati.Views.ClientSelectorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Sélectionner un client" Width="850" Height="520"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource BodyFont}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Search bar -->
        <TextBox Grid.Row="0"
                 x:Name="SearchTextBox"
                 materialDesign:HintAssist.Hint="Rechercher par nom ou téléphone…"
                 Style="{StaticResource ShiakatiTextBox}"
                 FontSize="14" Margin="0,0,0,12"
                 TextChanged="SearchTextBox_TextChanged"/>

        <!-- Clients DataGrid -->
        <DataGrid Grid.Row="1"
                  x:Name="ClientsGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  MouseDoubleClick="ClientsGrid_MouseDoubleClick"
                  Style="{StaticResource ShiakatiDataGrid}"
                  ColumnHeaderStyle="{StaticResource ShiakatiDataGridColumnHeader}"
                  CellStyle="{StaticResource ShiakatiDataGridCell}"
                  RowStyle="{StaticResource ShiakatiDataGridRow}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nom" Binding="{Binding FullName}" Width="*" FontSize="14"/>
                <DataGridTextColumn Header="Téléphone" Binding="{Binding PhoneNumber}" Width="Auto" FontSize="14"/>
                <DataGridTextColumn Header="Crédits" Binding="{Binding TotalCredits, StringFormat={}{0:N2} DA}" Width="Auto" FontSize="14"/>
                <DataGridTextColumn Header="Versements" Binding="{Binding TotalVersements, StringFormat={}{0:N2} DA}" Width="Auto" FontSize="14"/>
                <DataGridTextColumn Header="Achats" Binding="{Binding TotalPurchases, StringFormat={}{0:N2} DA}" Width="Auto" FontSize="14"
                        Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold"/>
                <DataGridTextColumn Header="Solde" Binding="{Binding NetBalance, StringFormat={}{0:N2} DA}" Width="Auto" FontWeight="SemiBold"
                        Foreground="{StaticResource SecondaryBrush}"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Select button -->
        <Button Grid.Row="2" Content="Sélectionner"
                Style="{StaticResource PrimaryButton}"
                MinHeight="44" FontSize="14"
                Margin="0,12,0,0" HorizontalAlignment="Right"
                Click="SelectButton_Click"/>
    </Grid>
</Window>