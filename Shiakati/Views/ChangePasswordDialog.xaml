<Window x:Class="Shiakati.Views.ChangePasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Changer le mot de passe" Width="400" Height="405"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FontFamily="{StaticResource BodyFont}"
        Background="{StaticResource BgBrush}"
        Style="{StaticResource ShiakatiDialogStyle}">

    <Border BorderThickness="1.5" BorderBrush="{DynamicResource DarkLightTextNavyWhiteBrush}">

        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" 
      Height="48"
      Margin="0,0,0,15"
      Background="{DynamicResource SecondaryBrush}"
      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Window title (left aligned) -->
                <TextBlock Grid.Column="0"
               Text="Changer le mot de passe"
               FontSize="18" FontWeight="Bold"
               Foreground="{StaticResource TextOnPrimaryBrush}"
               VerticalAlignment="Center"
               Margin="12,0,0,0"/>

                <!-- Close button (right aligned) -->
                <Button Grid.Column="1"
            x:Name="btnClose"
            Click="btnClose_Click"
            Style="{StaticResource MaterialDesignFlatButton}"
            Width="48" Height="48"
            VerticalAlignment="Center"
            Foreground="{StaticResource TextOnPrimaryBrush}">
                    <materialDesign:PackIcon Kind="Close" 
                     Width="24" Height="24"
                     VerticalAlignment="Center"
                     HorizontalAlignment="Center"/>
                </Button>
            </Grid>

            <!-- Old password -->
            <PasswordBox x:Name="OldPasswordBox" Grid.Row="1"
                     Style="{StaticResource MaterialDesignRevealPasswordBox}"
                     materialDesign:HintAssist.Hint="Ancien mot de passe"
                     FontSize="14" Height="50" Margin="0,0,0,10"/>

            <!-- New password -->
            <PasswordBox x:Name="NewPasswordBox" Grid.Row="2"
                     Style="{StaticResource MaterialDesignRevealPasswordBox}"
                     materialDesign:HintAssist.Hint="Nouveau mot de passe"
                     FontSize="14" Height="50" Margin="0,0,0,10"/>

            <!-- Confirm new password -->
            <PasswordBox x:Name="ConfirmPasswordBox" Grid.Row="3"
                     Style="{StaticResource MaterialDesignRevealPasswordBox}"
                     materialDesign:HintAssist.Hint="Confirmer le mot de passe"
                     FontSize="14" Height="50" Margin="0,0,0,10"/>

            <!-- Buttons -->
            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Annuler" IsCancel="True" Click="Cancel_Click"
                    Style="{StaticResource SecondaryButton}" MinHeight="44" FontSize="14" Margin="0,0,10,0"/>
                <Button Content="Enregistrer" IsDefault="True" Click="Save_Click"
                    Style="{StaticResource PrimaryButton}" MinHeight="44" FontSize="14"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>