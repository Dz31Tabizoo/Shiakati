<Window x:Class="Shiakati.Views.ClientEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Modifier le client" Width="500" Height="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FontFamily="{StaticResource BodyFont}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBox Grid.Row="0" Text="{Binding FullName}"
                 materialDesign:HintAssist.Hint="Nom complet"
                 Style="{StaticResource ShiakatiTextBox}" Margin="0,0,0,10"/>
        <TextBox Grid.Row="1" Text="{Binding PhoneNumber}"
                 materialDesign:HintAssist.Hint="Numéro de téléphone"
                 Style="{StaticResource ShiakatiTextBox}" Margin="0,0,0,10"/>
        <TextBox Grid.Row="2" Text="{Binding Address}"
                 materialDesign:HintAssist.Hint="Adresse (optionnelle)"
                 Style="{StaticResource ShiakatiTextBox}" Margin="0,0,0,10"/>
        <TextBox Grid.Row="3" Text="{Binding Email}"
                 materialDesign:HintAssist.Hint="Email (optionnel)"
                 Style="{StaticResource ShiakatiTextBox}" Margin="0,0,0,40"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Annuler" Click="Cancel_Click"
                    Style="{StaticResource SecondaryButton}"
                    MinHeight="44" FontSize="14" Margin="0,0,10,0"/>
            <Button Content="Enregistrer" Click="Ok_Click"
                    Style="{StaticResource PrimaryButton}"
                    MinHeight="44" FontSize="14"/>
        </StackPanel>
    </Grid>
</Window>