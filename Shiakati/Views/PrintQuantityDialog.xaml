<Window x:Class="Shiakati.Views.PrintQuantityDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Impression" Height="230" Width="380"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"        
        Style="{StaticResource ShiakatiDialogStyle}">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <Grid Grid.Row="0" 
      Height="48"
      Margin="0,0,0,15"
      Background="{DynamicResource SecondaryBrush}"
      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Window title (left aligned) -->
            <TextBlock Grid.Column="0"
               Text="Impréssion"
               FontSize="18" FontWeight="Bold"
               Foreground="{StaticResource TextOnPrimaryBrush}"
               VerticalAlignment="Center"
               Margin="12,0,0,0"/>

            <!-- Close button (right aligned) -->
            <Button Grid.Column="1"
            x:Name="btnClose"
            Click="btnClose_Click"
            Style="{StaticResource MaterialDesignFlatSecondaryButton}"
            Width="48" Height="48"
            VerticalAlignment="Center"
            Foreground="{StaticResource TextOnPrimaryBrush}">
                <materialDesign:PackIcon Kind="Close" 
                     Width="24" Height="24"
                     VerticalAlignment="Center"
                     HorizontalAlignment="Center"/>
            </Button>
        </Grid>

        <!-- Quantity input (digits only) -->
        <TextBox x:Name="TxtQuantity"
                 Grid.Row="1"
                 materialDesign:HintAssist.Hint="Nombre d'étiquettes"
                 Style="{StaticResource ShiakatiTextBox}"
                 FontSize="18"
                 Margin="0,0,0,16"
                 PreviewTextInput="NumberValidationTextBox"/>

        <!-- Spacer -->
        <Grid Grid.Row="2"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="ANNULER"
                    IsCancel="True"
                    Style="{StaticResource SecondaryButton}"
                    MinHeight="44" FontSize="14"
                    Margin="0,0,12,0">
                </Button>



            <Button 
                    IsDefault="True"
                    Click="Print_Click"
                    Style="{StaticResource PrimaryButton}"
                    MinHeight="44" FontSize="14">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Barcode"
                     Width="24" Height="24"
                     VerticalAlignment="Center"
                     Margin="0,0,10,0"/>
                    <TextBlock FontWeight="SemiBold" Foreground="{StaticResource BgBrush}" Text="IMPRIMER" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>