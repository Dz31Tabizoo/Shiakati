<Window x:Class="Shiakati.Views.PrintQuantityDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:Shiakati.Views"
        Title="Impression" Height="250" Width="350" 
        WindowStyle="None"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}">
    <Grid Margin="10">
        <StackPanel>
            <TextBlock Style="{StaticResource MaterialDesignHeadline6TextBlock}" 
                       Text="Quantité à imprimer" Margin="0,0,0,10"/>

            <TextBox x:Name="TxtQuantity" 
                     md:HintAssist.Hint="Nombre d'étiquettes"
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                     FontSize="18" Margin="0,10"
                     PreviewTextInput="NumberValidationTextBox"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,30,0,0">
                <Button Content="ANNULER" IsCancel="True" Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,10,0"/>
                <Button Content="IMPRIMER" IsDefault="True" Click="Print_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>