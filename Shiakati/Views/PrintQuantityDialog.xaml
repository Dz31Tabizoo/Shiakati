<Window x:Class="Shiakati.Views.PrintQuantityDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Impression" Height="260" Width="380"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource BodyFont}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="Quantité à imprimer"
                   FontFamily="{StaticResource HeadingFont}"
                   FontSize="20" FontWeight="Bold"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   Margin="0,0,0,20"/>

        <!-- Quantity input (digits only) -->
        <TextBox x:Name="TxtQuantity"
                 Grid.Row="1"
                 materialDesign:HintAssist.Hint="Nombre d'étiquettes"
                 Style="{StaticResource ShiakatiTextBox}"
                 FontSize="18"
                 Margin="0,0,0,16"
                 PreviewTextInput="NumberValidationTextBox"/>

        <!-- Spacer -->
        <Grid Grid.Row="2"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="ANNULER"
                    IsCancel="True"
                    Style="{StaticResource SecondaryButton}"
                    MinHeight="44" FontSize="14"
                    Margin="0,0,12,0">
                </Button>



            <Button 
                    IsDefault="True"
                    Click="Print_Click"
                    Style="{StaticResource PrimaryButton}"
                    MinHeight="44" FontSize="14">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Barcode"
                     Width="24" Height="24"
                     VerticalAlignment="Center"
                     Margin="0,0,10,0"/>
                    <TextBlock FontWeight="SemiBold" Foreground="{StaticResource BgBrush}" Text="IMPRIMER" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>