<UserControl x:Class="Shiakati.Views.StockMovementsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="768" d:DesignWidth="1024"
             FontFamily="{StaticResource MontserratFont}"
             Background="{DynamicResource MaterialDesignPaper}"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Filter bar -->
        <materialDesign:Card Grid.Row="0" Margin="0,0,0,16" Padding="16" UniformCornerRadius="8">
            <StackPanel>
                <!-- Quick period chips -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="Aujourd'hui" Command="{Binding QuickSetPeriodCommand}" CommandParameter="today"
                    Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,5,0"/>
                    <Button Content="Hier" Command="{Binding QuickSetPeriodCommand}" CommandParameter="yesterday"
                    Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,5,0"/>
                    <Button Content="Semaine passée" Command="{Binding QuickSetPeriodCommand}" CommandParameter="lastweek"
                    Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,5,0"/>
                    <Button Content="Mois passé" Command="{Binding QuickSetPeriodCommand}" CommandParameter="lastmonth"
                    Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,5,0"/>
                    <Button Content="Année" Command="{Binding QuickSetPeriodCommand}" CommandParameter="year"
                    Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,5,0"/>
                    <Button Content="Tout l'historique" Command="{Binding QuickSetPeriodCommand}" CommandParameter="all"
                    Style="{StaticResource MaterialDesignFlatButton}"/>
                </StackPanel>

                <!-- Original date filter row -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <DatePicker Grid.Column="0" 
                        SelectedDate="{Binding StartDate}"
                        materialDesign:HintAssist.Hint="Du"
                        Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                        Margin="0,0,16,0" VerticalAlignment="Center"/>

                    <DatePicker Grid.Column="1" 
                        SelectedDate="{Binding EndDate}"
                        materialDesign:HintAssist.Hint="Au"
                        Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                        Margin="0,0,16,0" VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding LoadMovementsCommand}" 
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Margin="0,0,8,0" Content="Rechercher" Cursor="Hand"/>

                        <Button Command="{Binding ClearFiltersCommand}" 
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Content="Réinitialiser" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </materialDesign:Card>
        <!-- Grid -->
        <materialDesign:Card Grid.Row="1" UniformCornerRadius="8">
            <DataGrid ItemsSource="{Binding Movements}" 
                      AutoGenerateColumns="False" 
                      CanUserAddRows="False" 
                      IsReadOnly="True"
                      HeadersVisibility="All"
                      SelectionMode="Single"
                      materialDesign:DataGridAssist.CellPadding="12"
                      materialDesign:DataGridAssist.ColumnHeaderPadding="12">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date" Binding="{Binding MovementDate, StringFormat=dd/MM/yyyy HH:mm}" Width="Auto"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding MovementType}" Width="Auto"/>
                    <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="Auto"/>
                    <DataGridTextColumn Header="Produit" Binding="{Binding ProductName}" Width="*"/>
                    <DataGridTextColumn Header="Couleur" Binding="{Binding Color}" Width="Auto"/>
                    <DataGridTextColumn Header="Taille" Binding="{Binding FullSize}" Width="Auto"/>
                    <DataGridTextColumn Header="Qté" Binding="{Binding Quantity}" Width="Auto"/>
                    <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="2*"/>
                </DataGrid.Columns>
            </DataGrid>
        </materialDesign:Card>
    </Grid>
</UserControl>
