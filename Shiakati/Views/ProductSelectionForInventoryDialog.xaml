<Window x:Class="Shiakati.Views.ProductSelectionForInventoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Sélectionner les produits pour l'inventaire" Width="550" Height="450"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None"
        Style="{StaticResource ShiakatiDialogStyle}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" 
      Height="48"
      Margin="0,0,0,15"
      Background="{DynamicResource SecondaryBrush}"
      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Window title (left aligned) -->
            <TextBlock Grid.Column="0"
               Text="Inventaire"
               FontSize="18" FontWeight="Bold"
               Foreground="{StaticResource TextOnPrimaryBrush}"
               VerticalAlignment="Center"
               Margin="12,0,0,0"/>

            <!-- Close button (right aligned) -->
            <Button Grid.Column="1"
            x:Name="btnClose"
            Click="btnClose_Click"
            Style="{StaticResource MaterialDesignFlatSecondaryButton}"
            Width="48" Height="48"
            VerticalAlignment="Center"
            Foreground="{StaticResource TextOnPrimaryBrush}">
                <materialDesign:PackIcon Kind="Close" 
                     Width="24" Height="24"
                     VerticalAlignment="Center"
                     HorizontalAlignment="Center"/>
            </Button>
        </Grid>


        <TextBlock Grid.Row="1" Text="Sélectionnez les produits" FontSize="14" FontWeight="Light"
                   Foreground="{DynamicResource  TextSecondaryBrush}" Margin="0,0,0,6"/>

        <DataGrid Grid.Row="2" x:Name="ProductsGrid" AutoGenerateColumns="False"
                  Style="{StaticResource ShiakatiDataGrid}"
                  ColumnHeaderStyle="{StaticResource ShiakatiDataGridColumnHeader}"
                  CellStyle="{StaticResource ShiakatiDataGridCell}"
                  RowStyle="{StaticResource ShiakatiDataGridRow}">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Sél." Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Marque" Binding="{Binding BrandName}" Width="*" FontSize="14"/>
                <DataGridTextColumn Header="Produit" Binding="{Binding ProductName}" Width="*" FontSize="14"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Annuler" IsCancel="True" Click="Cancel_Click"
                    Style="{StaticResource SecondaryButton}" MinHeight="44" FontSize="14" Margin="0,0,10,0"/>
            <Button Content="Imprimer" IsDefault="True" Click="Print_Click"
                    Style="{StaticResource PrimaryButton}" MinHeight="44" FontSize="14"/>
        </StackPanel>
    </Grid>
</Window>
