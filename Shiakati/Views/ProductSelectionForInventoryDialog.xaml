<Window x:Class="Shiakati.Views.ProductSelectionForInventoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Sélectionner les produits pour l'inventaire" Width="550" Height="450"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FontFamily="{StaticResource BodyFont}"
        Background="{StaticResource BgBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Sélectionnez les produits" FontSize="18" FontWeight="Bold"
                   Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,12"/>

        <DataGrid Grid.Row="1" x:Name="ProductsGrid" AutoGenerateColumns="False"
                  Style="{StaticResource ShiakatiDataGrid}"
                  ColumnHeaderStyle="{StaticResource ShiakatiDataGridColumnHeader}"
                  CellStyle="{StaticResource ShiakatiDataGridCell}"
                  RowStyle="{StaticResource ShiakatiDataGridRow}">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Sél." Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Marque" Binding="{Binding BrandName}" Width="*" FontSize="14"/>
                <DataGridTextColumn Header="Produit" Binding="{Binding ProductName}" Width="*" FontSize="14"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Annuler" IsCancel="True" Click="Cancel_Click"
                    Style="{StaticResource SecondaryButton}" MinHeight="44" FontSize="14" Margin="0,0,10,0"/>
            <Button Content="Imprimer" IsDefault="True" Click="Print_Click"
                    Style="{StaticResource PrimaryButton}" MinHeight="44" FontSize="14"/>
        </StackPanel>
    </Grid>
</Window>
