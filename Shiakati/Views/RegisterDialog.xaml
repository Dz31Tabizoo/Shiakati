<Window x:Class="Shiakati.Views.RegisterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Création d'utilisateur" Width="400" Height="550"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None"
        Style="{StaticResource ShiakatiDialogStyle}">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <!-- 👈 This is Row 6 for buttons -->
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" 
                  Height="35"
                  Margin="0,0,0,15"
                  Background="{DynamicResource SecondaryBrush}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Window title (left aligned) -->
            <TextBlock Grid.Column="0"
                           Text="Création d'utilisateur"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource TextOnPrimaryBrush}"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"/>

            <!-- Close button (right aligned) -->
            <Button Grid.Column="1"
                        x:Name="btnClose"
                        Click="btnClose_Click"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Width="48" Height="48"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource TextOnPrimaryBrush}">
                <materialDesign:PackIcon Kind="Close" 
                                 Width="24" Height="24"
                                 VerticalAlignment="Center"
                                 HorizontalAlignment="Center"/>
            </Button>
        </Grid>


        <!-- Username -->
        <TextBox x:Name="UsernameBox" Grid.Row="1"
                 Style="{StaticResource ShiakatiTextBox}"
                 materialDesign:HintAssist.Hint="Nom d'utilisateur / اسم المستخدم"
                 FontSize="14" Height="50" Margin="0,0,0,10"/>

        <!-- New password -->
        <PasswordBox x:Name="NewPasswordBox" Grid.Row="2"
                     Style="{StaticResource MaterialDesignRevealPasswordBox}"
                     materialDesign:HintAssist.Hint="  Mot de passe / كلمة المرور"
                     FontSize="14" Height="50" Margin="0,0,0,10"/>

        <!-- Confirm new password -->
        <PasswordBox x:Name="ConfirmPasswordBox" Grid.Row="3"
                     Style="{StaticResource MaterialDesignRevealPasswordBox}"
                     materialDesign:HintAssist.Hint="  Confirmer le mot de passe /تأكيد كلمة المرور"
                     FontSize="14" Height="50" Margin="0,0,0,25"/>

        <!-- Role ComboBox -->
        <ComboBox x:Name="Roles" Grid.Row="4"
                  Style="{StaticResource ShiakatiComboBox}"
                  materialDesign:HintAssist.Hint="Roles (تحديد الصلحيات)" 
                  Margin="0,0,0,10"
                  VerticalAlignment="Top"/>

        <!-- Buttons – now on Row 5 (the "*" row for spacing) and Row 6 -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Annuler" IsCancel="True" Click="Cancel_Click"
                    Style="{StaticResource SecondaryButton}" MinHeight="44" FontSize="14" Margin="0,0,10,0"/>
            <Button Content="Enregistrer" IsDefault="True" Click="Save_Click"
                    Style="{StaticResource PrimaryButton}" MinHeight="44" FontSize="14"/>
        </StackPanel>
    </Grid>
</Window>