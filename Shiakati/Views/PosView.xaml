<UserControl x:Class="Shiakati.Views.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:vw="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             xmlns:converters="clr-namespace:Shiakati.Converters"
             d:DesignHeight="768" d:DesignWidth="1024"
             FontFamily="{StaticResource BodyFont}"
             Background="{DynamicResource BgAltBrush}">

    <UserControl.InputBindings>
        <KeyBinding Key="F12" Command="{Binding CheckoutCommand}" />
    </UserControl.InputBindings>

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:CommonEqualityConverter x:Key="CommonEqualityConverter" />
        <converters:CategoryToIconConverter x:Key="CategoryToIconConverter"/>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════ LEFT: Product Browser ═══════════ -->
        <Grid Grid.Column="0" Margin="0,0,15,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Search bar -->
            <materialDesign:Card Grid.Row="0" Padding="12" UniformCornerRadius="12" Margin="0,0,0,12"
                                 Background="{DynamicResource BgBrush}" Style="{DynamicResource ShiakatiLightCard}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="BarcodeScan" Width="28" Height="28"
                                             VerticalAlignment="Center"
                                             Foreground="{DynamicResource DarkLightTextNavyWhiteBrush}"
                                             Margin="0,0,10,0"/>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Scanner un code-barres ou chercher un produit..."
                             Style="{StaticResource ShiakatiTextBox}"
                             Width="400" FontSize="16"
                             VerticalAlignment="Center"/>
                </StackPanel>
            </materialDesign:Card>
            <!-- Client selector -->

            <!-- STAGE 1 – CATEGORY CARDS -->
            <ScrollViewer Grid.Row="1" 
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding IsStage1Visible, Converter={StaticResource BoolToVis}}">
                <ItemsControl ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    
                    <ItemsControl.ItemTemplate>                        
                        <DataTemplate>                            
                            <Button Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Width="180" Height="290"
                                    Margin="5" Padding="0"
                                    Cursor="Hand"
                                    Style="{StaticResource MaterialDesignFlatButton}">
                                
                                <Border CornerRadius="12"
                                        Background="{DynamicResource SecondaryDarkGradientBrush}"
                                        BorderBrush="{DynamicResource BgAltBrush}"
                                        BorderThickness="1">
                                    <Grid>
                                        
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        
                                        <Image Grid.Row="0"
                                               Source="{Binding CategoryName, Converter={StaticResource CategoryCardImageConverter}}"
                                               Stretch="Uniform"
                                               Margin="15"/>
                                        
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding CategoryName}"
                                                   FontSize="18" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,10"
                                                   TextWrapping="Wrap" TextAlignment="Center"/>
                                        
                                    </Grid>
                                    
                                </Border>                                
                            </Button>                            
                        </DataTemplate>
                        
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <!-- ═══════════ STAGE 2 – BRAND CARDS ═══════════ -->
            <Grid Grid.Row="1" Visibility="{Binding IsStage2Visible, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Back button -->
                <Button Grid.Row="0" Content="← Retour"
            Style="{StaticResource HelpChipButton}"
            Command="{Binding ResetCommand}"
            HorizontalAlignment="Left"
            Margin="4,0,0,4"/>

                <!-- User tip -->
                <TextBlock Grid.Row="1"
               Text="Sélectionnez une marque :"
               FontSize="15" FontWeight="Medium"
               Foreground="{DynamicResource TextSecondaryBrush}"
               Margin="8,0,0,8"/>

                <!-- Brand cards (fixed size, scrollable vertically) -->
                <ScrollViewer Grid.Row="2"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding BrandsForCategory}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.SelectBrandCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Width="120" Height="90"         
                                        Margin="6" Padding="0"
                                        Cursor="Hand"
                                        Style="{StaticResource MaterialDesignFlatButton}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="cardBorder"
                                                    CornerRadius="10"
                                                    Background="{DynamicResource BgBrush}"
                                                    BorderBrush="{DynamicResource BgAltBrush}"
                                                    BorderThickness="1">
                                                <Border.Effect>
                                                    <DropShadowEffect ShadowDepth="1" BlurRadius="4"
                                                          Opacity="0.1" Color="Black"/>
                                                </Border.Effect>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- Placeholder icon (same for all) -->
                                                    <materialDesign:PackIcon Grid.Row="0"
                                                                 Kind="TagApprove"
                                                                 Width="28" Height="28"
                                                                 Foreground="{DynamicResource SecondaryBrush}"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Top"
                                                                 Margin="0,8,10,4"/>

                                                    <!-- Brand name – always the same area, text trimmed/centered -->
                                                    <TextBlock Grid.Row="1"
                                                   Text="{Binding BrandName}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Margin="8,10,8,10"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="NoWrap"
                                                   MaxWidth="160"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="cardBorder"
                                                Property="BorderBrush"
                                                Value="{DynamicResource SecondaryBrush}"/>
                                                    <Setter TargetName="cardBorder"
                                                Property="BorderThickness" Value="2"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
            <!-- STAGE 3 – FILTERS + PRODUCT GRID -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4"
                Visibility="{Binding IsStage3Visible, Converter={StaticResource BoolToVis}}">
                <Button Content="← Retour" Style="{StaticResource HelpChipButton}"
                Command="{Binding ResetCommand}" Margin="0,0,8,0"/>
                
                <ComboBox FontSize="14" 
                          Width="140"
                          materialDesign:HintAssist.Hint="Couleur"
                          Style="{StaticResource ShiakatiComboBox}"
                          ItemsSource="{Binding AvailableColors}"
                          SelectedItem="{Binding SelectedColor}"
                          Margin="0,0,10,0"/>

                <ComboBox FontSize="14" 
                          Width="140"
                          materialDesign:HintAssist.Hint="Taille"
                          Style="{StaticResource ShiakatiComboBox}"
                          ItemsSource="{Binding AvailableSizes}"
                          SelectedItem="{Binding SelectedSize}"
          />
            </StackPanel>
            <!-- Product grid -->
            <ListBox Grid.Row="2"
                     ItemsSource="{Binding FilteredProductsView}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Visibility="{Binding IsStage3Visible, Converter={StaticResource BoolToVis}}"               
                     Background="Transparent" BorderThickness="0"
                     HorizontalContentAlignment="Stretch">

                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <vw:VirtualizingWrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <!-- 👇 THIS WRAPPER IS CRUCIAL -->

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                CommandParameter="{Binding}"
                Width="185" Height="124" Margin="4"
                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="CardBorder"
                            Background="{DynamicResource BgBrush}"
                            BorderBrush="{DynamicResource InputBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8,6">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0" Margin="0,0,0,2">
                                                <TextBlock Text="{Binding BrandName}"
                                           FontFamily="{StaticResource ArabicFont}"
                                           FontSize="11" 
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontWeight="Medium"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="100"
                                           HorizontalAlignment="Left"/>

                                                <TextBlock Text="{Binding Sku}"
                                           FontSize="10" 
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           HorizontalAlignment="Right"
                                           Opacity="0.7"/>
                                            </Grid>

                                            <TextBlock Grid.Row="1"
                                       Text="{Binding ProductName}"
                                       FontSize="13" 
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Margin="0,2"/>

                                            <Border Grid.Row="2"
                                    Background="{DynamicResource BgAltBrush}"
                                    CornerRadius="4"
                                    Padding="5,2"
                                    HorizontalAlignment="Left"
                                    Margin="0,2,0,4">
                                                <TextBlock FontSize="11"
                                           Foreground="{DynamicResource DarkAccentBrush}"
                                           FontWeight="Medium"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="160">
                                    <Run Text="{Binding Color}"/><Run Text=" "/><Run Text="{Binding FullSize}"/>
                                                </TextBlock>
                                            </Border>

                                            <Grid Grid.Row="3">
                                                <TextBlock Text="{Binding SalePrice, StringFormat={}{0:N2} DA}"
                                           FontSize="13" 
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource SecondaryBrush}"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"/>

                                                <StackPanel HorizontalAlignment="Right" 
                                            Orientation="Horizontal" 
                                            VerticalAlignment="Center">
                                                    <Ellipse Width="6" Height="6"
                                             Fill="{DynamicResource GreenLightBrush}"
                                             Margin="0,0,4,0"/>
                                                    <TextBlock Text="{Binding StockQuantity}"
                                               FontSize="12"
                                               Foreground="{DynamicResource GreenLightBrush}"
                                               FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource BgAltBrush}"/>
                                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ListBox.ItemTemplate>


            </ListBox>
        </Grid>

        <!-- ═══════════ RIGHT: Cart & Checkout ═══════════ -->
        <materialDesign:Card Grid.Column="1" UniformCornerRadius="16"
                             
                     Width="Auto" MinWidth="400" 
                     Style="{StaticResource ShiakatiLightCard}">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Edit banner -->
                    <RowDefinition Height="Auto"/>
                    <!-- Title -->
                    <RowDefinition Height="*"/>
                    <!-- DataGrid -->
                    <RowDefinition Height="Auto"/>
                    <!-- Totals + buttons -->
                </Grid.RowDefinitions>

                <!-- Edit banner -->
                <materialDesign:Card Grid.Row="0" Background="{DynamicResource BgAltBrush}" 
                             Foreground="{DynamicResource DangerBrush}"
                             Padding="10" Margin="0,0,0,10"
                             Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}"
                             UniformCornerRadius="8">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AlertCircleOutline"
                                             Width="24" Height="24"
                                             Margin="0,0,10,0"
                                             VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding EditTicketNumber, StringFormat='MODIFICATION DU TICKET : {0}'}"
                               FontWeight="Bold" VerticalAlignment="Center" FontSize="16"/>
                        </StackPanel>
                        <Button Content="ANNULER"
                        Command="{Binding CancelEditCommand}"
                        Style="{StaticResource SecondaryButton}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </materialDesign:Card>

                <!-- Title -->
                <Grid Grid.Row="1" Margin="0,0,0,8" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" Text="Ticket Actuel"
                               FontSize="20" FontWeight="Bold" Padding="0,10"
                               Foreground="{DynamicResource DarkLightTextNavyWhiteBrush}" />

                    <Border HorizontalAlignment="Right" Grid.Column="1" Grid.Row="0"
                                CornerRadius="8"
                                BorderBrush="{DynamicResource SecondaryBrush}"
                                BorderThickness="1.5"
                                Background="{DynamicResource BgBrush}"
                                Padding="8,6" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AccountCircle"
                                             Width="20" Height="20"
                                             VerticalAlignment="Center"
                                             Foreground="{DynamicResource SecondaryBrush}"
                                             Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding ClientDisplay}"
                               VerticalAlignment="Center"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,8,0"/>
                            <Button Content="Clients Shiakati"
                            Command="{Binding OpenClientSelectionDialogCommand}"
                            Style="{DynamicResource SecondaryButton}"
                            MinHeight="32" FontSize="13"
                            Padding="8,4"
                            VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                </Grid>
                

                <!-- Cart DataGrid -->
                <DataGrid Grid.Row="2" ItemsSource="{Binding CartItems}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False" Background="Transparent"
                  BorderThickness="0"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  GridLinesVisibility="None"
                  HorizontalAlignment="Stretch"
                  SelectionMode="Single"
                  Style="{StaticResource ShiakatiDataGrid}">

                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader"
                       BasedOn="{StaticResource ShiakatiDataGridColumnHeader}"/>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <!-- Article -->
                        <DataGridTemplateColumn Header="Article" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"
                                       FontSize="15" TextWrapping="Wrap" Margin="0,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Quantité -->
                        <DataGridTemplateColumn Header="Quantité" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                        Width="32" Height="32" Padding="5"
                                        Command="{Binding DataContext.DecrementQtyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" Margin ="0,0,5,0">
                                            <materialDesign:PackIcon Kind="MinusCircle"/>
                                        </Button>
                                        <TextBlock Text="{Binding Quantity}" VerticalAlignment="Center"
                                           Margin="5,0" FontWeight="Bold"/>
                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                        Width="32" Height="32" Padding="0"
                                        Command="{Binding DataContext.IncrementQtyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" Margin ="5,0,0,0">
                                            <materialDesign:PackIcon Kind="PlusCircle"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Remises -->
                        <DataGridTemplateColumn Header="Remises" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0">
                                        <ToggleButton Style="{StaticResource MaterialDesignActionToggleButton}"
                                              IsChecked="{Binding IsDiscountPinned}"
                                              Command="{Binding ToggleDiscountCommand}"
                                              Width="40" Height="40"
                                              Background="Transparent" BorderThickness="1"
                                              ToolTip="Remise fixe du produit">
                                            <ToggleButton.Content>
                                                <materialDesign:PackIcon Kind="TagOutline" Width="20" Height="20" Foreground="Gray"/>
                                            </ToggleButton.Content>
                                            <materialDesign:ToggleButtonAssist.OnContent>
                                                <materialDesign:PackIcon Kind="Tag" Width="20" Height="20" Foreground="#FF9800"/>
                                            </materialDesign:ToggleButtonAssist.OnContent>
                                        </ToggleButton>
                                        <TextBox Text="{Binding ManualDiscount, UpdateSourceTrigger=PropertyChanged}"
                                         Width="70" Margin="10,0,0,0" Padding="5,5,5,5"
                                         materialDesign:HintAssist.Hint="DA"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         VerticalAlignment="Center" TextAlignment="Center"
                                         FontSize="14" FontWeight="SemiBold" Foreground="#FF9800"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Total -->
                        <DataGridTemplateColumn Header="Total" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TotalPrice, StringFormat={}{0:N2}}"
                                       VerticalAlignment="Center" FontWeight="Bold"
                                       Foreground="{DynamicResource DarkLightTextNavyWhiteBrush}" Margin="10,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Remove -->
                        <DataGridTemplateColumn Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource MaterialDesignIconButton}"
                                    Command="{Binding DataContext.RemoveFromCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" HorizontalAlignment="Right" Foreground="{DynamicResource DangerBrush}">
                                        <materialDesign:PackIcon Kind="CartRemove" Width="24" Height="24"/>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Totals & Checkout area -->
                <StackPanel Grid.Row="3" Margin="0,5,0,0">

                    <!-- Client chip – always right‑aligned -->

                    <Separator Margin="0,0,0,3"/>

                    <!-- Sub‑total -->
                    <Grid Margin="0,2">
                        <TextBlock Text="Sous-total :" FontSize="16"/>
                        <TextBlock Text="{Binding CartSubTotal, StringFormat={}{0:N2} DA}"
                           HorizontalAlignment="Right" FontWeight="SemiBold"/>
                    </Grid>

                    <!-- Discount -->
                    <Grid Margin="0,2">
                        <TextBlock Text="Remise totale :" FontSize="16" Foreground="Green"/>
                        <TextBlock Text="{Binding TotalDiscountAmount, StringFormat={}-{0:N2} DA}"
                           HorizontalAlignment="Right" Foreground="Green"/>
                    </Grid>

                    <!-- Total -->
                    <Grid Height="Auto" Margin="0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="TOTAL" FontSize="24" FontWeight="Bold"
                           Foreground="{DynamicResource DarkLightTextNavyWhiteBrush}" Margin="0,0,15,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding CartTotal, StringFormat={}{0:N2} DA}"
                           FontSize="32" FontWeight="Bold"
                           HorizontalAlignment="Right"
                           Foreground="{StaticResource SecondaryBrush}"/>
                    </Grid>

                    <!-- Credit / Reservation buttons -->
                    <Grid Margin="5,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Button Grid.Column="2" Grid.Row="1"
                        Command="{Binding OpenReservationDialogCommand}"
                        Style="{StaticResource PrimaryGoldenButton}"
                        FontSize="18" FontWeight="Bold"
                        Margin="5,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="StoreClock"
                                                  Width="32" Height="32"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,10,0"/>
                                <TextBlock Text="RÉSERVATION" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Grid.Row="2" Command="{Binding OpenCreditSaleDialogCommand}"
                                Style="{StaticResource PrimaryGoldenButton}"
                                FontSize="18" FontWeight="Bold"
                                Margin="5,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CreditCardClock"
                                                  Width="32" Height="32"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,10,0"/>
                                <TextBlock  Text="CRÉDIT" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="0" Grid.Row="1"
                            Command="{Binding CheckoutCommand}" Height="60" MinWidth="340" Margin="5,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Content">
                                        <Setter.Value>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="CashRegister"
                                                              Width="32" Height="32"
                                                              VerticalAlignment="Center"
                                                              Margin="0,0,15,0"/>
                                                <TextBlock Text="E N C A I S S E R   (F12)"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                            <Setter Property="Background" Value="#FF9800"/>
                                            <Setter Property="Foreground" Value="#1E1E1E"/>
                                            <Setter Property="Content">
                                                <Setter.Value>
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="StoreClock"
                                                                      Width="32" Height="32"
                                                                      VerticalAlignment="Center"
                                                                      Margin="0,0,15,0"/>
                                                        <TextBlock Text="M E T T R E   À   J O U R   (F12)"
                                                       FontSize="24"
                                                       FontWeight="Bold"
                                                       VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>


                    </Grid>

                    <!-- Checkout button -->

                </StackPanel>
            </Grid>
        </materialDesign:Card>
    </Grid>
</UserControl>