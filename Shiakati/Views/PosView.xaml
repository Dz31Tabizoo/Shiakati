    <UserControl x:Class="Shiakati.Views.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             xmlns:converters="clr-namespace:Shiakati.Converters"
             d:DesignHeight="768" d:DesignWidth="1024"
             FontFamily="{StaticResource MontserratFont}"
             Background="{DynamicResource MaterialDesignPaper}">
        
    <UserControl.InputBindings>
        <KeyBinding Key="F12" Command="{Binding CheckoutCommand}" />
    </UserControl.InputBindings>

    <UserControl.Resources>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <converters:CommonEqualityConverter x:Key="CommonEqualityConverter" />
        </UserControl.Resources>        
        
      <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,15,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <materialDesign:Card Grid.Row="0" Padding="10" UniformCornerRadius="10" Margin="0,0,0,15">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="BarcodeScan" Width="30" Height="30" VerticalAlignment="Center" Foreground="{StaticResource PrimaryBrush}" Margin="10,0"/>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                             materialDesign:HintAssist.Hint="Scanner un code-barres ou chercher un produit..."
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                             Width="400" FontSize="18" VerticalAlignment="Center"/>
                </StackPanel>
            </materialDesign:Card>

            
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
                <ComboBox materialDesign:HintAssist.Hint="Catégorie"
              FontSize="13"
              MinWidth="120"
              ItemsSource="{Binding Categories}"
              SelectedItem="{Binding SelectedCategory}"
              Style="{StaticResource MaterialDesignFloatingHintComboBox}"
              Margin="0,0,10,0"/>

                <ComboBox materialDesign:HintAssist.Hint="Marque"
              FontSize="13"
              MinWidth="120"
              ItemsSource="{Binding Brands}"
              SelectedItem="{Binding SelectedBrand}"
              Style="{StaticResource MaterialDesignFloatingHintComboBox}"
              Margin="0,0,10,0"/>

                <ComboBox materialDesign:HintAssist.Hint="Couleur"
              FontSize="13"
              MinWidth="100"
              ItemsSource="{Binding FilterColors}"
              SelectedItem="{Binding SelectedColor}"
              Style="{StaticResource MaterialDesignFloatingHintComboBox}"
              Margin="0,0,10,0"/>

                <ComboBox materialDesign:HintAssist.Hint="Taille"
              FontSize="13"
              MinWidth="100"
              ItemsSource="{Binding FilterSizes}"
              SelectedItem="{Binding SelectedSize}"
              Style="{StaticResource MaterialDesignFloatingHintComboBox}"/>
            </StackPanel>

            <!-- Product grid (unchanged) -->
            <ListBox Grid.Row="2" ItemsSource="{Binding FilteredProducts}" 
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Background="Transparent" BorderThickness="0"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel IsItemsHost="True" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
            CommandParameter="{Binding}"
            Style="{StaticResource MaterialDesignFlatButton}" 
            Padding="0" Margin="5" Height="140" Width="165">
                            <materialDesign:Card UniformCornerRadius="10" Background="White" 
                             Width="165" Height="140"
                             materialDesign:ElevationAssist.Elevation="Dp1">
                                <Grid Margin="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Brand + optional SKU (subtle) -->
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="{Binding BrandName}" 
                               Foreground="#757575" 
                               FontSize="11" 
                               FontWeight="Medium" 
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="100"/>
                                        <TextBlock Text="{Binding Sku}" 
                               Foreground="#BDBDBD" 
                               FontSize="10" 
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               MaxWidth="80"
                               TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <!-- Product name -->
                                    <TextBlock Grid.Row="1" 
                                               Text="{Binding ProductName}" 
                                               FontSize="14" 
                                               FontWeight="SemiBold" 
                                               TextWrapping="Wrap" 
                                               TextTrimming="CharacterEllipsis" 
                                               VerticalAlignment="Top"
                                               MaxHeight="45"
                                               LineHeight="16"
                                               Foreground="#212121"/>


                                    <Border Grid.Row="2"
                                            Background="{StaticResource PrimaryBrush}" 
                                            CornerRadius="10" 
                                            Padding="6,3" 
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Color}" 
                                                   FontSize="13" 
                                                   FontWeight="Bold" 
                                                   Foreground="WhiteSmoke"                                                   
                                                   Width="Auto"
                                                   TextAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Border>

                                    <!-- Size chip + price -->
                                    

                                        <Border Grid.Row="3"
                                                Background="{StaticResource BgBrush}" 
                                                CornerRadius="10" 
                                                Padding="6,3" 
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FullSize}" 
                                                       FontSize="13" 
                                                       FontWeight="Bold" 
                                                       Foreground="{StaticResource PrimaryBrush}"
                                                       MaxWidth="60"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Border>

                                            <TextBlock Grid.Row="4" 
                                                        Text="{Binding SalePrice, StringFormat={}{0:N2} DA}" 
                                                        FontSize="14" 
                                                        FontWeight="Bold" 
                                                        Foreground="{StaticResource SecondaryBrush}" 
                                                        HorizontalAlignment="Center" 
                                                        VerticalAlignment="Center"
                                                        MaxWidth="110"
                                                        TextTrimming="CharacterEllipsis"/>
                                    
                                </Grid>
                            </materialDesign:Card>
                        </Button>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- Cart & checkout (unchanged) -->
        <materialDesign:Card Grid.Column="1" UniformCornerRadius="15" Width="Auto" MinWidth="400" Background="White">
            <Grid Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <materialDesign:Card Grid.Row="0" Background="#FFF3E0" Foreground="#E65100" Padding="10" Margin="0,0,0,10"
                                     Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AlertCircleOutline" Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding EditTicketNumber, StringFormat='MODIFICATION DU TICKET : {0}'}" 
                                       FontWeight="Bold" VerticalAlignment="Center" FontSize="16"/>
                        </StackPanel>
                        <Button Content="ANNULER" 
                                Command="{Binding CancelEditCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}" 
                                Foreground="#E65100" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </materialDesign:Card>

                <TextBlock Grid.Row="1" Text="Ticket Actuel" FontSize="20" FontWeight="Bold" 
                           Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,15"/>

                <DataGrid Grid.Row="2" ItemsSource="{Binding CartItems}" AutoGenerateColumns="False" 
                          CanUserAddRows="False" Background="Transparent" BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          GridLinesVisibility="None"
                          HorizontalAlignment="Stretch" 
                          SelectionMode="Single">

                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                            <Setter Property="FontWeight" Value="Bold" />
                            <Setter Property="FontSize" Value="14"/>
                            <Setter Property="Padding" Value="10,0,0,10"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#DDDDDD"/>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Article" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" 
                                               FontSize="15" TextWrapping="Wrap" Margin="0,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Quantité" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Style="{StaticResource MaterialDesignIconButton}" 
                                                Width="32" Height="32" Padding="5"
                                                Command="{Binding DataContext.DecrementQtyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Margin ="0,0,5,0">
                                            <materialDesign:PackIcon Kind="MinusCircle"/>
                                        </Button>
                                        <TextBlock Text="{Binding Quantity}" VerticalAlignment="Center" Margin="5,0" FontWeight="Bold"/>
                                        <Button Style="{StaticResource MaterialDesignIconButton}" 
                                                Width="32" Height="32" Padding="0"
                                                Command="{Binding DataContext.IncrementQtyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Margin ="5,0,0,0">
                                            <materialDesign:PackIcon Kind="PlusCircle"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Remises" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0">
                                        <ToggleButton Style="{StaticResource MaterialDesignActionToggleButton}"
                                                      IsChecked="{Binding IsDiscountPinned}"
                                                      Command="{Binding ToggleDiscountCommand}"
                                                      Width="40" Height="40"
                                                      Background="Transparent" BorderThickness="1"
                                                      ToolTip="Remise fixe du produit">
                                            <ToggleButton.Content>
                                                <materialDesign:PackIcon Kind="TagOutline" Width="20" Height="20" Foreground="Gray"/>
                                            </ToggleButton.Content>
                                            <materialDesign:ToggleButtonAssist.OnContent>
                                                <materialDesign:PackIcon Kind="Tag" Width="20" Height="20" Foreground="#FF9800"/>
                                            </materialDesign:ToggleButtonAssist.OnContent>
                                        </ToggleButton>
                                        <TextBox Text="{Binding ManualDiscount, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="70" Margin="10,0,0,0" Padding="5,5,5,5"
                                                 materialDesign:HintAssist.Hint="DA"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 VerticalAlignment="Center" TextAlignment="Center"
                                                 FontSize="14" FontWeight="SemiBold" Foreground="#FF9800"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Total" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TotalPrice, StringFormat={}{0:N2}}" 
                                               VerticalAlignment="Center" FontWeight="Bold" 
                                               Foreground="{StaticResource PrimaryBrush}" Margin="10,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource MaterialDesignIconButton}" 
                                            Command="{Binding DataContext.RemoveFromCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" HorizontalAlignment="Right" Foreground="Crimson">
                                        <materialDesign:PackIcon Kind="CartRemove" Width="24" Height="24"/>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="3" Margin="0,15,0,0">
                    <Separator Margin="0,0,0,10"/>
                    <Grid Margin="0,2">
                        <TextBlock Text="Sous-total :" FontSize="16"/>
                        <TextBlock Text="{Binding CartSubTotal, StringFormat={}{0:N2} DA}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                    </Grid>
                    <Grid Margin="0,2">
                        <TextBlock Text="Remise totale :" FontSize="16" Foreground="Green"/>
                        <TextBlock Text="{Binding TotalDiscountAmount, StringFormat={}-{0:N2} DA}" HorizontalAlignment="Right" Foreground="Green"/>
                    </Grid>
                    <Grid Margin="0,10">
                        <TextBlock Text="TOTAL" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                        <TextBlock Text="{Binding CartTotal, StringFormat={}{0:N2} DA}" FontSize="32" FontWeight="Bold" 
                                   HorizontalAlignment="Right" Foreground="{StaticResource SecondaryBrush}"/>
                    </Grid>

                    <Button Command="{Binding CheckoutCommand}" Height="70" FontSize="24" FontWeight="Bold">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                <Setter Property="Content" Value="ENCAISSER (F12)"/>
                                <Setter Property="Background" Value="{StaticResource SecondaryBrush}"/>
                                <Setter Property="BorderBrush" Value="{x:Null}"/>

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                        <Setter Property="Content" Value="METTRE À JOUR (F12)"/>
                                        <Setter Property="Background" Value="#FF9800"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Button.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.3"/>
                        </Button.Effect>
                    </Button>
                </StackPanel>
            </Grid>
        </materialDesign:Card>
    </Grid>
</UserControl>