<UserControl x:Class="Shiakati.Views.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:vw="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             xmlns:converters="clr-namespace:Shiakati.Converters"
             d:DesignHeight="768" d:DesignWidth="1024"
             FontFamily="{StaticResource BodyFont}"
             Background="{DynamicResource BgAltBrush}">

    <UserControl.InputBindings>
        <KeyBinding Key="F12" Command="{Binding CheckoutCommand}" />
    </UserControl.InputBindings>

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:CommonEqualityConverter x:Key="CommonEqualityConverter" />
        <converters:CategoryToIconConverter x:Key="CategoryToIconConverter"/>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════ LEFT: Product Browser ═══════════ -->
        <Grid Grid.Column="0" Margin="0,0,15,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Search bar -->
            <materialDesign:Card Grid.Row="0" Padding="12" UniformCornerRadius="12" Margin="0,0,0,12"
                                 Background="{DynamicResource BgBrush}" Style="{DynamicResource ShiakatiLightCard}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="BarcodeScan" Width="28" Height="28"
                                             VerticalAlignment="Center"
                                             Foreground="{DynamicResource DarkLightTextNavyWhiteBrush}"
                                             Margin="0,0,10,0"/>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Scanner un code-barres ou chercher un produit..."
                             Style="{StaticResource ShiakatiTextBox}"
                             Width="400" FontSize="16"
                             VerticalAlignment="Center"/>
                </StackPanel>
            </materialDesign:Card>
            <!-- Client selector -->

            <!-- STAGE 1 – CATEGORY CARDS -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Disabled"
                  HorizontalScrollBarVisibility="Auto"
                  Visibility="{Binding IsStage1Visible, Converter={StaticResource BoolToVis}}">
                <ItemsControl ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Width="140" Height="140"
                            Margin="4" Padding="0"
                            Cursor="Hand"
                            Style="{StaticResource MaterialDesignFlatButton}">
                                <Border CornerRadius="12" Background="{DynamicResource BgBrush}"
                                BorderBrush="{DynamicResource BgAltBrush}" BorderThickness="1"
                                Width="130" Height="130">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Image Source="{Binding CategoryName, Converter={StaticResource CategoryToIconConverter}}"
                                       Width="64" Height="64" Stretch="Uniform"/>
                                        <TextBlock Text="{Binding CategoryName}" FontSize="14"
                                           FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                                           Margin="0,6,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- STAGE 2 – BRAND CHIPS (horizontal scroll) -->
            <Border Grid.Row="1" Padding="0,4"
        Visibility="{Binding IsStage2Visible, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                Content="← Retour" 
                Style="{StaticResource HelpChipButton}"
                Command="{Binding ResetCommand}" 
                Margin="0,0,8,0"
                VerticalAlignment="Center"/>

                    <ScrollViewer Grid.Column="1" 
                      HorizontalScrollBarVisibility="Auto" 
                      VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding BrandsForCategory}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding BrandName}" 
                                Command="{Binding DataContext.SelectBrandCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Style="{StaticResource HelpChipButton}"
                                Margin="0,0,8,0"
                                Height="36"
                                Padding="12,4"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
            <!-- STAGE 3 – FILTERS + PRODUCT GRID -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4"
                Visibility="{Binding IsStage3Visible, Converter={StaticResource BoolToVis}}">
                <Button Content="← Retour" Style="{StaticResource HelpChipButton}"
                Command="{Binding ResetCommand}" Margin="0,0,8,0"/>
                <ComboBox FontSize="14" 
          Width="160"
          Tag="Couleur"
          ItemsSource="{Binding AvailableColors}"
          SelectedItem="{Binding SelectedColor}"
          Margin="0,0,10,0"/>

                <ComboBox FontSize="14" 
          Width="160"
          Tag="Taille"
          ItemsSource="{Binding AvailableSizes}"
          SelectedItem="{Binding SelectedSize}"
          />
            </StackPanel>
            <!-- Product grid -->
            <ListBox Grid.Row="2"
                     ItemsSource="{Binding FilteredProductsView}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Visibility="{Binding IsStage3Visible, Converter={StaticResource BoolToVis}}"               
                     Background="Transparent" BorderThickness="0"
                     HorizontalContentAlignment="Stretch">

                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <vw:VirtualizingWrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <!-- 👇 THIS WRAPPER IS CRUCIAL -->
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Width="160" Height="108" Margin="4"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="ContainerBorder"
                                                Background="{DynamicResource BgBrush}"
                                                CornerRadius="10"
                                                BorderBrush="{DynamicResource BgAltBrush}"
                                                BorderThickness="1">
                                        

                                        <Grid Margin="8,6">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                       Text="{Binding BrandName}"
                       FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"
                       FontWeight="DemiBold"
                       MaxWidth="100"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center" Margin="2,0"/>

                                                <materialDesign:PackIcon Grid.Column="1"
                                     Kind="Barcode"
                                     Width="22" Height="22"
                                     Foreground="{DynamicResource SecondaryBrush}"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Center"
                                     ToolTip="{Binding Sku}"/>
                                            </Grid>

                                            <Grid Grid.Row="1" Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Grid Grid.Column="0">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Grid.Row="0"
                           Text="{Binding ProductName}"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           HorizontalAlignment="Left"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" Margin="0,0,0,3"/>

                                                    <TextBlock Grid.Row="1"
                           Text="{Binding SalePrice, StringFormat={}{0:N2} DA}"
                           FontSize="13" FontWeight="Bold" 
                           Foreground="{DynamicResource SecondaryBrush}"
                           Margin="2,0,0,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"/>
                                                </Grid>

                                                <Image Grid.Column="1"
                   Source="{Binding CategoryName, Converter={StaticResource CategoryToIconConverter}}"
                   Width="38" Height="40"
                   Margin="6,0,2,0"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"/>
                                            </Grid>

                                            <Grid Grid.Row="2" Margin="0,4,0,0">
                                                <Border Background="{DynamicResource BgAltBrush}" CornerRadius="6"
                    Padding="6,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock FontSize="11" Foreground="{DynamicResource DarkAccentBrush}"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="110">
                    <Run Text="{Binding Color}"/> <Run Text="{Binding FullSize, StringFormat=/ {0}}" />
                                                    </TextBlock>
                                                </Border>

                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <Ellipse Width="8" Height="8" Fill="{DynamicResource GreenLightBrush}"
                                                                VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                    <TextBlock Text="{Binding StockQuantity}"
                                                               FontSize="13" Foreground="{DynamicResource GreenLightBrush}"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ContainerBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                            <Setter TargetName="ContainerBorder" Property="BorderThickness" Value="2"/>
                                            <!-- Padding adjustment to avoid layout shift when border thickens -->
                                            <Setter TargetName="ContainerBorder" Property="Margin" Value="-1"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="ContainerBorder" Property="Background" Value="{DynamicResource BgAltBrush}"/>
                                            <Setter TargetName="ContainerBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                            <Setter TargetName="ContainerBorder" Property="BorderThickness" Value="2"/>
                                            <Setter TargetName="ContainerBorder" Property="Margin" Value="-1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>

                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- ═══════════ RIGHT: Cart & Checkout ═══════════ -->
        <materialDesign:Card Grid.Column="1" UniformCornerRadius="16"
                             
                     Width="Auto" MinWidth="400" 
                     Style="{StaticResource ShiakatiLightCard}">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Edit banner -->
                    <RowDefinition Height="Auto"/>
                    <!-- Title -->
                    <RowDefinition Height="*"/>
                    <!-- DataGrid -->
                    <RowDefinition Height="Auto"/>
                    <!-- Totals + buttons -->
                </Grid.RowDefinitions>

                <!-- Edit banner -->
                <materialDesign:Card Grid.Row="0" Background="{DynamicResource BgAltBrush}" 
                             Foreground="{DynamicResource DangerBrush}"
                             Padding="10" Margin="0,0,0,10"
                             Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}"
                             UniformCornerRadius="8">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AlertCircleOutline"
                                             Width="24" Height="24"
                                             Margin="0,0,10,0"
                                             VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding EditTicketNumber, StringFormat='MODIFICATION DU TICKET : {0}'}"
                               FontWeight="Bold" VerticalAlignment="Center" FontSize="16"/>
                        </StackPanel>
                        <Button Content="ANNULER"
                        Command="{Binding CancelEditCommand}"
                        Style="{StaticResource SecondaryButton}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </materialDesign:Card>

                <!-- Title -->
                <Grid Grid.Row="1" Margin="0,0,0,8" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" Text="Ticket Actuel"
                               FontSize="20" FontWeight="Bold" Padding="0,10"
                               Foreground="{DynamicResource DarkLightTextNavyWhiteBrush}" />

                    <Border HorizontalAlignment="Right" Grid.Column="1" Grid.Row="0"
                                CornerRadius="8"
                                BorderBrush="{DynamicResource SecondaryBrush}"
                                BorderThickness="1.5"
                                Background="{DynamicResource BgBrush}"
                                Padding="8,6" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AccountCircle"
                                             Width="20" Height="20"
                                             VerticalAlignment="Center"
                                             Foreground="{DynamicResource SecondaryBrush}"
                                             Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding ClientDisplay}"
                               VerticalAlignment="Center"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,8,0"/>
                            <Button Content="Clients Shiakati"
                            Command="{Binding OpenClientSelectionDialogCommand}"
                            Style="{DynamicResource SecondaryButton}"
                            MinHeight="32" FontSize="13"
                            Padding="8,4"
                            VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                </Grid>
                

                <!-- Cart DataGrid -->
                <DataGrid Grid.Row="2" ItemsSource="{Binding CartItems}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False" Background="Transparent"
                  BorderThickness="0"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  GridLinesVisibility="None"
                  HorizontalAlignment="Stretch"
                  SelectionMode="Single"
                  Style="{StaticResource ShiakatiDataGrid}">

                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader"
                       BasedOn="{StaticResource ShiakatiDataGridColumnHeader}"/>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <!-- Article -->
                        <DataGridTemplateColumn Header="Article" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"
                                       FontSize="15" TextWrapping="Wrap" Margin="0,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Quantité -->
                        <DataGridTemplateColumn Header="Quantité" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                        Width="32" Height="32" Padding="5"
                                        Command="{Binding DataContext.DecrementQtyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" Margin ="0,0,5,0">
                                            <materialDesign:PackIcon Kind="MinusCircle"/>
                                        </Button>
                                        <TextBlock Text="{Binding Quantity}" VerticalAlignment="Center"
                                           Margin="5,0" FontWeight="Bold"/>
                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                        Width="32" Height="32" Padding="0"
                                        Command="{Binding DataContext.IncrementQtyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" Margin ="5,0,0,0">
                                            <materialDesign:PackIcon Kind="PlusCircle"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Remises -->
                        <DataGridTemplateColumn Header="Remises" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0">
                                        <ToggleButton Style="{StaticResource MaterialDesignActionToggleButton}"
                                              IsChecked="{Binding IsDiscountPinned}"
                                              Command="{Binding ToggleDiscountCommand}"
                                              Width="40" Height="40"
                                              Background="Transparent" BorderThickness="1"
                                              ToolTip="Remise fixe du produit">
                                            <ToggleButton.Content>
                                                <materialDesign:PackIcon Kind="TagOutline" Width="20" Height="20" Foreground="Gray"/>
                                            </ToggleButton.Content>
                                            <materialDesign:ToggleButtonAssist.OnContent>
                                                <materialDesign:PackIcon Kind="Tag" Width="20" Height="20" Foreground="#FF9800"/>
                                            </materialDesign:ToggleButtonAssist.OnContent>
                                        </ToggleButton>
                                        <TextBox Text="{Binding ManualDiscount, UpdateSourceTrigger=PropertyChanged}"
                                         Width="70" Margin="10,0,0,0" Padding="5,5,5,5"
                                         materialDesign:HintAssist.Hint="DA"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         VerticalAlignment="Center" TextAlignment="Center"
                                         FontSize="14" FontWeight="SemiBold" Foreground="#FF9800"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Total -->
                        <DataGridTemplateColumn Header="Total" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TotalPrice, StringFormat={}{0:N2}}"
                                       VerticalAlignment="Center" FontWeight="Bold"
                                       Foreground="{DynamicResource DarkLightTextNavyWhiteBrush}" Margin="10,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Remove -->
                        <DataGridTemplateColumn Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource MaterialDesignIconButton}"
                                    Command="{Binding DataContext.RemoveFromCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" HorizontalAlignment="Right" Foreground="{DynamicResource DangerBrush}">
                                        <materialDesign:PackIcon Kind="CartRemove" Width="24" Height="24"/>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Totals & Checkout area -->
                <StackPanel Grid.Row="3" Margin="0,5,0,0">

                    <!-- Client chip – always right‑aligned -->

                    <Separator Margin="0,0,0,3"/>

                    <!-- Sub‑total -->
                    <Grid Margin="0,2">
                        <TextBlock Text="Sous-total :" FontSize="16"/>
                        <TextBlock Text="{Binding CartSubTotal, StringFormat={}{0:N2} DA}"
                           HorizontalAlignment="Right" FontWeight="SemiBold"/>
                    </Grid>

                    <!-- Discount -->
                    <Grid Margin="0,2">
                        <TextBlock Text="Remise totale :" FontSize="16" Foreground="Green"/>
                        <TextBlock Text="{Binding TotalDiscountAmount, StringFormat={}-{0:N2} DA}"
                           HorizontalAlignment="Right" Foreground="Green"/>
                    </Grid>

                    <!-- Total -->
                    <Grid Height="Auto" Margin="0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="TOTAL" FontSize="24" FontWeight="Bold"
                           Foreground="{DynamicResource DarkLightTextNavyWhiteBrush}" Margin="0,0,15,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding CartTotal, StringFormat={}{0:N2} DA}"
                           FontSize="32" FontWeight="Bold"
                           HorizontalAlignment="Right"
                           Foreground="{StaticResource SecondaryBrush}"/>
                    </Grid>

                    <!-- Credit / Reservation buttons -->
                    <Grid Margin="5,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Button Grid.Column="2" Grid.Row="1"
                        Command="{Binding OpenReservationDialogCommand}"
                        Style="{StaticResource PrimaryGoldenButton}"
                        FontSize="18" FontWeight="Bold"
                        Margin="5,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="StoreClock"
                                                  Width="32" Height="32"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,10,0"/>
                                <TextBlock Text="RÉSERVATION" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Grid.Row="2" Command="{Binding OpenCreditSaleDialogCommand}"
                                Style="{StaticResource PrimaryGoldenButton}"
                                FontSize="18" FontWeight="Bold"
                                Margin="5,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CreditCardClock"
                                                  Width="32" Height="32"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,10,0"/>
                                <TextBlock  Text="CRÉDIT" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="0" Grid.Row="1"
                            Command="{Binding CheckoutCommand}" Height="60" MinWidth="340" Margin="5,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Content">
                                        <Setter.Value>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="CashRegister"
                                                              Width="32" Height="32"
                                                              VerticalAlignment="Center"
                                                              Margin="0,0,15,0"/>
                                                <TextBlock Text="E N C A I S S E R   (F12)"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                            <Setter Property="Background" Value="#FF9800"/>
                                            <Setter Property="Foreground" Value="#1E1E1E"/>
                                            <Setter Property="Content">
                                                <Setter.Value>
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="StoreClock"
                                                                      Width="32" Height="32"
                                                                      VerticalAlignment="Center"
                                                                      Margin="0,0,15,0"/>
                                                        <TextBlock Text="M E T T R E   À   J O U R   (F12)"
                                                       FontSize="24"
                                                       FontWeight="Bold"
                                                       VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>


                    </Grid>

                    <!-- Checkout button -->

                </StackPanel>
            </Grid>
        </materialDesign:Card>
    </Grid>

</UserControl>