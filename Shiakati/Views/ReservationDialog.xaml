<Window x:Class="Shiakati.Views.ReservationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Réservation" Width="500" Height="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None"
        Style="{StaticResource ShiakatiDialogStyle}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <Grid Grid.Row="0" 
                  Height="35"
                  Margin="0,0,0,15"
                  Background="{DynamicResource SecondaryBrush}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Window title (left aligned) -->
            <TextBlock Grid.Column="0"
                           Text="Réservation"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource TextOnPrimaryBrush}"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"/>

            <!-- Close button (right aligned) -->
            <Button Grid.Column="1"
                        x:Name="btnClose"
                        Click="btnClose_Click"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Width="48" Height="48"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource TextOnPrimaryBrush}">
                <materialDesign:PackIcon Kind="Close" 
                                 Width="24" Height="24"
                                 VerticalAlignment="Center"
                                 HorizontalAlignment="Center"/>
            </Button>
        </Grid>


        <!-- Total -->
        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <TextBlock Text="Total de la réservation" FontWeight="Medium" FontSize="14"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBlock Text="{Binding Total, StringFormat={}{0:N2} DA}" FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource PrimaryBrush}"/>
        </StackPanel>

        <!-- Deposit -->
        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="Montant déposé" FontWeight="Medium" FontSize="14"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <TextBox Text="{Binding DepositAmount, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}"
                     Style="{StaticResource ShiakatiTextBox}" FontSize="16"
                     PreviewTextInput="OnlyDigits_PreviewTextInput"/>
        </StackPanel>

        <!-- Remaining (read-only) -->
        <StackPanel Grid.Row="3" Margin="0,0,0,10">
            <TextBlock Text="Reste à payer (crédit)" FontWeight="Medium" FontSize="14"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <TextBlock Text="{Binding Remaining, StringFormat={}{0:N2} DA}" FontSize="18" FontWeight="SemiBold"
                       Foreground="{StaticResource DangerBrush}"/>
        </StackPanel>

        <!-- Expiration date -->
        <StackPanel Grid.Row="4" Margin="0,0,0,20">
            <TextBlock Text="Date d'expiration" FontWeight="Medium" FontSize="14"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <DatePicker SelectedDate="{Binding ExpirationDate}" Width="200" FontSize="14"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="6" Orientation="Horizontal"  HorizontalAlignment="Right">
            <Button Content="Annuler" IsCancel="True" Click="Cancel_Click"
                    Style="{DynamicResource SecondaryButton}" MinHeight="44" FontSize="14" Margin="0,0,10,0"/>
            <Button Content="Confirmer" IsDefault="True" Click="Confirm_Click"
                    Style="{StaticResource PrimaryButton}" MinHeight="44" FontSize="14"/>
        </StackPanel>
    </Grid>
</Window>