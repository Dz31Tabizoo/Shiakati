<UserControl x:Class="Shiakati.Views.ClientDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="768" d:DesignWidth="1024"
             FontFamily="{StaticResource BodyFont}"
             Background="{StaticResource BgBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="ReservationsParentGrid" TargetType="DataGrid" BasedOn="{StaticResource ShiakatiDataGrid}">
            <Setter Property="RowHeight" Value="NaN"/>
        </Style>

        <Style x:Key="ReservationsParentRow" TargetType="DataGridRow" BasedOn="{StaticResource ShiakatiDataGridRow}">
            <Setter Property="Height" Value="NaN"/>
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnDataGridRowPreviewMouseLeftButtonDown"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Client info -->
        <materialDesign:Card Grid.Row="0" Style="{StaticResource ShiakatiCard}" Padding="16" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Large user icon -->
                <materialDesign:PackIcon Grid.Column="0"
                                 Kind="AccountCircle"
                                 Width="48" Height="48"
                                 VerticalAlignment="Center"
                                 Foreground="{StaticResource PrimaryBrush}"
                                 Margin="0,0,16,0"/>

                <!-- Name and phone -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Client.FullName}"
                       FontSize="24" FontWeight="Bold"
                       FontFamily="{StaticResource HeadingFont}"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <materialDesign:PackIcon Kind="Phone"
                                         Width="18" Height="18"
                                         VerticalAlignment="Center"
                                         Foreground="{StaticResource TextSecondaryBrush}"
                                         Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding Client.PhoneNumber}"
                           FontSize="16"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- Edit button with icon -->
                <Button Grid.Column="2"
                Command="{Binding EditClientCommand}"
                Style="{StaticResource SecondaryButton}"
                MinHeight="44" FontSize="14"
                VerticalAlignment="Center"
                Padding="12,6">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Edit"
                                         Width="18" Height="18"
                                         VerticalAlignment="Center"
                                         Margin="0,0,6,0"/>
                        <TextBlock Text="Modifier" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </materialDesign:Card>

        <!-- Tabs -->
        <TabControl Grid.Row="1" Margin="0,10,0,0">
            <TabItem Header="Crédits">
                <Grid Margin="0,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Montant (digits only) -->
                        <TextBox Grid.Column="0"
             Text="{Binding CreditAmount}"
             materialDesign:HintAssist.Hint="Montant"
             Style="{StaticResource ShiakatiTextBox}"
             Width="130" Margin="0,0,10,0"
             PreviewTextInput="OnlyDigits_PreviewTextInput"/>

                        <!-- Notes -->
                        <TextBox Grid.Column="1"
             Text="{Binding CreditNotes}"
             materialDesign:HintAssist.Hint="Notes"
             Style="{StaticResource ShiakatiTextBox}"
             Width="200" Margin="0,0,10,0"/>

                        <!-- Expiration date -->
                        <DatePicker Grid.Column="2"
                SelectedDate="{Binding CreditExpiresAt}"
                materialDesign:HintAssist.Hint="Expire le"
                Width="140" Margin="0,0,10,0"/>

                        <!-- Spacer to push button right -->
                        <Grid Grid.Column="3" />

                        <!-- Button on the right -->
                        <Button Grid.Column="4"                                
                                Command="{Binding GrantCreditCommand}"
                                Style="{StaticResource PrimaryButton}"
                                MinHeight="48" FontSize="14">

                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CashMinus"
                                                         Width="18" Height="18"
                                                         VerticalAlignment="Center"
                                                         Margin="5,0,8,0"/>
                                <TextBlock Text="Ajouter Crédit" VerticalAlignment="Center"/>
                            </StackPanel>

                        </Button>
                    </Grid>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Credits}" AutoGenerateColumns="False"
                              MinHeight="150" MaxHeight="300"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              BorderThickness="0" GridLinesVisibility="Horizontal"
                              Style="{StaticResource ShiakatiDataGrid}"
                              ColumnHeaderStyle="{StaticResource ShiakatiDataGridColumnHeader}"
                              CellStyle="{StaticResource ShiakatiDataGridCell}"
                              RowStyle="{StaticResource ShiakatiDataGridRow}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Montant" Binding="{Binding Amount, StringFormat={}{0:N2} DA}" Width="Auto" FontSize="14"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding GrantedAt, StringFormat=dd/MM/yyyy}" Width="Auto" FontSize="14"/>
                            <DataGridTextColumn Header="Expire le" Binding="{Binding ExpiresAt, StringFormat=dd/MM/yyyy}" Width="Auto" FontSize="14"/>
                            <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*" FontSize="14"/>
                            <DataGridTemplateColumn Header="État" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,4" CornerRadius="6">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRedeemed}" Value="True">
                                                            <Setter Property="Background" Value="#E8F5E9"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsRedeemed}" Value="False">
                                                            <Setter Property="Background" Value="#FFF3E0"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontWeight="SemiBold" FontSize="13">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRedeemed}" Value="True">
                                                                <Setter Property="Text" Value="Réglé"/>
                                                                <Setter Property="Foreground" Value="Green"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsRedeemed}" Value="False">
                                                                <Setter Property="Text" Value="En Cours"/>
                                                                <Setter Property="Foreground" Value="#E65100"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="2" Margin="0,8,0,0" FontWeight="SemiBold" FontSize="14"
                               Foreground="{StaticResource SecondaryBrush}">
                        <Run Text="Crédits disponibles : "/>
                        <Run Text="{Binding TotalCreditsAvailable, StringFormat={}{0:N2} DA}"/>
                    </TextBlock>
                </Grid>
            </TabItem>

            <TabItem Header="Versements">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Montant (chiffres uniquement) -->
                        <TextBox Grid.Column="0"
             Text="{Binding VersementAmount}"
             materialDesign:HintAssist.Hint="Montant"
             Style="{StaticResource ShiakatiTextBox}"
             Width="130" Margin="0,0,10,0"
             PreviewTextInput="OnlyDigits_PreviewTextInput"/>

                        <!-- Notes -->
                        <TextBox Grid.Column="1"
             Text="{Binding VersementNotes}"
             materialDesign:HintAssist.Hint="Notes"
             Style="{StaticResource ShiakatiTextBox}"
             Width="200" Margin="0,0,10,0"/>

                        <!-- Espaceur qui pousse le bouton à droite -->
                        <Grid Grid.Column="2" />

                        <!-- Bouton Ajouter avec icône + -->
                        <Button Grid.Column="3"
            Command="{Binding AddVersementCommand}"
            Style="{StaticResource PrimaryButton}"
            MinHeight="48" FontSize="14">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CashPlus"
                                     Width="18" Height="18"
                                     VerticalAlignment="Center"
                                     Margin="5,0,8,0"/>
                                <TextBlock Text="Ajouter Versement" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Versements}" AutoGenerateColumns="False"
                              IsReadOnly="True"
                              MinHeight="150" MaxHeight="300"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              BorderThickness="0" GridLinesVisibility="Horizontal"
                              Style="{StaticResource ShiakatiDataGrid}"
                              ColumnHeaderStyle="{StaticResource ShiakatiDataGridColumnHeader}"
                              CellStyle="{StaticResource ShiakatiDataGridCell}"
                              RowStyle="{StaticResource ShiakatiDataGridRow}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Montant" Binding="{Binding Amount, StringFormat={}{0:N2} DA}" Width="Auto" FontSize="14"/>
                            <DataGridTemplateColumn Header="Date" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding PaymentDate, StringFormat=dd/MM/yyyy}" FontSize="14"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*" FontSize="14"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="2" Margin="0,8,0,0" FontWeight="SemiBold" FontSize="14"
                               Foreground="{StaticResource AccentBrush}">
                        <Run Text="Total versements : "/>
                        <Run Text="{Binding TotalPayments, StringFormat={}{0:N2} DA}"/>
                    </TextBlock>
                </Grid>
            </TabItem>

            <TabItem Header="Achats">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid Grid.Row="0"  ItemsSource="{Binding Sales}" AutoGenerateColumns="False"
                            Style="{StaticResource ReservationsParentGrid}"
                            RowDetailsVisibilityMode="VisibleWhenSelected"
                            ColumnHeaderStyle="{StaticResource ShiakatiDataGridColumnHeader}"
                            CellStyle="{StaticResource ShiakatiDataGridCell}"
                            RowStyle="{StaticResource ReservationsParentRow}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Ticket" Binding="{Binding TicketNumber}" Width="Auto" FontSize="14"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding SaleDate, StringFormat=dd/MM/yyyy}" Width="Auto" FontSize="14"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding TotalAmount, StringFormat={}{0:N2} DA}" Width="Auto" FontSize="14"/>
                        </DataGrid.Columns>

                        <!-- Expandable items -->
                        <DataGrid.RowDetailsTemplate>
                            <DataTemplate>
                                <Border Padding="12" Background="{StaticResource BgAltBrush}"
                                    MinHeight="80" MaxHeight="250">

                                    <DataGrid ItemsSource="{Binding Items}"
                                  AutoGenerateColumns="False"
                                  Style="{StaticResource ShiakatiSubDataGrid}"
                                  ColumnHeaderStyle="{StaticResource ShiakatiSubDataGridColumnHeader}"
                                  RowStyle="{StaticResource ShiakatiSubDataGridRow}"
                                  CellStyle="{StaticResource ShiakatiSubDataGridCell}"
                                  MaxHeight="250">


                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="SKU" Binding="{Binding SKU}" Width="Auto" FontSize="13"/>
                                            <DataGridTextColumn Header="Produit" Binding="{Binding ProductName}" Width="Auto" FontSize="13"/>
                                            <DataGridTextColumn Header="Qté" Binding="{Binding Quantity}" Width="Auto" FontSize="13"/>
                                            <DataGridTextColumn Header="Prix unit." Binding="{Binding UnitPrice, StringFormat={}{0:N2} DA}" Width="Auto" FontSize="13"/>
                                            <DataGridTextColumn Header="Ligne" Binding="{Binding TotalLine, StringFormat={}{0:N2} DA}" Width="Auto" FontSize="13"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                            </DataTemplate>
                        </DataGrid.RowDetailsTemplate>
                    </DataGrid>
                    <TextBlock Grid.Row="1"  Margin="0,8,0,0" FontWeight="SemiBold" FontSize="14"
           Foreground="{StaticResource PrimaryBrush}">
    <Run Text="Total des achats : "/>
    <Run Text="{Binding TotalPurchases, StringFormat={}{0:N2} DA}"/>
                    </TextBlock>
                </Grid>
            </TabItem>
            
        </TabControl>
    </Grid>
</UserControl>