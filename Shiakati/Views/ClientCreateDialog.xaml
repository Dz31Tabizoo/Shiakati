<Window x:Class="Shiakati.Views.ClientCreateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Nouveau client" Width="500" Height="400"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FontFamily="{StaticResource BodyFont}"
        Style="{StaticResource ShiakatiDialogStyle}">

    <Border BorderThickness="1" BorderBrush="{DynamicResource DarkLightTextNavyWhiteBrush}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

            <Grid Grid.Row="0" 
                  Height="40"
                  Margin="0,0,0,15"
                  Background="{DynamicResource SecondaryBrush}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Window title (left aligned) -->
                <TextBlock Grid.Column="0"
                           Text="Nouveau client"
                           FontSize="18" FontWeight="Bold"
                           Foreground="{StaticResource TextOnPrimaryBrush}"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"/>

                <!-- Close button (right aligned) -->
                <Button Grid.Column="1"
                        x:Name="btnClose"
                        Click="btnClose_Click"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Width="48" Height="48"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource TextOnPrimaryBrush}">
                    <materialDesign:PackIcon Kind="Close" 
                                 Width="24" Height="24"
                                 VerticalAlignment="Center"
                                 HorizontalAlignment="Center"/>
                </Button>
            </Grid>


            <TextBox Grid.Row="1" Text="{Binding FullName}"
                 materialDesign:HintAssist.Hint="Nom complet"
                 Style="{StaticResource ShiakatiTextBox}" Margin="0,0,0,10"/>
        <TextBox Grid.Row="2" Text="{Binding PhoneNumber}"
                 materialDesign:HintAssist.Hint="Numéro de téléphone"
                 Style="{StaticResource ShiakatiTextBox}" Margin="0,0,0,10"/>
        <TextBox Grid.Row="3" Text="{Binding Address}"
                 materialDesign:HintAssist.Hint="Adresse (optionnelle)"
                 Style="{StaticResource ShiakatiTextBox}" Margin="0,0,0,10"/>
        <TextBox Grid.Row="4" Text="{Binding Email}"
                 materialDesign:HintAssist.Hint="Email (optionnel)"
                 Style="{StaticResource ShiakatiTextBox}" Margin="0,0,0,40"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" 
                    VerticalAlignment="Bottom" 
                    HorizontalAlignment="Right">
            <Button Content="Annuler" Click="Cancel_Click"
                    Style="{StaticResource SecondaryButton}"
                    MinHeight="44" FontSize="14" Margin="0,0,10,0"/>
            <Button Content="Enregistrer" Click="Ok_Click"
                    Style="{StaticResource PrimaryButton}"
                    MinHeight="44" FontSize="14"/>
        </StackPanel>
    </Grid>
    </Border>
</Window>