<Window x:Class="Shiakati.Views.CreditSaleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Vente à crédit" Width="429" Height="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Style="{StaticResource ShiakatiDialogStyle}"
        >
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" 
                  Height="48"
                  Margin="0,0,0,15"
                  Background="{DynamicResource SecondaryBrush}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Window title (left aligned) -->
            <TextBlock Grid.Column="0"
                           Text="Vente à crédit"
                           FontSize="18" FontWeight="Bold"
                           Foreground="{StaticResource TextOnPrimaryBrush}"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"/>

            <!-- Close button (right aligned) -->
            <Button Grid.Column="1"
                        x:Name="btnClose"
                        Click="btnClose_Click"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Width="48" Height="48"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource TextOnPrimaryBrush}">
                <materialDesign:PackIcon Kind="Close" 
                                 Width="24" Height="24"
                                 VerticalAlignment="Center"
                                 HorizontalAlignment="Center"/>
            </Button>
        </Grid>


        <!-- Total (read-only) -->
        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="Total de la vente" FontWeight="Medium"  FontSize="14"/>
            <TextBox IsReadOnly="True" Text="{Binding Total, StringFormat={}{0:N2} DA}"
                     Style="{StaticResource ShiakatiTextBox}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Paid amount (editable) -->
        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="Montant payé" FontWeight="Medium" FontSize="14"/>
            <TextBox Text="{Binding PaidAmount, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}"
                     Style="{StaticResource ShiakatiTextBox}" Margin="0,4,0,0"
                     PreviewTextInput="OnlyDigits_PreviewTextInput"/>
        </StackPanel>

        <!-- Rest (calculated) -->
        <StackPanel Grid.Row="3" Margin="0,0,0,10">
            <TextBlock Text="Reste à payer (crédit)" FontWeight="Medium" FontSize="14"/>
            <TextBox IsReadOnly="True" Text="{Binding Rest, StringFormat={}{0:N2} DA}"
                     Style="{StaticResource ShiakatiTextBox}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Expiration date -->
        <StackPanel Grid.Row="4" Margin="0,0,0,15">
            <TextBlock Text="Date d'expiration (optionnelle)" FontWeight="Medium" FontSize="14"/>
            <DatePicker  SelectedDate="{Binding ExpiresAt}" Margin="0,15,0,0" Width="200"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Annuler" IsCancel="True" Click="Cancel_Click"
                    Style="{StaticResource SecondaryButton}" MinHeight="44" FontSize="14" Margin="0,0,10,0"/>
            <Button Content="Valider" IsDefault="True" Click="Ok_Click"
                    Style="{StaticResource PrimaryButton}" MinHeight="44" FontSize="14"/>
        </StackPanel>
    </Grid>
</Window>