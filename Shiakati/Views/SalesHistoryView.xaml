<UserControl x:Class="Shiakati.Views.SalesHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:Shiakati.Converters"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="768" d:DesignWidth="1024"
             FontFamily="{StaticResource MontserratFont}"
             Background="{DynamicResource MaterialDesignPaper}"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:IntToVisibilityConverter x:Key="IntToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Filter card -->
            <RowDefinition Height="Auto"/>
            <!-- Progress bar -->
            <RowDefinition Height="*"/>
            <!-- History grid -->
            <RowDefinition Height="Auto"/>
            <!-- Bonus button + grid -->
        </Grid.RowDefinitions>
        
        <materialDesign:Card Grid.Row="0" Margin="0,0,0,16" Padding="16" UniformCornerRadius="8">
            <StackPanel>
                <!-- Quick period chips -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="Aujourd'hui" Command="{Binding QuickSetPeriodCommand}" CommandParameter="today"
                    Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,5,0"/>
                    <Button Content="Hier" Command="{Binding QuickSetPeriodCommand}" CommandParameter="yesterday"
                    Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,5,0"/>
                    <Button Content="Semaine passée" Command="{Binding QuickSetPeriodCommand}" CommandParameter="lastweek"
                    Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,5,0"/>
                    <Button Content="Mois passé" Command="{Binding QuickSetPeriodCommand}" CommandParameter="lastmonth"
                    Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,5,0"/>
                    <Button Content="Année" Command="{Binding QuickSetPeriodCommand}" CommandParameter="year"
                    Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,5,0"/>
                    <Button Content="Tout l'historique" Command="{Binding QuickSetPeriodCommand}" CommandParameter="all"
                    Style="{StaticResource MaterialDesignFlatButton}"/>
                </StackPanel>

                <!-- Original filter grid (search + datepickers + actions) -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" 
                     Text="{Binding SearchTicketNumber, UpdateSourceTrigger=PropertyChanged}"
                     materialDesign:HintAssist.Hint="Scanner QR Code ou N° Ticket"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding LoadSalesCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>

                    <DatePicker Grid.Column="1" 
                        SelectedDate="{Binding StartDate}"
                        materialDesign:HintAssist.Hint="Date de début"
                        Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                        Margin="0,0,16,0" VerticalAlignment="Center"/>

                    <DatePicker Grid.Column="2" 
                        SelectedDate="{Binding EndDate}"
                        materialDesign:HintAssist.Hint="Date de fin"
                        Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                        Margin="0,0,16,0" VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding LoadSalesCommand}" 
                        Style="{StaticResource MaterialDesignFlatLightBgButton}"
                        Margin="0,0,8,0" Foreground="White" Content="Rechercher" Cursor="Hand"/>

                        <Button Command="{Binding ClearFiltersCommand}" 
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Content="Réinitialiser" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </materialDesign:Card>

        <ProgressBar Grid.Row="1" VerticalAlignment="Top" 
                     IsIndeterminate="True" 
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                     Panel.ZIndex="1"/>

        <materialDesign:Card Grid.Row="2" UniformCornerRadius="8">
            <DataGrid ItemsSource="{Binding Sales}" 
                      AutoGenerateColumns="False" 
                      CanUserAddRows="False" 
                      IsReadOnly="True"
                      HeadersVisibility="All"
                      SelectionMode="Single"
                      materialDesign:DataGridAssist.CellPadding="12"
                      materialDesign:DataGridAssist.ColumnHeaderPadding="12">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="N° Ticket" Binding="{Binding TicketNumber}" Width="*"/>
                    <DataGridTextColumn Header="Date" Binding="{Binding SaleDate, StringFormat=dd/MM/yyyy HH:mm}" Width="*"/>

                    <DataGridTemplateColumn Header="Statut" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Padding="8,4" CornerRadius="4" 
                            Visibility="{Binding IsVoided, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="ANNULÉE" Foreground="Red" FontWeight="Bold" FontSize="10"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Total" Binding="{Binding TotalAmount, StringFormat={}{0:N2} DA}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn Header="Actions" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Style="{StaticResource MaterialDesignIconButton}"
                                ToolTip="Modifier cette vente"
                                Command="{Binding DataContext.EditSaleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                                        <materialDesign:PackIcon Kind="Pencil" Foreground="{StaticResource PrimaryBrush}" />
                                    </Button>

                                    <Button Style="{StaticResource MaterialDesignIconButton}"
                                ToolTip="Annuler la vente"
                                Command="{Binding DataContext.VoidSaleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Margin="8,0,0,0">
                                        <materialDesign:PackIcon Kind="DeleteForever" Foreground="Crimson" />
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </materialDesign:Card>
        <!-- Bonus section -->
        <StackPanel Grid.Row="3" Margin="0,16,0,0">
            <Button Content="Calculer les primes journalières" 
                Command="{Binding CalculateDailyBonusesCommand}"
                    Foreground="White"
                Style="{StaticResource MaterialDesignFlatLightBgButton}"
                HorizontalAlignment="Left" Margin="0,0,0,8"/>
            <materialDesign:Card UniformCornerRadius="8" 
Visibility="{Binding DailyBonuses.Count, Converter={StaticResource IntToVisibilityConverter}}"    >
                <DataGrid ItemsSource="{Binding DailyBonuses}" 
                      AutoGenerateColumns="False" 
                      CanUserAddRows="False" IsReadOnly="True"
                      HeadersVisibility="All">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=dd/MM/yyyy}" Width="Auto"/>
                        <DataGridTextColumn Header="Total Ventes" Binding="{Binding TotalSales, StringFormat={}{0:N2} DA}" Width="Auto"/>
                        <DataGridTextColumn Header="% Prime" Binding="{Binding BonusPercentage, StringFormat={}{0:F1}%}" Width="Auto"/>
                        <DataGridTextColumn Header="Montant Prime" Binding="{Binding BonusAmount, StringFormat={}{0:N2} DA}" Width="Auto"/>
                    </DataGrid.Columns>
                </DataGrid>
            </materialDesign:Card>
        </StackPanel>
    </Grid>
</UserControl>