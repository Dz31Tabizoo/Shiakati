<UserControl x:Class="Shiakati.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:matDs="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             FontFamily="{StaticResource PoppinsFont}"
             mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <materialDesign:Card Grid.Column="0" Padding="20" UniformCornerRadius="10" VerticalAlignment="Top">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <matDs:PackIcon Kind="Printer" Width="24" Height="24" Margin="0,0,10,0" Foreground="{StaticResource PrimaryBrush}"/>
                    <TextBlock Text="Paramètres d'impression" FontSize="18" FontWeight="SemiBold"/>
                </StackPanel>

                <TextBlock Text="Choisir l'imprimante thermique :" Margin="0,0,0,5"/>
                <ComboBox ItemsSource="{Binding InstalledPrinters}" 
                          SelectedItem="{Binding SelectedPrinterName}"
                          Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                          
                          FontSize="14"
                          Height="40"/>

                <TextBlock Text="Note: Si vide, l'imprimante par défaut sera utilisée." 
                           FontSize="11" Foreground="Gray" Margin="0,5,0,20"/>

                <Button Content="Enregistrer l'imprimante" 
                        Command="{Binding SaveSettingsCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        HorizontalAlignment="Right"/>
            </StackPanel>
        </materialDesign:Card>

        <materialDesign:Card Grid.Column="2" Padding="20" UniformCornerRadius="10" VerticalAlignment="Top">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <matDs:PackIcon Kind="CategoryPlus" Width="24" Height="24" Margin="0,0,10,0" Foreground="{StaticResource PrimaryBrush}"/>
                    <TextBlock Text="Gestion des catégories" FontSize="18" FontWeight="SemiBold"/>
                </StackPanel>

                <TextBlock Text="Catégories actuelles :" Margin="0,0,0,5" FontWeight="SemiBold"/>
                <ListBox ItemsSource="{Binding GlobalCategories}" 
                         DisplayMemberPath="CategoryName"
                         Height="120" 
                         Margin="0,0,0,15"
                         BorderThickness="1" BorderBrush="#E0E0E0">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                            <Setter Property="Padding" Value="10,5"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <TextBlock Text="Ajouter une nouvelle catégorie :" Margin="0,0,0,5"/>
                <TextBox Text="{Binding NewCategoryName, UpdateSourceTrigger=PropertyChanged}" 
                         materialDesign:HintAssist.Hint="Ex: Chaussures, Cosmétiques..." 
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Margin="0,0,0,20"/>

                <Button Content="Ajouter la catégorie" 
                        Command="{Binding AddCategoryCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        HorizontalAlignment="Right"/>
            </StackPanel>
        </materialDesign:Card>
    </Grid>
</UserControl>
