<UserControl x:Class="Shiakati.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:matDs="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800">

    <Grid Margin="20">
        <StackPanel Width="400" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
                <matDs:PackIcon Kind="Printer" Width="24" Height="24" Margin="0,0,10,0"/>
                <TextBlock Text="Paramètres d'impression" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>
            </StackPanel>
            <TextBlock Text="Choisir l'imprimante thermique :" Margin="0,10,0,5"/>
            <ComboBox x:Name="PrintersComboBox" 
                      ItemsSource="{Binding InstalledPrinters}" 
                      SelectedItem="{Binding SelectedPrinterName}"
                      Height="30"/>

            <TextBlock Text="Note: Si vide, l'imprimante par défaut sera utilisée." 
                       FontSize="10" Foreground="Gray" Margin="0,5,0,0"/>

            <Button Content="Enregistrer les paramètres" 
                    Command="{Binding SaveSettingsCommand}"
                    Margin="0,30,0,0" Height="35" Background="#2196F3" Foreground="White"/>
        </StackPanel>
    </Grid>
</UserControl>
