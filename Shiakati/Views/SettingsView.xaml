<UserControl x:Class="Shiakati.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="768" d:DesignWidth="1024"
             FontFamily="{StaticResource BodyFont}"
             Background="{StaticResource BgBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Toggleable settings module card -->
        <Style x:Key="ShiakatiSettingsCard" TargetType="RadioButton">
            <Setter Property="Width" Value="140"/>
            <Setter Property="Height" Value="120"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
            <Setter Property="Background" Value="{StaticResource BgBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BgAltBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="card"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="card" Property="Background" Value="{StaticResource SurfaceBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="card" Property="Background" Value="{StaticResource BgAltBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════ LEFT : MODULE CARDS ═══════════ -->
        <StackPanel Grid.Column="0" VerticalAlignment="Top">
            <!-- Ticket Printer Card -->
            <RadioButton x:Name="rbTicket" GroupName="SettingsGroup"
                         Style="{StaticResource ShiakatiSettingsCard}"
                         IsChecked="True"
                         Margin="0,0,0,12">
                <StackPanel>
                    <materialDesign:PackIcon Kind="PrinterCheck" Width="48" Height="48"
                                             Foreground="{StaticResource PrimaryBrush}"
                                             HorizontalAlignment="Center"/>
                    <TextBlock Text="Ticket Caisse" HorizontalAlignment="Center"
                               FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0"/>
                </StackPanel>
            </RadioButton>

            <!-- Barcode Printer Card -->
            <RadioButton x:Name="rbBarcode" GroupName="SettingsGroup"
                         Style="{StaticResource ShiakatiSettingsCard}"
                         Margin="0,0,0,12">
                <StackPanel>
                    <materialDesign:PackIcon Kind="BarcodeScanner" Width="48" Height="48"
                                             Foreground="{StaticResource PrimaryBrush}"
                                             HorizontalAlignment="Center"/>
                    <TextBlock Text="Étiquettes" HorizontalAlignment="Center"
                               FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0"/>
                </StackPanel>
            </RadioButton>

            <!-- Categories Card -->
            <RadioButton x:Name="rbCategories" GroupName="SettingsGroup"
                         Style="{StaticResource ShiakatiSettingsCard}">
                <StackPanel>
                    <materialDesign:PackIcon Kind="ShapePlus" Width="48" Height="48"
                                             Foreground="{StaticResource PrimaryBrush}"
                                             HorizontalAlignment="Center"/>
                    <TextBlock Text="Catégories" HorizontalAlignment="Center"
                               FontSize="14" FontWeight="SemiBold" Margin="0,8,0,12"/>
                </StackPanel>
            </RadioButton>

            <RadioButton Margin="0,12,0,0" x:Name="UserManagement" GroupName="SettingsGroup"
             Style="{StaticResource ShiakatiSettingsCard}">
                <StackPanel>
                    <materialDesign:PackIcon Kind="UserSettings" Width="48" Height="48"
                                             Foreground="{StaticResource PrimaryBrush}"
                                             HorizontalAlignment="Center"/>
                    <TextBlock Text="Utilisateurs" HorizontalAlignment="Center"
                               FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0"/>
                </StackPanel>
            </RadioButton>
        </StackPanel>

        <!-- ═══════════ RIGHT : DETAIL PANELS ═══════════ -->
        <Grid Grid.Column="2">
            <!-- TICKET PRINTER PANEL -->
            <materialDesign:Card Visibility="{Binding IsChecked, ElementName=rbTicket, Converter={StaticResource BoolToVis}}"
                                 Style="{StaticResource ShiakatiCard}" Padding="20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <materialDesign:PackIcon Kind="PrinterCheck" Width="24" Height="24"
                                                 Foreground="{StaticResource PrimaryBrush}" Margin="0,0,10,0"/>
                        <TextBlock Text="Impression Ticket Caisse" FontSize="18" FontWeight="Bold"
                                   FontFamily="{StaticResource HeadingFont}"/>
                    </StackPanel>

                    <TextBlock Text="Choisir l'imprimante :" Margin="0,0,0,8" FontWeight="Medium" FontSize="14"/>
                    <ComboBox ItemsSource="{Binding InstalledPrinters}"
                              SelectedItem="{Binding SelectedTicketPrinterName}"
                              Style="{StaticResource ShiakatiComboBox}"
                              materialDesign:HintAssist.Hint="Sélectionner l'imprimante"
                              Margin="0,0,0,12"/>

                    <TextBlock Text="Note : Si vide, l'imprimante par défaut sera utilisée."
                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="4,0,0,20" FontStyle="Italic"/>

                    <Button 
                            Command="{Binding SaveTicketPrinterSettingsCommand}"
                            Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Right" MinHeight="48" FontSize="14">

                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSave" Width="20" Height="20"
                                VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Enregistrer" VerticalAlignment="Center"/>
                        </StackPanel>

                    </Button>
                </StackPanel>
            </materialDesign:Card>

            <!-- BARCODE PRINTER PANEL -->
            <materialDesign:Card Visibility="{Binding IsChecked, ElementName=rbBarcode, Converter={StaticResource BoolToVis}}"
                                 Style="{StaticResource ShiakatiCard}" Padding="20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <materialDesign:PackIcon Kind="BarcodeScanner" Width="24" Height="24"
                                                 Foreground="{StaticResource PrimaryBrush}" Margin="0,0,10,0"/>
                        <TextBlock Text="Impression Étiquettes" FontSize="18" FontWeight="Bold"
                                   FontFamily="{StaticResource HeadingFont}"/>
                    </StackPanel>

                    <TextBlock Text="Choisir l'imprimante :" Margin="0,0,0,8" FontWeight="Medium" FontSize="14"/>
                    <ComboBox ItemsSource="{Binding InstalledPrinters}"
                              SelectedItem="{Binding SelectedBarcodePrinterName}"
                              Style="{StaticResource ShiakatiComboBox}"
                              materialDesign:HintAssist.Hint="Sélectionner l'imprimante"
                              Margin="0,0,0,12"/>

                    <TextBlock Text="Format recommandé : 40mm x 20mm"
                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="4,0,0,20" FontStyle="Italic"/>

                    <Button 
                            Command="{Binding SaveBarcodePrinterSettingsCommand}"
                            Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Right" MinHeight="48" FontSize="14">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSave" Width="20" Height="20"
                                VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="ENREGISTRER" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </materialDesign:Card>

            <!-- CATEGORIES PANEL -->
            <materialDesign:Card Visibility="{Binding IsChecked, ElementName=rbCategories, Converter={StaticResource BoolToVis}}"
                                 Style="{StaticResource ShiakatiCard}" Padding="20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <materialDesign:PackIcon Kind="ShapePlus" Width="24" Height="24"
                                                 Foreground="{StaticResource PrimaryBrush}" Margin="0,0,10,0"/>
                        <TextBlock Text="Gestion des Catégories" FontSize="18" FontWeight="Bold"
                                   FontFamily="{StaticResource HeadingFont}"/>
                    </StackPanel>

                    <TextBlock Text="Liste des catégories :" Margin="0,0,0,8" FontWeight="Medium" FontSize="14"/>
                    <ListBox ItemsSource="{Binding GlobalCategories}"
                             DisplayMemberPath="CategoryName"
                             Height="180" Margin="0,0,0,20"
                             BorderThickness="1" BorderBrush="{StaticResource BgAltBrush}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="12,8"/>
                                <Setter Property="FontSize" Value="14"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <TextBlock Text="Nouvelle catégorie :" Margin="0,0,0,8" FontWeight="Medium" FontSize="14"/>
                    <TextBox Text="{Binding NewCategoryName, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Ex: Chaussures, Parfums..."
                             Style="{StaticResource ShiakatiTextBox}"
                             Margin="0,0,0,20"/>

                    <Button 
                            Command="{Binding AddCategoryCommand}"
                            Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Right" MinHeight="48" FontSize="14">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ShapePlus" Width="20" Height="20"
        VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="AJOUTER LA CATÉGORIE" VerticalAlignment="Center"/>
                    </StackPanel>
                    </Button>

                </StackPanel>
            </materialDesign:Card>

            <!-- User MANAGEMENT PANEL -->
            <materialDesign:Card Visibility="{Binding IsChecked, ElementName=UserManagement, Converter={StaticResource BoolToVis}}"
                 Style="{StaticResource ShiakatiCard}" Padding="20" Margin="0,0,0,16">

                <!-- Main container -->
                <StackPanel>

                    <!-- Header -->
                    <Border BorderBrush="{StaticResource BgAltBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,12" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="UserSettings" Width="24" Height="24"
                                         Foreground="{StaticResource PrimaryBrush}" Margin="0,0,10,0"/>
                            <TextBlock Text="Gestion du compte" FontSize="18" FontWeight="SemiBold"
                           FontFamily="{StaticResource HeadingFont}"
                           Foreground="{StaticResource PrimaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Buttons grid -->
                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Grid.IsSharedSizeScope="True">

                        <!-- Créer un utilisateur -->
                        <Button Command="{Binding RegisterCommand}"
                    Style="{StaticResource PrimaryGoldenButton}"
                    MinHeight="48" MinWidth="210" MaxWidth="280"
                    Margin="4,4" Padding="12,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="AccountAdd" Width="20" Height="20"
                                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Créer un utilisateur" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Modifier le nom d'utilisateur -->
                        <Button Command="{Binding ChangeUsernameCommand}"
                    Style="{StaticResource PrimaryGoldenButton}"
                    MinHeight="48" MinWidth="210" MaxWidth="280"
                    Margin="4,4" Padding="12,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="Rename" Width="20" Height="20"
                                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Changer le nom" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Modifier le mot de passe -->
                        <Button Command="{Binding ChangePasswordCommand}"
                    Style="{StaticResource PrimaryGoldenButton}"
                    MinHeight="48" MinWidth="210" MaxWidth="280"
                    Margin="4,4" Padding="12,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="PasswordWarning" Width="20" Height="20"
                                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Changer le mot de passe" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Optional: Add a fourth button here if needed -->

                    </WrapPanel>

                    <!-- Subtle hint text -->
                    <TextBlock Text="Gérez les accès et les identifiants de votre compte"
                   FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                   Margin="0,12,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>