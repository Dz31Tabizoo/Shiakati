<Window x:Class="Shiakati.Views.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:converters="clr-namespace:Shiakati.Converters"
        Title="Shiakati POS" Height="800" Width="1280"
        Background="Transparent"
        WindowStyle="None" AllowsTransparency="True"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource BodyFont}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InvertBooleanConverter x:Key="InvertBooleanConverter"/>

        <!-- ============ Gradient brush reused by all nav buttons ============ -->
        <LinearGradientBrush x:Key="NavGradientBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0" Color="#13314B"/>
            <GradientStop Offset="1" Color="#1D4A6B"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="NavGradientHoverBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0" Color="#1D4A6B"/>
            <GradientStop Offset="1" Color="#2A5B7A"/>
        </LinearGradientBrush>

        <!-- ============ NAV BUTTON STYLE (for regular Button) ============ -->
        <Style x:Key="TopNavButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="{StaticResource HeadingFont}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="8" Background="{StaticResource NavGradientBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource NavGradientHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ NAV TOGGLE BUTTON STYLE (for ToggleButton – same look) ============ -->
        <Style x:Key="TopNavToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="48"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="{StaticResource HeadingFont}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" CornerRadius="8" Background="{StaticResource NavGradientBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource NavGradientHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Navigation visibility toggle (menu icon) ============ -->
        <Style x:Key="NavToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource MaterialDesignActionToggleButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <!-- ============ ROUNDED WINDOW CORNERS ============ -->
    <Border CornerRadius="14" Background="{StaticResource BgBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Title bar -->
                <RowDefinition Height="Auto"/>
                <!-- Collapsible navigation -->
                <RowDefinition Height="*"/>
                <!-- Content -->
            </Grid.RowDefinitions>

            <!-- ═══════════ 1. TITLE BAR ═══════════ -->
            <Border x:Name="pnlControlBar" Grid.Row="0" Height="80" Background="{StaticResource BgBrush}"
                    MouseLeftButtonDown="pnlControlBar_MouseLeftButtonDown"
                    BorderBrush="{StaticResource BgAltBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="20,0" Height="Auto">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Height="Auto" >
                        <Image Source="/Resources/Photos/shiakati bg.png" 
                               Width="48" Height="48"  VerticalAlignment="Center" Stretch="Uniform"/>
                        <TextBlock Text="Shiakati شياكتي" 
                                   FontFamily="{StaticResource HeadingFont}" 
                                   FontSize="28" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}"       VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right">
                        <!-- Hide / Show navigation -->
                        <ToggleButton x:Name="NavVisibilityToggle" 
                                      Style="{StaticResource NavToggleStyle}"
                                      ToolTip="Afficher/Masquer la navigation"
                                      Margin="0,0,8,0">
                            <ToggleButton.Content>
                                <materialDesign:PackIcon Kind="Menu" Width="24" Height="24"/>
                            </ToggleButton.Content>
                            <materialDesign:ToggleButtonAssist.OnContent>
                                <materialDesign:PackIcon Kind="MenuOpen" Width="24" Height="24"/>
                            </materialDesign:ToggleButtonAssist.OnContent>
                        </ToggleButton>

                        <Button x:Name="BtnMinmize" Content="—" Click="BtnMinmize_Click" 
                                Style="{StaticResource MaterialDesignFlatButton}" 
                                Foreground="{StaticResource TextSecondaryBrush}" 
                                Width="48" Height="48"/>
                        <Button x:Name="btnMaximize" Content="☐" Click="btnMaximize_Click" 
                                Style="{StaticResource MaterialDesignFlatButton}" 
                                Foreground="{StaticResource TextSecondaryBrush}" 
                                Width="48" Height="48"/>
                        <Button x:Name="btnClose" Content="✕" Click="btnClose_Click" 
                                Style="{StaticResource MaterialDesignFlatButton}" 
                                Foreground="{StaticResource DangerBrush}" 
                                Width="48" Height="48"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══════════ 2. COLLAPSIBLE NAVIGATION BAR ═══════════ -->
            <Border Grid.Row="1" Height="80" Background="{StaticResource BgBrush}"
        BorderBrush="{StaticResource BgAltBrush}" BorderThickness="0,0,0,1"
        Visibility="{Binding ElementName=NavVisibilityToggle, Path=IsChecked, Converter={StaticResource BoolToVis}}">
                <Grid Margin="20,0">
                    <!-- Left: main navigation buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Button Style="{StaticResource TopNavButtonStyle}" Command="{Binding NavigateToPOSCommand}"
                    MinWidth="140" MinHeight="60" Margin="0,0,18,0"
                    FontSize="17">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CashRegister" Width="26" Height="26" Margin="0,0,8,0"/>
                                <TextBlock Text="Caisse" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource TopNavButtonStyle}" Command="{Binding NavigateToStockCommand}"
                    MinWidth="140" MinHeight="60" Margin="0,0,18,0"
                    FontSize="17">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Warehouse" Width="26" Height="26" Margin="0,0,8,0"/>
                                <TextBlock Text="Stock" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Historique toggle – larger, with dropdown arrow -->
                        <ToggleButton x:Name="btnHistorique" Style="{StaticResource TopNavToggleButtonStyle}"
                                      MinWidth="180" MinHeight="60" Margin="0,0,18,0"
                                      FontSize="17">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="History" Width="26" Height="26" Margin="0,0,8,0"/>
                                <TextBlock Text="Historique" VerticalAlignment="Center"/>
                                <materialDesign:PackIcon Kind="MenuDown" Width="20" Height="20" Margin="8,0,0,0"
                                 VerticalAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>
                        <Popup PlacementTarget="{Binding ElementName=btnHistorique}" 
       Placement="Bottom" 
       IsOpen="{Binding IsChecked, ElementName=btnHistorique}" 
       StaysOpen="False"
       AllowsTransparency="True">
                            <Border CornerRadius="10" Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource BgAltBrush}" BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.3"/>
                                </Border.Effect>
                                <StackPanel Margin="6">
                                    <!-- “Historique Ventes” -->
                                    <Button Command="{Binding NavigateToSalesHistoryCommand}"
                    Width="180" Height="60"
                    FontSize="17" FontFamily="{StaticResource HeadingFont}"
                    FontWeight="SemiBold" Foreground="White"
                    Style="{StaticResource TopNavButtonStyle}" Margin="2">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="ReceiptTextClock" Width="22" Height="22" Margin="0,0,8,0"/>
                                            <TextBlock Text="Historique Ventes" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <!-- “Mouvement Stock” -->
                                    <Button Command="{Binding NavigateToStockMovementsCommand}"
                    Width="180" Height="60"
                    FontSize="17" FontFamily="{StaticResource HeadingFont}"
                    FontWeight="SemiBold" Foreground="White"
                    Style="{StaticResource TopNavButtonStyle}" Margin="2">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="DatabaseClock" Width="22" Height="22" Margin="0,0,8,0"/>
                                            <TextBlock Text="Mouvement Stock" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>

                        <Button Style="{StaticResource TopNavButtonStyle}" Command="{Binding NavigateToClientsCommand}"
                    MinWidth="140" MinHeight="60" Margin="0,0,18,0"
                    FontSize="17">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AccountGroup" Width="26" Height="26" Margin="0,0,8,0"/>
                                <TextBlock Text="Clients" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource TopNavButtonStyle}" Command="{Binding NavToSettingsCommand}"
                    MinWidth="140" MinHeight="60" Margin="0,0,18,0"
                    FontSize="17">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Cogs" Width="26" Height="26" Margin="0,0,8,0"/>
                                <TextBlock Text="Paramètres" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Right: Logout -->
                    <Button Style="{StaticResource TopNavButtonStyle}" Command="{Binding LogoutCommand}" 
                HorizontalAlignment="Right" MinWidth="140" MinHeight="60"
                FontSize="17">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Logout" Width="26" Height="26" Margin="0,0,8,0"/>
                            <TextBlock Text="Déconnexion" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- ═══════════ 3. CONTENT ═══════════ -->
            <ContentControl Grid.Row="2" Content="{Binding CurrentView}" Margin="16"/>
        </Grid>
    </Border>
</Window>