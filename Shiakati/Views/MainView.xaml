<Window x:Class="Shiakati.Views.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:converters="clr-namespace:Shiakati.Converters"
        Title="Shiakati POS" Height="800" Width="1280"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        Background="Transparent"
        WindowStyle="None" AllowsTransparency="True"
        WindowStartupLocation="CenterScreen"
        FontFamily="{DynamicResource BodyFont}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InvertBooleanConverter x:Key="InvertBooleanConverter"/>
    </Window.Resources>

    <!-- ============ ROUNDED WINDOW CORNERS ============ -->
    <Border CornerRadius="14" Background="{DynamicResource BgBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Title bar -->
                <RowDefinition Height="Auto"/>
                <!-- Collapsible navigation -->
                <RowDefinition Height="*"/>
                <!-- Content -->
            </Grid.RowDefinitions>

            <!-- ═══════════ 1. TITLE BAR ═══════════ -->
            <Border x:Name="pnlControlBar" Grid.Row="0" Height="55" Background="{DynamicResource SecondaryBrush}"
                    MouseLeftButtonDown="pnlControlBar_MouseLeftButtonDown"
                    BorderBrush="{DynamicResource BgAltBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="8,5,8,0">
                    <!-- App logo + name (left) -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="/Resources/Photos/shiakati logo on secondary brush.png" 
                               Width="25" Height="36" VerticalAlignment="Center" Stretch="Uniform"/>
                        <TextBlock Text=" Shiakati  شياكتي" 
                                   FontFamily="{StaticResource ArabicFont}" 
                                   FontSize="24" FontWeight="Bold" Margin="8,0"
                                   Foreground="{DynamicResource BgBrush}" VerticalAlignment="Center"/>
                        <TextBlock 
                                   Foreground="{DynamicResource BgBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" 
                                   Margin="2,10,0,0">
                        <Run Text="POS v"/>
                        <Run Text="{Binding Version,Mode=OneWay}"/>
                        <Run Text=" © 2026"/>
                            </TextBlock>

                    </StackPanel>

                    <!-- Right side controls: navigation toggle + window buttons -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">

                            <ToggleButton Style="{StaticResource MaterialDesignActionToggleButton}"
                                          IsChecked="{Binding IsDarkMode}" 
                                          Background="{DynamicResource BgBrush}"
                                          VerticalAlignment="Center"
                                          ToolTip="Mode sombre / clair"
                                          Margin="12,0"
                                          Width="40" Height="40">
                                <ToggleButton.Content>
                                    <materialDesign:PackIcon Kind="WeatherNight" 
                                     Foreground="{DynamicResource DarkLightTextNavyWhiteBrush}"
                                                             />
                                    
                                </ToggleButton.Content>
                                
                                <materialDesign:ToggleButtonAssist.OnContent>
                                    <materialDesign:PackIcon Kind="WeatherSunny" 
                                     Foreground="{DynamicResource DarkLightTextNavyWhiteBrush}"/>
                                </materialDesign:ToggleButtonAssist.OnContent>
                            </ToggleButton>

                            <!-- 🌐 Language toggle (FR ↔ AR) -->
                            <ToggleButton Style="{StaticResource MaterialDesignActionToggleButton}"
                                          IsChecked="{Binding IsArabicLanguage}"
                                          Background="{DynamicResource BgBrush}"
                                          VerticalAlignment="Center"
                                          ToolTip="Langue : Français / العربية"
                                          Margin="4,0"
                                          Width="40" Height="40">
                                <ToggleButton.Content>
                                    <TextBlock Text="FR" FontWeight="Bold" 
                                     Foreground="{DynamicResource DarkLightTextNavyWhiteBrush}"
                                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </ToggleButton.Content>
                                <materialDesign:ToggleButtonAssist.OnContent>
                                    <TextBlock Text="AR" FontWeight="Bold" 
                       Foreground="{DynamicResource DarkLightTextNavyWhiteBrush}"
                       FontFamily="{StaticResource ArabicFont}"
                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </materialDesign:ToggleButtonAssist.OnContent>
                            </ToggleButton>

                            
                        
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                            <TextBlock Text="" VerticalAlignment="Center" Margin="12,8,12,0"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BgAltBrush}"/>
                            <materialDesign:PackIcon Foreground="{DynamicResource BgBrush}" Kind="Download" Width="36" Height="36" VerticalAlignment="Center"/>

                        </StackPanel>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                            <TextBlock Text="{Binding ToDay}" VerticalAlignment="Center" Margin="12,8,12,0"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BgAltBrush}"/>
                            <materialDesign:PackIcon Foreground="{DynamicResource BgBrush}" Kind="CalendarToday" Width="36" Height="36" VerticalAlignment="Center"/>

                        </StackPanel>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                            <TextBlock Text="{Binding UserName}" VerticalAlignment="Center" Margin="12,8,12,0"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BgAltBrush}"/>
                            <materialDesign:PackIcon Foreground="{DynamicResource BgBrush}" Kind="User" Width="36" Height="36" VerticalAlignment="Center"/>
                            
                        </StackPanel>
                        <!-- ============ NOTIFICATION BUTTON ============ -->
                        <Button Command="{Binding NavigateToDashBordCommand}" 
                                Background="Transparent" BorderThickness="0"
                                Height="Auto"
                                Cursor="Hand" Margin="8,5"
                                VerticalAlignment="Center"
                                ToolTip="{Binding AlertBadgeCount, StringFormat='{}{0} alerte(s) stock'}">

                            <Button.Resources>
                                <Style TargetType="materialDesign:PackIcon">
                                    <Setter Property="Foreground" Value="{DynamicResource BgBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAlertActive}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource BgBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Resources>

                            <Grid>
                                <materialDesign:PackIcon Kind="Notifications" Foreground="{DynamicResource BgBrush}" Width="36" Height="36" VerticalAlignment="Center"/>

                                <Grid>
                                    <!-- Badge Border – Visibility controlled by DataTrigger, not animated -->
                                    <Border x:Name="BadgeBorder"
                                            Background="{DynamicResource DangerBrush}" CornerRadius="10" 
                                            Width="20" Height="20" 
                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Margin="0,2,-5,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAlertActive}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="1" ScaleY="1" CenterX="10" CenterY="10"/>
                                        </Border.RenderTransform>
                                        <TextBlock Text="{Binding AlertBadgeCount}" 
                           Foreground="{DynamicResource BgBrush}" FontSize="12" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- VisualStateManager – only animates ScaleTransform -->
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="AlertStates">
                                            <VisualState x:Name="NoAlert">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="BadgeBorder"
                                             Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)"
                                             To="1" Duration="0:0:0.1"/>
                                                    <DoubleAnimation Storyboard.TargetName="BadgeBorder"
                                             Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)"
                                             To="1" Duration="0:0:0.1"/>
                                                </Storyboard>
                                            </VisualState>
                                            <VisualState x:Name="HasAlertPulse">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="BadgeBorder"
                                             Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)"
                                             From="1" To="1.4" Duration="0:0:0.4" 
                                             AutoReverse="True" RepeatBehavior="Forever"/>
                                                    <DoubleAnimation Storyboard.TargetName="BadgeBorder"
                                             Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)"
                                             From="1" To="1.4" Duration="0:0:0.4" 
                                             AutoReverse="True" RepeatBehavior="Forever"/>
                                                </Storyboard>
                                            </VisualState>
                                            <VisualState x:Name="HasAlertStatic">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="BadgeBorder"
                                             Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)"
                                             To="1" Duration="0:0:0.1"/>
                                                    <DoubleAnimation Storyboard.TargetName="BadgeBorder"
                                             Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)"
                                             To="1" Duration="0:0:0.1"/>
                                                </Storyboard>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>

                                    <!-- Triggers to switch states based on ViewModel properties -->
                                    <i:Interaction.Triggers>
                                        <i:DataTrigger Binding="{Binding IsAlertPulsing}" Value="True">
                                            <i:GoToStateAction StateName="HasAlertPulse"/>
                                        </i:DataTrigger>
                                        <i:DataTrigger Binding="{Binding IsAlertStatic}" Value="True">
                                            <i:GoToStateAction StateName="HasAlertStatic"/>
                                        </i:DataTrigger>
                                        <i:DataTrigger Binding="{Binding IsAlertActive}" Value="False">
                                            <i:GoToStateAction StateName="NoAlert"/>
                                        </i:DataTrigger>
                                    </i:Interaction.Triggers>
                                </Grid>
                            </Grid>
                        </Button>
                        <!-- LARGE navigation toggle – uses GlobalStyles.xaml NavToggleStyle -->
                        <ToggleButton x:Name="NavVisibilityToggle" 
                                      Style="{StaticResource NavToggleStyle}"
                                      Margin="0,0,16,0">
                            <ToggleButton.Content>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Foreground="{DynamicResource BgBrush}" Kind="Menu" Width="36" Height="36" VerticalAlignment="Center"/>
                                    <TextBlock Text="Menu" VerticalAlignment="Center" Margin="12,0,0,0"
                                               FontSize="16" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </ToggleButton.Content>
                            <materialDesign:ToggleButtonAssist.OnContent>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="MenuOpen" Width="36" Height="36" VerticalAlignment="Center"/>
                                    <TextBlock Text="Masquer" VerticalAlignment="Center" Margin="12,0,0,0"
                                               FontSize="16" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </materialDesign:ToggleButtonAssist.OnContent>
                        </ToggleButton>

                        <!-- Window control buttons -->
                        <Button x:Name="BtnMinmize" Content="—" FontSize="20" FontWeight="ExtraBlack" Click="BtnMinmize_Click" 
                                Style="{DynamicResource MaterialDesignFlatButton}" 
                                Foreground="{StaticResource InputBorderBrush}" 
                                Width="48" Height="48"/>
                        <Button x:Name="btnMaximize" Content="☐" FontWeight="ExtraBlack" FontSize="20" Click="btnMaximize_Click" 
                                Style="{DynamicResource MaterialDesignFlatButton}" 
                                Foreground="{StaticResource InputBorderBrush}" 
                                Width="48" Height="48"/>
                        <Button x:Name="btnClose" Click="btnClose_Click" 
                                Style="{StaticResource MaterialDesignFlatButton}" 
                                Width="48" Height="48">
                            <StackPanel Width="48" Height="48" VerticalAlignment="Center"  HorizontalAlignment="Center">
                                <materialDesign:PackIcon Foreground="{StaticResource InputBorderBrush}" Kind="Close" Width="48" Height="48" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══════════ 2. COLLAPSIBLE NAVIGATION BAR ═══════════ -->
            <Border Grid.Row="1" Height="80" Background="{DynamicResource BgBrush}"
                    BorderBrush="{DynamicResource BgAltBrush}" BorderThickness="0,0,0,1"
                    Visibility="{Binding ElementName=NavVisibilityToggle, Path=IsChecked, Converter={StaticResource BoolToVis}}">
                <Grid Margin="20,0">
                    <!-- Left: main navigation buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Button Style="{DynamicResource TopNavButtonStyle}"
                                MinWidth="140" MinHeight="60" Margin="0,0,18,0"
                                FontSize="17"
                                Command="{Binding NavigateToDashBordCommand}"
                                Click="CloseNavBar"
                                Tag="Dashboard">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ChartBar" Width="26" Height="26" Margin="5,0,8,0"/>
                                <TextBlock Text="Tableau Bord" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{DynamicResource TopNavButtonStyle}" Command="{Binding NavigateToPOSCommand}"
                                MinWidth="140" MinHeight="60" Margin="0,0,18,0"
                                FontSize="17"
                                Click="CloseNavBar">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CashRegister" Width="26" Height="26" Margin="0,0,8,0"/>
                                <TextBlock Text="Caisse" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{DynamicResource TopNavButtonStyle}" Command="{Binding NavigateToStockCommand}"
                                MinWidth="140" MinHeight="60" Margin="0,0,18,0"
                                FontSize="17"
                                Click="CloseNavBar" >
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Warehouse" Width="26" Height="26" Margin="0,0,8,0"/>
                                <TextBlock Text="Stock" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Historique toggle -->
                        <ToggleButton x:Name="btnHistorique" Style="{StaticResource TopNavToggleButtonStyle}"
                                      MinWidth="180" MinHeight="60" Margin="0,0,18,0"
                                      FontSize="17">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="History" Width="26" Height="26" Margin="0,0,8,0"/>
                                <TextBlock Text="Historique" VerticalAlignment="Center"/>
                                <materialDesign:PackIcon Kind="MenuDown" Width="20" Height="20" Margin="8,0,0,0"
                                                         VerticalAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>
                        <Popup PlacementTarget="{Binding ElementName=btnHistorique}" 
                               Placement="Bottom" 
                               IsOpen="{Binding IsChecked, ElementName=btnHistorique}" 
                               StaysOpen="False"
                               AllowsTransparency="True">
                            <Border CornerRadius="10" Background="{DynamicResource BgBrush}"
                                    BorderBrush="{DynamicResource BgAltBrush}" BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.3"/>
                                </Border.Effect>
                                <StackPanel Margin="6">
                                    <Button Command="{Binding NavigateToSalesHistoryCommand}"
                                            Click="CloseNavBar"
                                            Width="180" Height="60"
                                            FontSize="17" FontFamily="{DynamicResource HeadingFont}"
                                            FontWeight="SemiBold" Foreground="White"
                                            Style="{DynamicResource TopNavButtonStyle}" Margin="2">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="ReceiptTextClock" Width="22" Height="22" Margin="0,0,8,0"/>
                                            <TextBlock Text="Historique Ventes" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding NavigateToStockMovementsCommand}"
                                            Click="CloseNavBar"
                                            Width="180" Height="60"
                                            FontSize="17" FontFamily="{DynamicResource HeadingFont}"
                                            FontWeight="SemiBold" Foreground="White"
                                            Style="{DynamicResource TopNavButtonStyle}" Margin="2">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="DatabaseClock" Width="22" Height="22" Margin="0,0,8,0"/>
                                            <TextBlock Text="Mouvement Stock" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>

                        <Button Style="{StaticResource TopNavButtonStyle}" Command="{Binding NavigateToClientsCommand}"
                                MinWidth="140" MinHeight="60" Margin="0,0,18,0"
                                FontSize="17"
                                Click="CloseNavBar" >
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AccountGroup" Width="26" Height="26" Margin="0,0,8,0"/>
                                <TextBlock Text="Clients" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource TopNavButtonStyle}" Command="{Binding NavigateToSuppliersCommand}"
                                MinWidth="140" MinHeight="60" Margin="0,0,18,0"
                                FontSize="17"
                                Click="CloseNavBar" >
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Truck" Width="26" Height="26" Margin="0,0,8,0"/>
                                <TextBlock Text="Fournisseurs" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>


                        <Button Style="{StaticResource TopNavButtonStyle}" Command="{Binding NavigateToReservationsCommand}"
                                MinWidth="140" MinHeight="60" Margin="0,0,18,0"
                                FontSize="17"
                                Click="CloseNavBar" >
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CalendarClock" Width="26" Height="26" Margin="0,0,8,0"/>
                                <TextBlock Text="Réservations" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource TopNavButtonStyle}" Command="{Binding NavToSettingsCommand}"
                                MinWidth="140" MinHeight="60" Margin="0,0,18,0"
                                FontSize="17" Click="CloseNavBar" >
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Cogs" Width="26" Height="26" Margin="0,0,8,0"/>
                                <TextBlock Text="Paramètres" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Right: Logout -->
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding LogoutCommand}" 
                            HorizontalAlignment="Right" MinWidth="140" MinHeight="60"
                            FontSize="17">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Logout" Width="26" Height="26" Margin="0,0,8,0"/>
                            <TextBlock Text="Déconnexion" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            
            <!-- ═══════════ 3. CONTENT WITH HEADER ═══════════ -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Header bar -->
                    <RowDefinition Height="*"/>
                    <!-- Main content -->
                </Grid.RowDefinitions>

                <!-- Header bar (visible when CurrentViewTitle is NOT null AND NOT empty) -->
                <Border Grid.Row="0" Height="48"
            Background="{DynamicResource BgAltBrush}"
            BorderBrush="{DynamicResource BgAltBrush}" BorderThickness="0,0,0,1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <!-- Default: visible -->
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <!-- Hide when null or empty -->
                                <DataTrigger Binding="{Binding CurrentViewTitle}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CurrentViewTitle}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid Margin="16,0">
                        <TextBlock Text="{Binding CurrentViewTitle}"
                       FontFamily="{StaticResource HeadingFont}"
                       FontSize="18" FontWeight="Bold"
                       Foreground="{DynamicResource DarkLightTextNavyWhiteBrush}"
                       VerticalAlignment="Center"/>
                        <Button HorizontalAlignment="Right"
                    Style="{StaticResource MaterialDesignIconButton}"
                    ToolTip="Fermer cette vue"
                                Margin="0,0,10,0"
                    Command="{Binding CloseCurrentViewCommand}"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    Width="36" Height="36">
                            <materialDesign:PackIcon Kind="Close" Width="20" Height="20"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Original content area -->
                <ContentControl Grid.Row="1" Content="{Binding CurrentView}" Margin="16"/>
            </Grid>
        </Grid>
    </Border>
    
    
</Window>