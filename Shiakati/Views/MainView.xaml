<Window x:Class="Shiakati.Views.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:converters="clr-namespace:Shiakati.Converters"
        Title="Shiakati POS" Height="800" Width="1280"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        Background="{DynamicResource BgAltBrush}"
        WindowStyle="None" AllowsTransparency="True"
        WindowStartupLocation="CenterScreen"
        FontFamily="{DynamicResource BodyFont}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InvertBooleanConverter x:Key="InvertBooleanConverter"/>
    </Window.Resources>

    <!-- ============ ROUNDED WINDOW CORNERS ============ -->
    <Border CornerRadius="14" Background="{DynamicResource BgAltBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Title bar -->
                <RowDefinition Height="Auto"/>
                <!-- Collapsible navigation -->
                <RowDefinition Height="*"/>
                <!-- Content -->
            </Grid.RowDefinitions>

            <!-- ═══════════ 1. TITLE BAR ═══════════ -->
            <Border x:Name="pnlControlBar" Grid.Row="0" Height="60" 
        Background="{DynamicResource SecondaryBrush}"
        MouseLeftButtonDown="pnlControlBar_MouseLeftButtonDown"
        BorderBrush="{DynamicResource InputBorderBrush}" 
        BorderThickness="0,0,0,1">

                <Grid Margin="12,5,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="/Resources/Photos/shiakati logo on secondary brush.png" 
                   Width="28" Height="32" VerticalAlignment="Center" Stretch="Uniform"/>

                        <TextBlock Text="Shiakati  شياكتي" 
                       FontFamily="{StaticResource ArabicFont}" 
                       FontSize="20" FontWeight="Bold" Margin="10,0,0,0"
                       Foreground="{DynamicResource DarkLightTextNavyWhiteBrush}" 
                       VerticalAlignment="Center"/>

                        <Border Background="{DynamicResource BgAltBrush}" 
                    CornerRadius="10" Padding="8,2" Margin="12,0,0,0" 
                    VerticalAlignment="Center">
                            <TextBlock FontSize="11" FontWeight="SemiBold" 
                                       
                           Foreground="{DynamicResource TextSecondaryBrush}" 
                           VerticalAlignment="Center">
                    <Run Text="v"/><Run Text="{Binding Version, Mode=OneWay}"/>
                            </TextBlock>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                        <ToggleButton Style="{StaticResource MaterialDesignActionToggleButton}"
                          IsChecked="{Binding IsDarkMode}" 
                          Background="{StaticResource BgAltBrush}"
                          BorderThickness="0"
                          VerticalAlignment="Center"
                          ToolTip="Mode sombre / clair"
                          Margin="4,0"
                          Width="36" Height="36">
                            <ToggleButton.Content>
                                <materialDesign:PackIcon Kind="WeatherNight" 
                                             Foreground="{StaticResource TextPrimaryBrush}"
                                             Width="20" Height="20"/>
                            </ToggleButton.Content>
                            <materialDesign:ToggleButtonAssist.OnContent>
                                <materialDesign:PackIcon Kind="WeatherSunny" 
                                             Foreground="{StaticResource TextPrimaryBrush}"
                                             Width="20" Height="20"/>
                            </materialDesign:ToggleButtonAssist.OnContent>
                        </ToggleButton>

                        <ToggleButton Style="{StaticResource MaterialDesignActionToggleButton}"
                          IsChecked="{Binding IsArabicLanguage}"
                          Background="{StaticResource BgAltBrush}"
                          BorderThickness="0"
                          VerticalAlignment="Center"
                          ToolTip="Langue : Français / العربية"
                          Margin="4,0"
                          Width="36" Height="36">
                            <ToggleButton.Content>
                                <TextBlock Text="FR" FontSize="12" FontWeight="Bold" 
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </ToggleButton.Content>
                            <materialDesign:ToggleButtonAssist.OnContent>
                                <TextBlock Text="ع" FontSize="14" FontWeight="Bold" 
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontFamily="{StaticResource ArabicFont}"
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </materialDesign:ToggleButtonAssist.OnContent>
                        </ToggleButton>

                        <Rectangle Width="1" Height="24" Fill="{DynamicResource InputBorderBrush}" Margin="8,0"/>

                        <Border Background="{StaticResource BgAltBrush}" CornerRadius="6" Padding="8,4" Margin="4,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="CalendarToday" Foreground="{DynamicResource TextSecondaryBrush}" 
                                             Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ToDay}" VerticalAlignment="Center" Margin="6,0,2,0"
                               FontSize="13" FontWeight="Medium"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource BgAltBrush}" CornerRadius="6" Padding="8,4" Margin="4,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="Account" Foreground="{DynamicResource SecondaryBrush}" 
                                             Width="20" Height="20" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding UserName}" VerticalAlignment="Center" Margin="6,0,2,0"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource BgAltBrush}" CornerRadius="6" Padding="8,4" Margin="4,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Command="{Binding NavigateToDashBordCommand}" 
                                        Background="Transparent" BorderThickness="0"
                                        
                                        Height="32" Width="36" Padding="0"
                                        Cursor="Hand" Margin="4,0"
                                        VerticalAlignment="Center"
                                        ToolTip="{Binding AlertBadgeCount, StringFormat='{}{0} alerte(s) stock'}">
                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="MarketplaceOutline" 
                                             Foreground="{DynamicResource TextSecondaryBrush}"  Margin="-3,0,0,0"
                                             Width="24" Height="24" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                        <Border x:Name="BadgeBorder"
                                                    Background="Orange" CornerRadius="7" 
                                                    Width="15" Height="15" 
                                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    Margin="0,-3,-5,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAlertActive}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Border.RenderTransform>
                                                <ScaleTransform ScaleX="1" ScaleY="1" CenterX="7" CenterY="7"/>
                                            </Border.RenderTransform>
                                            <TextBlock Text="{Binding AlertBadgeCount}" 
                                   Foreground="{StaticResource BgAltBrush}" FontSize="9" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup x:Name="AlertStates">
                                                <VisualState x:Name="NoAlert">
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="BadgeBorder"
                                                     Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)"
                                                     To="1" Duration="0:0:0.1"/>
                                                        <DoubleAnimation Storyboard.TargetName="BadgeBorder"
                                                     Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)"
                                                     To="1" Duration="0:0:0.1"/>
                                                    </Storyboard>
                                                </VisualState>
                                                <VisualState x:Name="HasAlertPulse">
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="BadgeBorder"
                                                     Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)"
                                                     From="1" To="1.3" Duration="0:0:0.4" 
                                                     AutoReverse="True" RepeatBehavior="Forever"/>
                                                        <DoubleAnimation Storyboard.TargetName="BadgeBorder"
                                                     Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)"
                                                     From="1" To="1.3" Duration="0:0:0.4" 
                                                     AutoReverse="True" RepeatBehavior="Forever"/>
                                                    </Storyboard>
                                                </VisualState>
                                                <VisualState x:Name="HasAlertStatic">
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="BadgeBorder"
                                                     Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)"
                                                     To="1" Duration="0:0:0.1"/>
                                                        <DoubleAnimation Storyboard.TargetName="BadgeBorder"
                                                     Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)"
                                                     To="1" Duration="0:0:0.1"/>
                                                    </Storyboard>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>

                                        <i:Interaction.Triggers>
                                            <i:DataTrigger Binding="{Binding IsAlertPulsing}" Value="True">
                                                <i:GoToStateAction StateName="HasAlertPulse"/>
                                            </i:DataTrigger>
                                            <i:DataTrigger Binding="{Binding IsAlertStatic}" Value="True">
                                                <i:GoToStateAction StateName="HasAlertStatic"/>
                                            </i:DataTrigger>
                                            <i:DataTrigger Binding="{Binding IsAlertActive}" Value="False">
                                                <i:GoToStateAction StateName="NoAlert"/>
                                            </i:DataTrigger>
                                        </i:Interaction.Triggers>
                                    </Grid>

                                </Button>
                            </StackPanel>
                            </Border>

                        <ToggleButton x:Name="NavVisibilityToggle" 
              Style="{StaticResource NavToggleStyle}"
              Margin="6,0,12,0">

                            <ToggleButton.Content>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Menu" 
                                     Width="20" Height="20" 
                                     VerticalAlignment="Center"/>
                                    <TextBlock Text="Menu" 
                       VerticalAlignment="Center" 
                       Margin="6,0,0,0"
                       FontSize="13" 
                       FontWeight="SemiBold"/>
                                </StackPanel>
                            </ToggleButton.Content>

                            <materialDesign:ToggleButtonAssist.OnContent>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="MenuOpen" 
                                     Width="20" Height="20" 
                                     VerticalAlignment="Center"/>
                                    <TextBlock Text="Masquer" 
                       VerticalAlignment="Center" 
                       Margin="6,0,0,0"
                       FontSize="13" 
                       FontWeight="SemiBold"/>
                                </StackPanel>
                            </materialDesign:ToggleButtonAssist.OnContent>

                        </ToggleButton>



                        <Rectangle Width="1" Height="24" Fill="{DynamicResource InputBorderBrush}" Margin="0,0,4,0"/>

                        <Button x:Name="BtnMinmize" Click="BtnMinmize_Click" 
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Padding="0" Width="40" Height="40" ToolTip="Réduire">
                            <materialDesign:PackIcon Kind="WindowMinimize" Foreground="{DynamicResource TextPrimaryBrush}" Width="18" Height="18"/>
                        </Button>

                        <Button x:Name="btnMaximize" Click="btnMaximize_Click" 
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Padding="0" Width="40" Height="40" ToolTip="Agrandir">
                            <materialDesign:PackIcon Kind="CropSquare" Foreground="{DynamicResource TextPrimaryBrush}" Width="18" Height="18"/>
                        </Button>

                        <Button x:Name="btnClose" Click="btnClose_Click" 
                    Padding="0" Width="40" Height="40" ToolTip="Fermer">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <materialDesign:PackIcon Kind="Close" Width="20" Height="20">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon">
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                        </Button>

                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- ═══════════ 2. COLLAPSIBLE NAVIGATION BAR ═══════════ -->
            <Border Grid.Row="1" Height="80" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{DynamicResource SecondaryBrush}" BorderThickness="0,0,0,1"
                    Visibility="{Binding ElementName=NavVisibilityToggle, Path=IsChecked, Converter={StaticResource BoolToVis}}">
                <Grid Margin="20,0">
                    <!-- Left: main navigation buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Button Style="{DynamicResource TopNavButtonStyle}"
                                MinWidth="140" MinHeight="60" Margin="0,0,18,0"
                                FontSize="17"
                                Command="{Binding NavigateToDashBordCommand}"
                                Click="CloseNavBar"
                                Tag="Dashboard">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ChartBar" Width="26" Height="26" Margin="5,0,8,0"/>
                                <TextBlock Text="Tableau Bord" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{DynamicResource TopNavButtonStyle}" Command="{Binding NavigateToPOSCommand}"
                                MinWidth="140" MinHeight="60" Margin="0,0,18,0"
                                FontSize="17"
                                Click="CloseNavBar">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CashRegister" Width="26" Height="26" Margin="0,0,8,0"/>
                                <TextBlock Text="Caisse" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{DynamicResource TopNavButtonStyle}" Command="{Binding NavigateToStockCommand}"
                                MinWidth="140" MinHeight="60" Margin="0,0,18,0"
                                FontSize="17"
                                Click="CloseNavBar" >
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Warehouse" Width="26" Height="26" Margin="0,0,8,0"/>
                                <TextBlock Text="Stock" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Historique toggle -->
                        <ToggleButton x:Name="btnHistorique" Style="{StaticResource TopNavToggleButtonStyle}"
                                      MinWidth="180" MinHeight="60" Margin="0,0,18,0"
                                      FontSize="17">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="History" Width="26" Height="26" Margin="0,0,8,0"/>
                                <TextBlock Text="Historique" VerticalAlignment="Center"/>
                                <materialDesign:PackIcon Kind="MenuDown" Width="20" Height="20" Margin="8,0,0,0"
                                                         VerticalAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>
                        <Popup PlacementTarget="{Binding ElementName=btnHistorique}" 
                               Placement="Bottom" 
                               IsOpen="{Binding IsChecked, ElementName=btnHistorique}" 
                               StaysOpen="False"
                               AllowsTransparency="True">
                            <Border CornerRadius="10" Background="{DynamicResource BgBrush}"
                                    BorderBrush="{DynamicResource BgAltBrush}" BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.3"/>
                                </Border.Effect>
                                <StackPanel Margin="6">
                                    <Button Command="{Binding NavigateToSalesHistoryCommand}"
                                            Click="CloseNavBar"
                                            Width="180" Height="60"
                                            FontSize="17" FontFamily="{DynamicResource HeadingFont}"
                                            FontWeight="SemiBold" Foreground="White"
                                            Style="{DynamicResource TopNavButtonStyle}" Margin="2">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="ReceiptTextClock" Width="22" Height="22" Margin="0,0,8,0"/>
                                            <TextBlock Text="Historique Ventes" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding NavigateToStockMovementsCommand}"
                                            Click="CloseNavBar"
                                            Width="180" Height="60"
                                            FontSize="17" FontFamily="{DynamicResource HeadingFont}"
                                            FontWeight="SemiBold" Foreground="White"
                                            Style="{DynamicResource TopNavButtonStyle}" Margin="2">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="DatabaseClock" Width="22" Height="22" Margin="0,0,8,0"/>
                                            <TextBlock Text="Mouvement Stock" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>

                        <Button Style="{StaticResource TopNavButtonStyle}" Command="{Binding NavigateToClientsCommand}"
                                MinWidth="140" MinHeight="60" Margin="0,0,18,0"
                                FontSize="17"
                                Click="CloseNavBar" >
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AccountGroup" Width="26" Height="26" Margin="0,0,8,0"/>
                                <TextBlock Text="Clients" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource TopNavButtonStyle}" Command="{Binding NavigateToSuppliersCommand}"
                                MinWidth="140" MinHeight="60" Margin="0,0,18,0"
                                FontSize="17"
                                Click="CloseNavBar" >
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Truck" Width="26" Height="26" Margin="0,0,8,0"/>
                                <TextBlock Text="Fournisseurs" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>


                        <Button Style="{StaticResource TopNavButtonStyle}" Command="{Binding NavigateToReservationsCommand}"
                                MinWidth="140" MinHeight="60" Margin="0,0,18,0"
                                FontSize="17"
                                Click="CloseNavBar" >
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CalendarClock" Width="26" Height="26" Margin="0,0,8,0"/>
                                <TextBlock Text="Réservations" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource TopNavButtonStyle}" Command="{Binding NavToSettingsCommand}"
                                MinWidth="140" MinHeight="60" Margin="0,0,18,0"
                                FontSize="17" Click="CloseNavBar" >
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Cogs" Width="26" Height="26" Margin="0,0,8,0"/>
                                <TextBlock Text="Paramètres" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Right: Logout -->
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding LogoutCommand}" 
                            HorizontalAlignment="Right" MinWidth="140" MinHeight="60"
                            FontSize="17">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Logout" Width="26" Height="26" Margin="0,0,8,0"/>
                            <TextBlock Text="Déconnexion" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            
            <!-- ═══════════ 3. CONTENT WITH HEADER ═══════════ -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Header bar -->
                    <RowDefinition Height="*"/>
                    <!-- Main content -->
                </Grid.RowDefinitions>

                <!-- Header bar (visible when CurrentViewTitle is NOT null AND NOT empty) -->
                <Border Grid.Row="0" Height="32"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource SecondaryBrush}" BorderThickness="0,0,0,1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <!-- Default: visible -->
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <!-- Hide when null or empty -->
                                <DataTrigger Binding="{Binding CurrentViewTitle}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CurrentViewTitle}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid Margin="16,0">
                        <TextBlock Text="{Binding CurrentViewTitle}"
                       FontFamily="{StaticResource MaterialDesignFont}"
                       FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       VerticalAlignment="Center"/>
                        <Button HorizontalAlignment="Right"
                    Style="{StaticResource MaterialDesignIconButton}"
                    ToolTip="Fermer cette vue"
                                Margin="0,0,10,0"
                    Command="{Binding CloseCurrentViewCommand}"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    Width="24" Height="24">
                            <materialDesign:PackIcon Kind="Close" Width="20" Height="20" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Original content area -->
                <ContentControl Grid.Row="1" Background="{DynamicResource BgAltBrush}" Content="{Binding CurrentView}" Margin="16"/>
            </Grid>
        </Grid>
    </Border>
    
    
</Window>