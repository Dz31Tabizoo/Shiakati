<Window x:Class="Shiakati.Views.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:converters="clr-namespace:Shiakati.Converters"
        Title="Shiakati POS" Height="800" Width="1280"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        Background="Transparent"
        WindowStyle="None" AllowsTransparency="True"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource BodyFont}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InvertBooleanConverter x:Key="InvertBooleanConverter"/>
        <!-- ============ Gradient brush reused by all nav buttons ============ -->
        <LinearGradientBrush x:Key="NavGradientBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0" Color="#13314B"/>
            <GradientStop Offset="1" Color="#1D4A6B"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="NavGradientHoverBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0" Color="#1D4A6B"/>
            <GradientStop Offset="1" Color="#2A5B7A"/>
        </LinearGradientBrush>
        <!-- ============ NAV BUTTON STYLE (for regular Button) ============ -->
        <Style x:Key="TopNavButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="{StaticResource HeadingFont}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="8" Background="{StaticResource NavGradientBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource NavGradientHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- ============ NAV TOGGLE BUTTON STYLE (for ToggleButton – same look) ============ -->
        <Style x:Key="TopNavToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="48"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="{StaticResource HeadingFont}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" CornerRadius="8" Background="{StaticResource NavGradientBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource NavGradientHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- The global NavToggleStyle from GlobalStyles.xaml will be used – no need to redefine here -->
    </Window.Resources>

    <!-- ============ ROUNDED WINDOW CORNERS ============ -->
    <Border CornerRadius="14" Background="{StaticResource BgBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Title bar -->
                <RowDefinition Height="Auto"/>
                <!-- Collapsible navigation -->
                <RowDefinition Height="*"/>
                <!-- Content -->
            </Grid.RowDefinitions>

            <!-- ═══════════ 1. TITLE BAR ═══════════ -->
            <Border x:Name="pnlControlBar" Grid.Row="0" Height="55" Background="{StaticResource SecondaryBrush}"
                    MouseLeftButtonDown="pnlControlBar_MouseLeftButtonDown"
                    BorderBrush="{StaticResource BgAltBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="10,0">
                    <!-- App logo + name (left) -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="/Resources/Photos/shiakati logo on secondary brush.png" 
                               Width="25" Height="36" VerticalAlignment="Center" Stretch="Uniform"/>
                        <TextBlock Text=" Shiakati  شياكتي" 
                                   FontFamily="{StaticResource HeadingFont}" 
                                   FontSize="24" FontWeight="Bold" Margin="8,0"
                                   Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Right side controls: navigation toggle + window buttons -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="{Binding ToDay}" VerticalAlignment="Center" Margin="12,8,12,0"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource BgAltBrush}"/>
                            <materialDesign:PackIcon Foreground="White" Kind="CalendarToday" Width="36" Height="36" VerticalAlignment="Center"/>

                        </StackPanel>

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="{Binding UserName}" VerticalAlignment="Center" Margin="12,8,12,0"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource BgAltBrush}"/>
                            <materialDesign:PackIcon Foreground="White" Kind="User" Width="36" Height="36" VerticalAlignment="Center"/>
                            
                        </StackPanel>
                        <!-- ============ NOTIFICATION BUTTON ============ -->
                        <Button Command="{Binding NavigateToDashBordCommand}" 
                                Background="Transparent" BorderThickness="0"
                                Height="Auto"
                                Cursor="Hand" Margin="8,5"
                                ToolTip="{Binding AlertBadgeCount, StringFormat='{}{0} alerte(s) stock'}">

                            <Button.Resources>
                                <Style TargetType="materialDesign:PackIcon">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAlertActive}" Value="True">
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Resources>

                            <Grid>
                                <materialDesign:PackIcon Kind="Notifications" Width="36" Height="36" VerticalAlignment="Center"/>

                                <Grid>
                                    <!-- Badge Border – Visibility controlled by DataTrigger, not animated -->
                                    <Border x:Name="BadgeBorder"
                                            Background="{StaticResource DangerBrush}" CornerRadius="10" 
                                            Width="20" Height="20" 
                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Margin="0,2,-5,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAlertActive}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="1" ScaleY="1" CenterX="10" CenterY="10"/>
                                        </Border.RenderTransform>
                                        <TextBlock Text="{Binding AlertBadgeCount}" 
                           Foreground="White" FontSize="12" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- VisualStateManager – only animates ScaleTransform -->
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="AlertStates">
                                            <VisualState x:Name="NoAlert">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="BadgeBorder"
                                             Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)"
                                             To="1" Duration="0:0:0.1"/>
                                                    <DoubleAnimation Storyboard.TargetName="BadgeBorder"
                                             Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)"
                                             To="1" Duration="0:0:0.1"/>
                                                </Storyboard>
                                            </VisualState>
                                            <VisualState x:Name="HasAlertPulse">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="BadgeBorder"
                                             Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)"
                                             From="1" To="1.4" Duration="0:0:0.4" 
                                             AutoReverse="True" RepeatBehavior="Forever"/>
                                                    <DoubleAnimation Storyboard.TargetName="BadgeBorder"
                                             Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)"
                                             From="1" To="1.4" Duration="0:0:0.4" 
                                             AutoReverse="True" RepeatBehavior="Forever"/>
                                                </Storyboard>
                                            </VisualState>
                                            <VisualState x:Name="HasAlertStatic">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="BadgeBorder"
                                             Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)"
                                             To="1" Duration="0:0:0.1"/>
                                                    <DoubleAnimation Storyboard.TargetName="BadgeBorder"
                                             Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)"
                                             To="1" Duration="0:0:0.1"/>
                                                </Storyboard>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>

                                    <!-- Triggers to switch states based on ViewModel properties -->
                                    <i:Interaction.Triggers>
                                        <i:DataTrigger Binding="{Binding IsAlertPulsing}" Value="True">
                                            <i:GoToStateAction StateName="HasAlertPulse"/>
                                        </i:DataTrigger>
                                        <i:DataTrigger Binding="{Binding IsAlertStatic}" Value="True">
                                            <i:GoToStateAction StateName="HasAlertStatic"/>
                                        </i:DataTrigger>
                                        <i:DataTrigger Binding="{Binding IsAlertActive}" Value="False">
                                            <i:GoToStateAction StateName="NoAlert"/>
                                        </i:DataTrigger>
                                    </i:Interaction.Triggers>
                                </Grid>
                            </Grid>
                        </Button>
                        <!-- LARGE navigation toggle – uses GlobalStyles.xaml NavToggleStyle -->
                        <ToggleButton x:Name="NavVisibilityToggle" 
                                      Style="{StaticResource NavToggleStyle}"
                                      Margin="0,0,16,0">
                            <ToggleButton.Content>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Foreground="White" Kind="Menu" Width="36" Height="36" VerticalAlignment="Center"/>
                                    <TextBlock Text="Menu" VerticalAlignment="Center" Margin="12,0,0,0"
                                               FontSize="16" FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryBrush}"/>
                                </StackPanel>
                            </ToggleButton.Content>
                            <materialDesign:ToggleButtonAssist.OnContent>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="MenuOpen" Width="36" Height="36" VerticalAlignment="Center"/>
                                    <TextBlock Text="Masquer" VerticalAlignment="Center" Margin="12,0,0,0"
                                               FontSize="16" FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryBrush}"/>
                                </StackPanel>
                            </materialDesign:ToggleButtonAssist.OnContent>
                        </ToggleButton>

                        <!-- Window control buttons -->
                        <Button x:Name="BtnMinmize" Content="—" FontSize="20" FontWeight="ExtraBlack" Click="BtnMinmize_Click" 
                                Style="{StaticResource MaterialDesignFlatButton}" 
                                Foreground="{StaticResource PrimaryBrush}" 
                                Width="48" Height="48"/>
                        <Button x:Name="btnMaximize" Content="☐" FontWeight="ExtraBlack" FontSize="20" Click="btnMaximize_Click" 
                                Style="{StaticResource MaterialDesignFlatButton}" 
                                Foreground="{StaticResource PrimaryBrush}" 
                                Width="48" Height="48"/>
                        <Button x:Name="btnClose" Click="btnClose_Click" 
                                Style="{StaticResource MaterialDesignFlatButton}" 
                                Width="48" Height="48">
                            <StackPanel Width="48" Height="48" VerticalAlignment="Center"  HorizontalAlignment="Center">
                                <materialDesign:PackIcon Foreground="{StaticResource PrimaryBrush}" Kind="Close" Width="48" Height="48" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══════════ 2. COLLAPSIBLE NAVIGATION BAR ═══════════ -->
            <Border Grid.Row="1" Height="80" Background="{StaticResource BgBrush}"
                    BorderBrush="{StaticResource BgAltBrush}" BorderThickness="0,0,0,1"
                    Visibility="{Binding ElementName=NavVisibilityToggle, Path=IsChecked, Converter={StaticResource BoolToVis}}">
                <Grid Margin="20,0">
                    <!-- Left: main navigation buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Button Style="{StaticResource TopNavButtonStyle}"
                                MinWidth="140" MinHeight="60" Margin="0,0,18,0"
                                FontSize="17"
                                Command="{Binding NavigateToDashBordCommand}"
                                Tag="Dashboard">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ChartBar" Width="26" Height="26" Margin="0,0,8,0"/>
                                <TextBlock Text="Tableau Bord" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource TopNavButtonStyle}" Command="{Binding NavigateToPOSCommand}"
                                MinWidth="140" MinHeight="60" Margin="0,0,18,0"
                                FontSize="17">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CashRegister" Width="26" Height="26" Margin="0,0,8,0"/>
                                <TextBlock Text="Caisse" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource TopNavButtonStyle}" Command="{Binding NavigateToStockCommand}"
                                MinWidth="140" MinHeight="60" Margin="0,0,18,0"
                                FontSize="17">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Warehouse" Width="26" Height="26" Margin="0,0,8,0"/>
                                <TextBlock Text="Stock" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Historique toggle -->
                        <ToggleButton x:Name="btnHistorique" Style="{StaticResource TopNavToggleButtonStyle}"
                                      MinWidth="180" MinHeight="60" Margin="0,0,18,0"
                                      FontSize="17">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="History" Width="26" Height="26" Margin="0,0,8,0"/>
                                <TextBlock Text="Historique" VerticalAlignment="Center"/>
                                <materialDesign:PackIcon Kind="MenuDown" Width="20" Height="20" Margin="8,0,0,0"
                                                         VerticalAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>
                        <Popup PlacementTarget="{Binding ElementName=btnHistorique}" 
                               Placement="Bottom" 
                               IsOpen="{Binding IsChecked, ElementName=btnHistorique}" 
                               StaysOpen="False"
                               AllowsTransparency="True">
                            <Border CornerRadius="10" Background="{StaticResource BgBrush}"
                                    BorderBrush="{StaticResource BgAltBrush}" BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.3"/>
                                </Border.Effect>
                                <StackPanel Margin="6">
                                    <Button Command="{Binding NavigateToSalesHistoryCommand}"
                                            Click="CloseHistoriquePopup"
                                            Width="180" Height="60"
                                            FontSize="17" FontFamily="{StaticResource HeadingFont}"
                                            FontWeight="SemiBold" Foreground="White"
                                            Style="{StaticResource TopNavButtonStyle}" Margin="2">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="ReceiptTextClock" Width="22" Height="22" Margin="0,0,8,0"/>
                                            <TextBlock Text="Historique Ventes" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding NavigateToStockMovementsCommand}"
                                            Click="CloseHistoriquePopup"
                                            Width="180" Height="60"
                                            FontSize="17" FontFamily="{StaticResource HeadingFont}"
                                            FontWeight="SemiBold" Foreground="White"
                                            Style="{StaticResource TopNavButtonStyle}" Margin="2">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="DatabaseClock" Width="22" Height="22" Margin="0,0,8,0"/>
                                            <TextBlock Text="Mouvement Stock" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>

                        <Button Style="{StaticResource TopNavButtonStyle}" Command="{Binding NavigateToClientsCommand}"
                                MinWidth="140" MinHeight="60" Margin="0,0,18,0"
                                FontSize="17">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AccountGroup" Width="26" Height="26" Margin="0,0,8,0"/>
                                <TextBlock Text="Clients" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        
                        <Button Style="{StaticResource TopNavButtonStyle}" Command="{Binding NavigateToReservationsCommand}"
                                MinWidth="140" MinHeight="60" Margin="0,0,18,0"
                                FontSize="17">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CalendarClock" Width="26" Height="26" Margin="0,0,8,0"/>
                                <TextBlock Text="Réservations" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource TopNavButtonStyle}" Command="{Binding NavToSettingsCommand}"
                                MinWidth="140" MinHeight="60" Margin="0,0,18,0"
                                FontSize="17">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Cogs" Width="26" Height="26" Margin="0,0,8,0"/>
                                <TextBlock Text="Paramètres" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Right: Logout -->
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding LogoutCommand}" 
                            HorizontalAlignment="Right" MinWidth="140" MinHeight="60"
                            FontSize="17">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Logout" Width="26" Height="26" Margin="0,0,8,0"/>
                            <TextBlock Text="Déconnexion" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            
            <!-- ═══════════ 3. CONTENT WITH HEADER ═══════════ -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Header bar -->
                    <RowDefinition Height="*"/>
                    <!-- Main content -->
                </Grid.RowDefinitions>

                <!-- Header bar (visible when CurrentViewTitle is NOT null AND NOT empty) -->
                <Border Grid.Row="0" Height="48"
            Background="{StaticResource BgAltBrush}"
            BorderBrush="{StaticResource BgAltBrush}" BorderThickness="0,0,0,1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <!-- Default: visible -->
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <!-- Hide when null or empty -->
                                <DataTrigger Binding="{Binding CurrentViewTitle}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CurrentViewTitle}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid Margin="16,0">
                        <TextBlock Text="{Binding CurrentViewTitle}"
                       FontFamily="{StaticResource HeadingFont}"
                       FontSize="18" FontWeight="Bold"
                       Foreground="{StaticResource PrimaryBrush}"
                       VerticalAlignment="Center"/>
                        <Button HorizontalAlignment="Right"
                    Style="{StaticResource MaterialDesignIconButton}"
                    ToolTip="Fermer cette vue"
                                Margin="0,0,10,0"
                    Command="{Binding CloseCurrentViewCommand}"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    Width="36" Height="36">
                            <materialDesign:PackIcon Kind="Close" Width="20" Height="20"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Original content area -->
                <ContentControl Grid.Row="1" Content="{Binding CurrentView}" Margin="16"/>
            </Grid>
        </Grid>
    </Border>
    
    
</Window>