
    <Window x:Class="Shiakati.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Connexion - Shiakati POS"
        Height="620"
        Width="1020"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        MouseLeftButtonDown="Window_MouseDown"
        Background="Transparent"
        FontFamily="{DynamicResource BodyFont}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <!-- Main Card -->
    <Border CornerRadius="22"
            Background="{DynamicResource BgAltBrush}"
            Margin="25">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="3" Opacity="0.25"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*"/>
                <ColumnDefinition Width="5*"/>
            </Grid.ColumnDefinitions>

            <!-- ═══════════ LEFT PANEL ═══════════ -->
            <Border Grid.Column="0"
                    Margin="5"
                    CornerRadius="22,22,22,22"
                    Background="Transparent">
                <Grid>
                    <!-- Subtle gradient overlay -->
                    <Border Opacity="1" CornerRadius="22">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Offset="0.08" Color="#1D4A6B"/>
                                <GradientStop Offset="0.0" Color="#286693"/>
                                <GradientStop Offset="1" Color="#286693"/>
                                <GradientStop Offset="0.9" Color="#1D4A6B"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Image Source="/Resources/Photos/Untitled.png"
                               Stretch="Fill"
                               Opacity="0.15"/>
                    </Border>
                    
                    

                    <StackPanel VerticalAlignment="Top"
                                HorizontalAlignment="Center">

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Opacity="1" Margin="0,25,0,0">
                            <Image Source="/Resources/Photos/NumidixLogoSQR.png"
                                   Width="78" Height="78" Margin="3"
                                   Stretch="Uniform"/>
                            <TextBlock Text="Numidix Pos"
                                       FontSize="26"
                                       FontFamily="{StaticResource BodyFont}"
                                       Foreground="{StaticResource BgBrush}"
                                       VerticalAlignment="Center" Margin="5,0"/>
                        </StackPanel>

                        
                        
                        <Image Source="/Resources/Photos/logo send f.png"
                               Width="300" Height="320" Opacity="0.5"
                               Stretch="Fill" Margin="0,0,0,0"/>

                        <Image Source="/Resources/Photos/shiakati name.png"
                                Width="180" Height="100" Opacity="0.6"
                                Stretch="UniformToFill" Margin="0,0,0,0"/>


                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══════════ RIGHT PANEL ═══════════ -->
            <Grid Grid.Column="1" Margin="40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Close button -->
                <Button Grid.Row="0"
                        HorizontalAlignment="Right"
                        Command="{Binding CloseApplicationCommand}"
                        Style="{StaticResource IconButton}"
                        Foreground="{DynamicResource TextSecondaryBrush}">
                    <materialDesign:PackIcon Kind="Close" Width="22" Height="22"/>
                </Button>

                <!-- Login form -->
                <StackPanel Grid.Row="1" Margin="20,19,20,21">

                    <TextBlock Text="Bienvenue / مرحباً"
               FontFamily="{StaticResource HeadingFont}"
               FontSize="34" FontWeight="Bold"
               HorizontalAlignment="Center"
               Foreground="{DynamicResource TextPrimaryBrush}"
               Margin="0,0,0,8"/>

                    <TextBlock Text="Veuillez vous connecter pour continuer"
               FontSize="16"
               HorizontalAlignment="Center"
               Foreground="{DynamicResource TextSecondaryBrush}"
               Margin="0,0,0,40"/>

                    <!-- Username -->
                    <TextBox x:Name="TxtUsername"
                             Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource ShiakatiTextBox}"
                             materialDesign:HintAssist.Hint="Nom d'utilisateur / اسم المستخدم"
                             materialDesign:HintAssist.Foreground="{DynamicResource TextSecondaryBrush}"
                             materialDesign:HintAssist.FloatingScale="0.6"
                             Margin="0,0,0,18"/>
                    <!-- Password – fully masked, clean floating hint -->
                    <PasswordBox x:Name="TxtPassword"
             Style="{DynamicResource MaterialDesignRevealPasswordBox}"
             materialDesign:HintAssist.Hint="  Mot de passe / كلمة المرور"
             materialDesign:HintAssist.Foreground="{DynamicResource TextSecondaryBrush}"
             materialDesign:HintAssist.FloatingScale="0.8"
             FontSize="16"
             Foreground="{DynamicResource TextPrimaryBrush}"
             Height="50"
             Margin="0,0,0,30"/>

                    <!-- Error message – auto‑sized, wraps if needed -->
                    <TextBlock x:Name="TxtErrorMessage"
               Text="{Binding ErrorMessage}"
               Foreground="{DynamicResource DangerBrush}"
               FontSize="14"
                               
               TextWrapping="Wrap"
               Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"
               Margin="4,6,0,30"/>

                    <!-- Login button -->
                    <Button x:Name="BtnLogin"
                            Command="{Binding LoginCommand}"
                            CommandParameter="{Binding ElementName=TxtPassword}"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource InvertBooleanConverter}}"
                            FontSize="20"
                            Height="60"
                            Margin="0,4,0,0"
                            Style="{DynamicResource PrimaryGoldenButton}">
                        <Button.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding LoginCommand}"
                        CommandParameter="{Binding ElementName=TxtPassword}"/>
                        </Button.InputBindings>

                        <TextBlock Text="SE CONNECTER" 
                   Foreground="White" 
                   FontSize="20" 
                   FontFamily="{DynamicResource HeadingFont}"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center"/>
                    </Button>

                </StackPanel>
                <!-- Footer -->
                <TextBlock Grid.Row="2"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,0">
                    <Run Text="Numidix POS v"/>
                    <Run Text="{Binding Version,Mode=OneWay}"/>
                    <Run Text=" © 2026"/>
                </TextBlock>
            </Grid>
        </Grid>
    </Border>
</Window>