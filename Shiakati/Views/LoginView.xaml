<Window x:Class="Shiakati.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Connexion - Shiakati POS"
        Height="620"
        Width="1020"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        MouseLeftButtonDown="Window_MouseDown"
        Background="Transparent"
        FontFamily="{StaticResource BodyFont}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <!-- Main Card -->
    <Border CornerRadius="22"
            Background="{StaticResource BgBrush}"
            Margin="25">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="3" Opacity="0.25"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*"/>
                <ColumnDefinition Width="5*"/>
            </Grid.ColumnDefinitions>

            <!-- ═══════════ LEFT PANEL ═══════════ -->
            <Border Grid.Column="0"
                    CornerRadius="22,0,0,22"
                    Background="{StaticResource PrimaryBrush}">
                <Grid>
                    <!-- Subtle gradient overlay -->
                    <Border Opacity="0.08">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Offset="0" Color="White"/>
                                <GradientStop Offset="1" Color="Transparent"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <TextBlock Text="شياكتي"
                                   FontFamily="Segoe UI Semibold"
                                   FontSize="62"                                   
                                   Margin="0,0,0,20"
                                   Foreground="{StaticResource BgBrush}"
                                   HorizontalAlignment="Center"/>
                        <Image Source="/Resources/Photos/Shiakati beige Logo.png"
                               Width="230" Height="300"
                               Stretch="Fill" Margin="0,0,0,25"/>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Opacity="1" Margin="0,10,0,0">
                            <Image Source="/Resources/Photos/NumidixLogoSQR.png"
                                   Width="50" Height="50" Margin="3"
                                   Stretch="Uniform"/>
                            <TextBlock Text="Numidix Lab"
                                       FontSize="20"
                                       FontFamily="{StaticResource BodyFont}"
                                       Foreground="{StaticResource BgBrush}"
                                       VerticalAlignment="Center" Margin="5,0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══════════ RIGHT PANEL ═══════════ -->
            <Grid Grid.Column="1" Margin="40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Close button -->
                <Button Grid.Row="0"
                        HorizontalAlignment="Right"
                        Command="{Binding CloseApplicationCommand}"
                        Style="{StaticResource IconButton}"
                        Foreground="{StaticResource TextSecondaryBrush}">
                    <materialDesign:PackIcon Kind="Close" Width="22" Height="22"/>
                </Button>

                <!-- Login form -->
                <StackPanel Grid.Row="1" Margin="20,19,20,21">

                    <TextBlock Text="Bienvenue / مرحباً"
               FontFamily="{StaticResource HeadingFont}"
               FontSize="34" FontWeight="Bold"
               HorizontalAlignment="Center"
               Foreground="{StaticResource PrimaryBrush}"
               Margin="0,0,0,8"/>

                    <TextBlock Text="Veuillez vous connecter pour continuer"
               FontSize="16"
               HorizontalAlignment="Center"
               Foreground="{StaticResource TextSecondaryBrush}"
               Margin="0,0,0,40"/>

                    <!-- Username -->
                    <TextBox x:Name="TxtUsername"
             Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
             Style="{StaticResource ShiakatiTextBox}"
             materialDesign:HintAssist.Hint="Nom d'utilisateur / اسم المستخدم"
             Margin="0,0,0,18"/>

                    <!-- Password – fully masked, clean floating hint -->
                    
                    <PasswordBox x:Name="TxtPassword"
             Style="{StaticResource MaterialDesignRevealPasswordBox}"
             materialDesign:HintAssist.Hint="  Mot de passe / كلمة المرور"
             FontSize="16"
             Height="50"
             Margin="0,0,0,30"/>

                    <!-- Error message – auto‑sized, wraps if needed -->
                    <TextBlock x:Name="TxtErrorMessage"
               Text="{Binding ErrorMessage}"
               Foreground="{StaticResource DangerBrush}"
               FontSize="14"
               TextWrapping="Wrap"
               Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"
               Margin="4,6,0,30"/>

                    <!-- Login button -->
                    <Button x:Name="BtnLogin"
            Command="{Binding LoginCommand}"
            CommandParameter="{Binding ElementName=TxtPassword}"
            IsEnabled="{Binding IsLoading, Converter={StaticResource InvertBooleanConverter}}"
            FontSize="20"
            Background="#13314B"
            Height="60"
            Margin="0,4,0,0">
                        <Button.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding LoginCommand}"
                        CommandParameter="{Binding ElementName=TxtPassword}"/>
                        </Button.InputBindings>

                        <TextBlock Text="SE CONNECTER" 
                   Foreground="White" 
                   FontSize="20" 
                   FontFamily="{StaticResource HeadingFont}"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center"/>
                    </Button>

                </StackPanel>
                <!-- Footer -->
                <TextBlock Grid.Row="2"
                           Text="Shiakati POS v1.0 © 2026"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,0"/>
            </Grid>
        </Grid>
    </Border>
</Window>