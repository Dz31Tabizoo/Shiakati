<Application x:Class="Shiakati.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Shiakati.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:Shiakati.Converters"
             xmlns:viewModels="clr-namespace:Shiakati.ViewModels">
    
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light" 
                                             PrimaryColor="BlueGrey" 
                                             SecondaryColor="DeepOrange" />

                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />

                <ResourceDictionary Source="Resources/Themes/LightTheme.xaml"/>
                <ResourceDictionary Source="Resources/Langs/fr-FR.xaml"/>
                <ResourceDictionary Source="Resources/Styles/GlobalStyles.xaml"/>
                
                <ResourceDictionary>
                    
                    
                    <DataTemplate DataType="{x:Type viewModels:SettingsViewModel}">
                        <views:SettingsView />
                    </DataTemplate>
                    
                    <DataTemplate DataType="{x:Type viewModels:PosContainerViewModel}">
                        <views:POSContainerView />
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type viewModels:SalesHistoryViewModel}">
                        <views:SalesHistoryView />
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type viewModels:StockViewModel}">
                        <views:StockView />
                        
                        
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type viewModels:POSViewModel}">
                        <views:PosView />
                    </DataTemplate>
                    
                    <DataTemplate DataType="{x:Type viewModels:StockMovementsViewModel}">
                        <views:StockMovementsView />
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type viewModels:ClientListViewModel}">
                        <views:ClientListView />
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type viewModels:ClientDetailViewModel}">
                        <views:ClientDetailView />
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type viewModels:ReservationsViewModel}">
                        <views:ReservationsView />
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type viewModels:DashBordViewModel}">
                        <views:DashBordView />
                    </DataTemplate>

                </ResourceDictionary>
                
                <ResourceDictionary>
                    <converters:InvertBooleanConverter x:Key="InvertBooleanConverter"/>
                    <converters:CommonEqualityConverter x:Key="CommonEqualityConverter"/>
                    <!-- Converter: > 0 returns true -->
                    <converters:GreaterThanZeroConverter x:Key="GreaterThanZeroConverter"/>

                    <!-- Converter: int to Visibility -->
                    <converters:IntToVisibilityConverter x:Key="IntToVisibility"/>


                </ResourceDictionary>

            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
